{% extends '@admin/base.twig' %}
{% set page_heading = 'Shop settings' %}
{% import '@admin/partials/ui.twig' as ui %}
{#
  System > Shop settings (docs/shop-plan.md, section 8). Only while the shop is on (the Products content type): General, Shipping
  (zones with their methods; admin-shop.js adds zones and methods), Payments and Accounts.
#}

{% block content %}
  {% set btn = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium shadow-sm' %}
  {% set primary = btn ~ ' bg-blue-600 text-white hover:bg-blue-700' %}
  {% set input = 'block w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {% set card_head = 'flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3' %}
  {% set label = 'block text-xs font-medium text-slate-600 mb-1' %}
  {% set note = 'mt-1 text-xs text-slate-500' %}

  {{ ui.flash(message, done == 'ok' ? 'success' : 'error') }}

  <header class="mb-4 border-b border-slate-200 pb-4">
    <p class="max-w-3xl text-xs text-slate-500">The shop is on because the <strong>Products</strong> content type is on. Products, Looks, Collections and Product categories are edited like any content; this screen holds what the shop needs besides them. Orders, customers and coupons are in the <strong>Shop</strong> group of the menu.</p>
    <div class="-mb-4 mt-3">
      <nav class="flex min-w-0 gap-1 overflow-x-auto" aria-label="Shop settings">
        {% for key, name in tabs %}
          <a href="{{ url('admin/shop-settings?tab=' ~ key) }}" class="shrink-0 border-b-2 px-3 py-2 text-sm font-medium {{ tab == key ? 'border-blue-600 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' }}"{% if tab == key %} aria-current="page"{% endif %}>{{ name }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  {% if tab == 'general' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=general') }}" class="grid gap-4" data-shop-general>
      {{ csrf_field() }}<input type="hidden" name="tab" value="general">

      <section class="{{ card }}" aria-labelledby="shop-store">
        <div class="{{ card_head }}"><h2 id="shop-store" class="text-sm font-semibold text-slate-900">Store</h2><span class="text-xs text-slate-400">On receipts, emails and the packing slip</span></div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="shop-name">Store name</label><input id="shop-name" name="store_name" value="{{ shop.store_name }}" class="{{ input }}" maxlength="200" placeholder="{{ site.title|default('') }}"></div>
          <div><label class="{{ label }}" for="shop-vat">VAT number (ΑΦΜ)</label><input id="shop-vat" name="vat_number" value="{{ shop.vat_number }}" class="{{ input }}" maxlength="30" autocomplete="off"></div>
          <div><label class="{{ label }}" for="shop-email">Email for orders</label><input id="shop-email" type="email" name="store_email" value="{{ shop.store_email }}" class="{{ input }}" maxlength="190"><p class="{{ note }}">New orders are sent here, and customers' replies come back to it.</p></div>
          <div><label class="{{ label }}" for="shop-phone">Phone</label><input id="shop-phone" type="tel" name="store_phone" value="{{ shop.store_phone }}" class="{{ input }}" maxlength="40"></div>
          <div class="sm:col-span-2"><label class="{{ label }}" for="shop-address">Address</label><textarea id="shop-address" name="store_address" rows="3" class="{{ input }}" maxlength="500">{{ shop.store_address }}</textarea></div>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="shop-money">
        <div class="{{ card_head }}"><h2 id="shop-money" class="text-sm font-semibold text-slate-900">Money and VAT</h2><span class="text-xs text-slate-400">Prices are written with VAT in them</span></div>
        <div class="grid gap-4 px-4 py-4">
          <div class="max-w-xs"><label class="{{ label }}" for="shop-currency">Currency</label>
            <select id="shop-currency" name="currency" class="{{ input }}">
              {% for code, name in currencies %}<option value="{{ code }}" {% if shop.currency == code %}selected{% endif %}>{{ name }}</option>{% endfor %}
            </select>
          </div>
          <fieldset>
            <legend class="{{ label }}">VAT rate of each class (%)</legend>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              {% for class, name in tax_labels %}
                <label class="block text-xs text-slate-600"><span class="mb-1 block">{{ name }}</span>
                  <input type="number" name="tax_rates[{{ class }}]" value="{{ shop.tax_rates[class] }}" min="0" max="100" step="0.01" inputmode="decimal" class="{{ input }}">
                </label>
              {% endfor %}
            </div>
            <p class="{{ note }}">Each product chooses its class. The Greek rates are the defaults; each order keeps the VAT it was sold with.</p>
          </fieldset>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="shop-orders">
        <div class="{{ card_head }}"><h2 id="shop-orders" class="text-sm font-semibold text-slate-900">Orders and checkout</h2></div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="shop-prefix">Order number prefix</label><input id="shop-prefix" name="order_prefix" value="{{ shop.order_prefix }}" class="{{ input }} font-mono uppercase" maxlength="12" placeholder="AL" spellcheck="false" autocomplete="off"><p class="{{ note }}">Letters, digits and dashes, e.g. AL gives AL-2026-00042. A prefix keeps new numbers apart from an old shop's.</p></div>
          <div><label class="{{ label }}" for="shop-reserve">Hold stock for unpaid orders (minutes)</label><input id="shop-reserve" type="number" name="reserve_minutes" value="{{ shop.reserve_minutes }}" min="5" max="240" class="{{ input }}"><p class="{{ note }}">While a customer pays, their pieces are kept for them; after this they are free again.</p></div>
          <label class="flex items-start gap-2 text-sm text-slate-700 sm:col-span-2"><input type="checkbox" name="guest_checkout" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if shop.guest_checkout %}checked{% endif %}><span>Customers can order without an account<span class="block text-xs text-slate-500">Subscriptions always need one.</span></span></label>
          {% for key, name in {terms_page: 'Terms of sale', returns_page: 'Shipping and returns'} %}
            <div><label class="{{ label }}" for="shop-{{ key }}">{{ name }} page</label>
              <select id="shop-{{ key }}" name="{{ key }}" class="{{ input }}">
                <option value="">—</option>
                {% for slug, page_title in pages %}<option value="{{ slug }}" {% if shop[key] == slug %}selected{% endif %}>{{ page_title }}</option>{% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>
      </section>

      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}
  {% if tab == 'shipping' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=shipping') }}" class="grid gap-4" data-shop-shipping>
      {{ csrf_field() }}<input type="hidden" name="tab" value="shipping">
      <p class="max-w-3xl text-xs text-slate-500">An address takes the <strong>first</strong> zone that matches it, so put narrower zones (the islands, by the start of their postcodes) above wider ones. <code>*</code> as a country is everywhere else. Amounts are in euros with VAT.</p>
      <div class="grid gap-4" data-zones>
        {% for zone in shop.shipping %}
          {% include '@admin/partials/shop-zone.twig' with {z: loop.index0, zone: zone, tables: table_text[loop.index0]|default([])} %}
        {% endfor %}
      </div>
      <template data-zone-template>{% include '@admin/partials/shop-zone.twig' with {z: '__Z__', zone: {id: '', name: '', countries: [], postcodes: [], methods: [{id: '', kind: 'flat', label: {}, cost: 0, free_over: null, table: [], stores: []}]}, tables: []} %}</template>
      <template data-method-template>{% include '@admin/partials/shop-method.twig' with {z: '__Z__', m: '__M__', method: {id: '', kind: 'flat', label: {}, cost: 0, free_over: null, table: [], stores: []}, table: ''} %}</template>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50" data-add-zone>Add a zone</button>
        <button type="submit" class="{{ primary }}">Save</button>
      </div>
    </form>
    <script src="{{ asset('js/admin-shop.js') }}" defer></script>
  {% endif %}

  {% if tab == 'payments' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=payments') }}" class="grid gap-4">
      {{ csrf_field() }}<input type="hidden" name="tab" value="payments">
      {% set viva = shop.payments.viva %}
      <section class="{{ card }}" aria-labelledby="pay-viva">
        <div class="{{ card_head }}"><h2 id="pay-viva" class="text-sm font-semibold text-slate-900">Viva Wallet <span class="font-normal text-slate-400">· cards, Apple Pay, Google Pay, IRIS, installments</span></h2>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="viva[demo]" value="1" class="h-4 w-4 rounded border-slate-300" {% if viva.demo %}checked{% endif %}> Demo</label>
            <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="viva[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if viva.enabled %}checked{% endif %}> Offered</label>
          </div>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="viva-merchant">Merchant ID</label><input id="viva-merchant" name="viva[merchant_id]" value="{{ viva.merchant_id }}" class="{{ input }} font-mono" autocomplete="off" spellcheck="false"></div>
          <div><label class="{{ label }}" for="viva-key">API key</label><input id="viva-key" type="password" name="viva_secret[api_key]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ viva_secrets.api_key.set|default(false) ? 'Set, ends in ' ~ viva_secrets.api_key.last4 ~ ' · blank keeps it' : '' }}"></div>
          <div><label class="{{ label }}" for="viva-client">Smart Checkout Client ID</label><input id="viva-client" name="viva[client_id]" value="{{ viva.client_id }}" class="{{ input }} font-mono" autocomplete="off" spellcheck="false"></div>
          <div><label class="{{ label }}" for="viva-secret">Smart Checkout Client secret</label><input id="viva-secret" type="password" name="viva_secret[client_secret]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ viva_secrets.client_secret.set|default(false) ? 'Set, ends in ' ~ viva_secrets.client_secret.last4 ~ ' · blank keeps it' : '' }}"></div>
          <div><label class="{{ label }}" for="viva-source">Payment source code</label><input id="viva-source" name="viva[source_code]" value="{{ viva.source_code }}" class="{{ input }} font-mono" maxlength="20" placeholder="Default"><p class="{{ note }}">The 4-digit code of the source made for this site in Viva (Sales › Online payments › Websites/Apps).</p></div>
          <div><label class="{{ label }}" for="viva-inst">Installments: from amount (€) = up to</label><textarea id="viva-inst" name="viva[installments]" rows="3" class="{{ input }} font-mono" placeholder="100 = 3&#10;300 = 6&#10;600 = 12">{{ viva_installments }}</textarea><p class="{{ note }}">Empty: no installments. Your contract with Viva sets the most allowed.</p></div>
          <div class="sm:col-span-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <p class="mb-1 font-medium text-slate-800">In the payment source at Viva, set:</p>
            <p>Success URL <code class="select-all">{{ viva_urls.success }}</code></p>
            <p>Failure URL <code class="select-all">{{ viva_urls.failure }}</code></p>
            <p class="mt-1">And under Settings › API Access › Webhooks, add <code class="select-all">{{ viva_urls.webhook }}</code> for <em>Transaction Payment Created</em> and <em>Transaction Failed</em>.</p>
          </div>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" name="viva_action" value="check" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Save and check connection</button>
            {% if viva_secrets.api_key.set|default(false) or viva_secrets.client_secret.set|default(false) %}<label class="flex items-center gap-2 text-xs text-slate-500"><input type="checkbox" name="viva_clear" value="1" class="h-4 w-4 rounded border-slate-300"> Remove the stored keys</label>{% endif %}
          </div>
        </div>
      </section>
      <section class="{{ card }}" aria-labelledby="pay-bank">
        <div class="{{ card_head }}"><h2 id="pay-bank" class="text-sm font-semibold text-slate-900">Bank transfer</h2>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="bank_transfer[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if shop.payments.bank_transfer.enabled %}checked{% endif %}> Offered</label>
        </div>
        <div class="grid gap-3 px-4 py-4">
          <div><label class="{{ label }}" for="pay-accounts">The shop's accounts, one per line</label>
            <textarea id="pay-accounts" name="bank_transfer[accounts]" rows="4" class="{{ input }} font-mono" maxlength="2000" placeholder="Eurobank · GR16 0260 … · Company name">{{ shop.payments.bank_transfer.accounts }}</textarea>
            <p class="{{ note }}">Shown on the order's page and in its email, with the order number as the reference. The order waits, on hold with its stock kept, until you mark it paid.</p>
          </div>
        </div>
      </section>
      <section class="{{ card }}" aria-labelledby="pay-cod">
        <div class="{{ card_head }}"><h2 id="pay-cod" class="text-sm font-semibold text-slate-900">Cash on delivery</h2>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="cod[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if shop.payments.cod.enabled %}checked{% endif %}> Offered</label>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="pay-cod-fee">Fee (€, with VAT)</label><input id="pay-cod-fee" type="number" name="cod[fee]" value="{{ (shop.payments.cod.fee / 100)|number_format(2, '.', '') }}" min="0" max="100" step="0.01" class="{{ input }}"></div>
          <fieldset><legend class="{{ label }}">Only in these zones</legend>
            {% for zone in shop.shipping %}
              <label class="mr-3 inline-flex items-center gap-1.5 text-sm text-slate-700"><input type="checkbox" name="cod[zones][]" value="{{ zone.id }}" class="h-4 w-4 rounded border-slate-300" {% if zone.id in shop.payments.cod.zones %}checked{% endif %}> {{ zone.name }}</label>
            {% else %}
              <p class="{{ note }}">Add shipping zones first.</p>
            {% endfor %}
            <p class="{{ note }}">None ticked: everywhere.</p>
          </fieldset>
        </div>
      </section>
      <p class="max-w-3xl text-xs text-slate-500">The keys are kept apart from these settings, never shown again and never exported. Cardlink (Eurobank, Alpha, Cardlink) comes next.</p>
      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}

  {% if tab == 'accounts' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=accounts') }}" class="grid gap-4">
      {{ csrf_field() }}<input type="hidden" name="tab" value="accounts">
      <section class="{{ card }}" aria-labelledby="shop-accounts">
        <div class="{{ card_head }}"><h2 id="shop-accounts" class="text-sm font-semibold text-slate-900">Customers' accounts</h2><span class="text-xs text-slate-400">At /account, apart from the admin's users</span></div>
        <div class="grid gap-3 px-4 py-4">
          <label class="flex items-start gap-2 text-sm text-slate-700"><input type="checkbox" name="signup" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if shop.accounts.signup %}checked{% endif %}><span>Customers can create an account<span class="block text-xs text-slate-500">They see their orders, keep their address and order faster.</span></span></label>
          <label class="flex items-start gap-2 text-sm text-slate-700"><input type="checkbox" name="verify" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if shop.accounts.verify %}checked{% endif %}><span>Confirm the email address before the first sign-in<span class="block text-xs text-slate-500">Off: they sign in at once; the link still confirms the address, and only then do earlier guest orders with it join the account.</span></span></label>
        </div>
      </section>
      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}
{% endblock %}
