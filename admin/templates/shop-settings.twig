{% extends '@admin/base.twig' %}
{% set page_heading = 'Shop settings' %}
{% import '@admin/partials/ui.twig' as ui %}
{#
  System > Shop settings (docs/shop-plan.md, section 8). Only while the shop is on (the Products content type): General, Shipping
  (zones with their methods; admin-shop.js adds zones and methods), Payments, Emails, Accounts, Marketing (the product feed
  for Meta and Google, the Meta Pixel) and Import & export (partials/shop-import.twig).
#}

{% block content %}
  {% set btn = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium shadow-sm' %}
  {% set primary = btn ~ ' bg-blue-600 text-white hover:bg-blue-700' %}
  {% set input = 'block w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {% set card_head = 'flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3' %}
  {% set label = 'block text-xs font-medium text-slate-600 mb-1' %}
  {% set note = 'mt-1 text-xs text-slate-500' %}

  {{ ui.flash(message, done == 'ok' ? 'success' : 'error') }}

  <header class="mb-4 border-b border-slate-200 pb-4">
    <p class="max-w-3xl text-xs text-slate-500">The shop is on because the <strong>Products</strong> content type is on. Products, Looks, Collections and Product categories are edited like any content; this screen holds what the shop needs besides them. Orders, customers and coupons are in the <strong>Shop</strong> group of the menu.</p>
    <div class="-mb-4 mt-3">
      <nav class="flex min-w-0 gap-1 overflow-x-auto" aria-label="Shop settings">
        {% for key, name in tabs %}
          <a href="{{ url('admin/shop-settings?tab=' ~ key) }}" class="shrink-0 border-b-2 px-3 py-2 text-sm font-medium {{ tab == key ? 'border-blue-600 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' }}"{% if tab == key %} aria-current="page"{% endif %}>{{ name }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  {% if tab == 'general' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=general') }}" class="grid gap-4" data-shop-general>
      {{ csrf_field() }}<input type="hidden" name="tab" value="general">

      <section class="{{ card }}" aria-labelledby="shop-store">
        <div class="{{ card_head }}"><h2 id="shop-store" class="text-sm font-semibold text-slate-900">Store</h2><span class="text-xs text-slate-400">On receipts, emails and the packing slip</span></div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="shop-name">Store name</label><input id="shop-name" name="store_name" value="{{ shop.store_name }}" class="{{ input }}" maxlength="200" placeholder="{{ site.title|default('') }}"></div>
          <div><label class="{{ label }}" for="shop-vat">VAT number (ΑΦΜ)</label><input id="shop-vat" name="vat_number" value="{{ shop.vat_number }}" class="{{ input }}" maxlength="30" autocomplete="off"></div>
          <div><label class="{{ label }}" for="shop-email">Email for orders</label><input id="shop-email" type="email" name="store_email" value="{{ shop.store_email }}" class="{{ input }}" maxlength="190"><p class="{{ note }}">New orders are sent here, and customers' replies come back to it.</p></div>
          <div><label class="{{ label }}" for="shop-phone">Phone</label><input id="shop-phone" type="tel" name="store_phone" value="{{ shop.store_phone }}" class="{{ input }}" maxlength="40"></div>
          <div class="sm:col-span-2"><label class="{{ label }}" for="shop-address">Address</label><textarea id="shop-address" name="store_address" rows="3" class="{{ input }}" maxlength="500">{{ shop.store_address }}</textarea></div>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="shop-money">
        <div class="{{ card_head }}"><h2 id="shop-money" class="text-sm font-semibold text-slate-900">Money and VAT</h2><span class="text-xs text-slate-400">Prices are written with VAT in them</span></div>
        <div class="grid gap-4 px-4 py-4">
          <div class="max-w-xs"><label class="{{ label }}" for="shop-currency">Currency</label>
            <select id="shop-currency" name="currency" class="{{ input }}">
              {% for code, name in currencies %}<option value="{{ code }}" {% if shop.currency == code %}selected{% endif %}>{{ name }}</option>{% endfor %}
            </select>
          </div>
          <fieldset>
            <legend class="{{ label }}">VAT rate of each class (%)</legend>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              {% for class, name in tax_labels %}
                <label class="block text-xs text-slate-600"><span class="mb-1 block">{{ name }}</span>
                  <input type="number" name="tax_rates[{{ class }}]" value="{{ shop.tax_rates[class] }}" min="0" max="100" step="0.01" inputmode="decimal" class="{{ input }}">
                </label>
              {% endfor %}
            </div>
            <p class="{{ note }}">Each product chooses its class. The Greek rates are the defaults; each order keeps the VAT it was sold with.</p>
          </fieldset>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="shop-orders">
        <div class="{{ card_head }}"><h2 id="shop-orders" class="text-sm font-semibold text-slate-900">Orders and checkout</h2></div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="shop-prefix">Order number prefix</label><input id="shop-prefix" name="order_prefix" value="{{ shop.order_prefix }}" class="{{ input }} font-mono uppercase" maxlength="12" placeholder="AL" spellcheck="false" autocomplete="off"><p class="{{ note }}">Letters, digits and dashes, e.g. AL gives AL-2026-00042. A prefix keeps new numbers apart from an old shop's.</p></div>
          <div><label class="{{ label }}" for="shop-reserve">Hold stock for unpaid orders (minutes)</label><input id="shop-reserve" type="number" name="reserve_minutes" value="{{ shop.reserve_minutes }}" min="5" max="240" class="{{ input }}"><p class="{{ note }}">While a customer pays, their pieces are kept for them; after this they are free again.</p></div>
          <label class="flex items-start gap-2 text-sm text-slate-700 sm:col-span-2"><input type="checkbox" name="guest_checkout" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if shop.guest_checkout %}checked{% endif %}><span>Customers can order without an account<span class="block text-xs text-slate-500">Subscriptions always need one.</span></span></label>
          {% for key, name in {terms_page: 'Terms of sale', returns_page: 'Shipping and returns'} %}
            <div><label class="{{ label }}" for="shop-{{ key }}">{{ name }} page</label>
              <select id="shop-{{ key }}" name="{{ key }}" class="{{ input }}">
                <option value="">—</option>
                {% for slug, page_title in pages %}<option value="{{ slug }}" {% if shop[key] == slug %}selected{% endif %}>{{ page_title }}</option>{% endfor %}
              </select>
            </div>
          {% endfor %}
        </div>
      </section>

      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}
  {% if tab == 'shipping' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=shipping') }}" class="grid gap-4" data-shop-shipping>
      {{ csrf_field() }}<input type="hidden" name="tab" value="shipping">
      <p class="max-w-3xl text-xs text-slate-500">An address takes the <strong>first</strong> zone that matches it, so put narrower zones (the islands, by the start of their postcodes) above wider ones. <code>*</code> as a country is everywhere else. Amounts are in euros with VAT.</p>
      <div class="grid gap-4" data-zones>
        {% for zone in shop.shipping %}
          {% include '@admin/partials/shop-zone.twig' with {z: loop.index0, zone: zone, tables: table_text[loop.index0]|default([])} %}
        {% endfor %}
      </div>
      <template data-zone-template>{% include '@admin/partials/shop-zone.twig' with {z: '__Z__', zone: {id: '', name: '', countries: [], postcodes: [], methods: [{id: '', kind: 'flat', label: {}, cost: 0, free_over: null, table: [], stores: []}]}, tables: []} %}</template>
      <template data-method-template>{% include '@admin/partials/shop-method.twig' with {z: '__Z__', m: '__M__', method: {id: '', kind: 'flat', label: {}, cost: 0, free_over: null, table: [], stores: []}, table: ''} %}</template>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50" data-add-zone>Add a zone</button>
        <button type="submit" class="{{ primary }}">Save</button>
      </div>
    </form>
    <script src="{{ asset('js/admin-shop.js') }}" defer></script>
  {% endif %}

  {% if tab == 'payments' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=payments') }}" class="grid gap-4">
      {{ csrf_field() }}<input type="hidden" name="tab" value="payments">
      {% set viva = shop.payments.viva %}
      <section class="{{ card }}" aria-labelledby="pay-viva">
        <div class="{{ card_head }}"><h2 id="pay-viva" class="text-sm font-semibold text-slate-900">Viva Wallet <span class="font-normal text-slate-400">· cards, Apple Pay, Google Pay, IRIS, installments</span></h2>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="viva[demo]" value="1" class="h-4 w-4 rounded border-slate-300" {% if viva.demo %}checked{% endif %}> Demo</label>
            <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="viva[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if viva.enabled %}checked{% endif %}> Offered</label>
          </div>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="viva-merchant">Merchant ID</label><input id="viva-merchant" name="viva[merchant_id]" value="{{ viva.merchant_id }}" class="{{ input }} font-mono" autocomplete="off" spellcheck="false"></div>
          <div><label class="{{ label }}" for="viva-key">API key</label><input id="viva-key" type="password" name="viva_secret[api_key]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ viva_secrets.api_key.set|default(false) ? 'Set, ends in ' ~ viva_secrets.api_key.last4 ~ ' · blank keeps it' : '' }}"></div>
          <div><label class="{{ label }}" for="viva-client">Smart Checkout Client ID</label><input id="viva-client" name="viva[client_id]" value="{{ viva.client_id }}" class="{{ input }} font-mono" autocomplete="off" spellcheck="false"></div>
          <div><label class="{{ label }}" for="viva-secret">Smart Checkout Client secret</label><input id="viva-secret" type="password" name="viva_secret[client_secret]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ viva_secrets.client_secret.set|default(false) ? 'Set, ends in ' ~ viva_secrets.client_secret.last4 ~ ' · blank keeps it' : '' }}"></div>
          <div><label class="{{ label }}" for="viva-source">Payment source code</label><input id="viva-source" name="viva[source_code]" value="{{ viva.source_code }}" class="{{ input }} font-mono" maxlength="20" placeholder="Default"><p class="{{ note }}">The 4-digit code of the source made for this site in Viva (Sales › Online payments › Websites/Apps).</p></div>
          <div><label class="{{ label }}" for="viva-inst">Installments: from amount (€) = up to</label><textarea id="viva-inst" name="viva[installments]" rows="3" class="{{ input }} font-mono" placeholder="100 = 3&#10;300 = 6&#10;600 = 12">{{ viva_installments }}</textarea><p class="{{ note }}">Empty: no installments. Your contract with Viva sets the most allowed.</p></div>
          <div class="sm:col-span-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <p class="mb-1 font-medium text-slate-800">In the payment source at Viva, set:</p>
            <p>Success URL <code class="select-all">{{ viva_urls.success }}</code></p>
            <p>Failure URL <code class="select-all">{{ viva_urls.failure }}</code></p>
            <p class="mt-1">And under Settings › API Access › Webhooks, add <code class="select-all">{{ viva_urls.webhook }}</code> for <em>Transaction Payment Created</em> and <em>Transaction Failed</em>.</p>
          </div>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" name="viva_action" value="check" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Save and check connection</button>
            {% if viva_secrets.api_key.set|default(false) or viva_secrets.client_secret.set|default(false) %}<label class="flex items-center gap-2 text-xs text-slate-500"><input type="checkbox" name="viva_clear" value="1" class="h-4 w-4 rounded border-slate-300"> Remove the stored keys</label>{% endif %}
          </div>
        </div>
      </section>
      {% set cl = shop.payments.cardlink %}
      <section class="{{ card }}" aria-labelledby="pay-cardlink">
        <div class="{{ card_head }}"><h2 id="pay-cardlink" class="text-sm font-semibold text-slate-900">Cardlink <span class="font-normal text-slate-400">· Eurobank (Worldline), Alpha (Nexi), Cardlink · cards, installments</span></h2>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="cardlink[test]" value="1" class="h-4 w-4 rounded border-slate-300" {% if cl.test %}checked{% endif %}> Test</label>
            <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="cardlink[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if cl.enabled %}checked{% endif %}> Offered</label>
          </div>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="cl-acquirer">Acquirer</label><select id="cl-acquirer" name="cardlink[acquirer]" class="{{ input }}">{% for id, name in cardlink_acquirers %}<option value="{{ id }}"{% if cl.acquirer == id %} selected{% endif %}>{{ name }}</option>{% endfor %}</select><p class="{{ note }}">The bank whose contract the shop has: it sets the payment page's address.</p></div>
          <div><label class="{{ label }}" for="cl-merchant">Merchant ID</label><input id="cl-merchant" name="cardlink[merchant_id]" value="{{ cl.merchant_id }}" class="{{ input }} font-mono" inputmode="numeric" autocomplete="off" spellcheck="false"></div>
          <div><label class="{{ label }}" for="cl-secret">Shared secret</label><input id="cl-secret" type="password" name="cardlink_secret[shared_secret]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ cardlink_secrets.shared_secret.set|default(false) ? 'Set, ends in ' ~ cardlink_secrets.shared_secret.last4 ~ ' · blank keeps it' : '' }}"><p class="{{ note }}">The same ones a WooCommerce shop's Cardlink plugin uses.</p></div>
          <div><label class="{{ label }}" for="cl-inst">Installments: from amount (€) = up to</label><textarea id="cl-inst" name="cardlink[installments]" rows="3" class="{{ input }} font-mono" placeholder="100 = 3&#10;300 = 6&#10;600 = 12">{{ cardlink_installments }}</textarea><p class="{{ note }}">Empty: no installments. The customer picks how many before going to the bank.</p></div>
          <div class="sm:col-span-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <p class="mb-1 font-medium text-slate-800">The bank sends the customer back to these addresses (nothing to set at Cardlink):</p>
            <p>Confirm <code class="select-all">{{ cardlink_urls.confirm }}</code></p>
            <p>Cancel <code class="select-all">{{ cardlink_urls.cancel }}</code></p>
            <p class="mt-1">A payment whose answer never comes back (the browser closed) is asked about before its order is let go.</p>
          </div>
          <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
            <button type="submit" name="cardlink_action" value="check" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Save and check connection</button>
            {% if cardlink_secrets.shared_secret.set|default(false) %}<label class="flex items-center gap-2 text-xs text-slate-500"><input type="checkbox" name="cardlink_clear" value="1" class="h-4 w-4 rounded border-slate-300"> Remove the stored secret</label>{% endif %}
          </div>
        </div>
      </section>
      <section class="{{ card }}" aria-labelledby="pay-bank">
        <div class="{{ card_head }}"><h2 id="pay-bank" class="text-sm font-semibold text-slate-900">Bank transfer</h2>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="bank_transfer[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if shop.payments.bank_transfer.enabled %}checked{% endif %}> Offered</label>
        </div>
        <div class="grid gap-3 px-4 py-4">
          <div><label class="{{ label }}" for="pay-accounts">The shop's accounts, one per line</label>
            <textarea id="pay-accounts" name="bank_transfer[accounts]" rows="4" class="{{ input }} font-mono" maxlength="2000" placeholder="Eurobank · GR16 0260 … · Company name">{{ shop.payments.bank_transfer.accounts }}</textarea>
            <p class="{{ note }}">Shown on the order's page and in its email, with the order number as the reference. The order waits, on hold with its stock kept, until you mark it paid.</p>
          </div>
        </div>
      </section>
      <section class="{{ card }}" aria-labelledby="pay-cod">
        <div class="{{ card_head }}"><h2 id="pay-cod" class="text-sm font-semibold text-slate-900">Cash on delivery</h2>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="cod[enabled]" value="1" class="h-4 w-4 rounded border-slate-300" {% if shop.payments.cod.enabled %}checked{% endif %}> Offered</label>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="pay-cod-fee">Fee (€, with VAT)</label><input id="pay-cod-fee" type="number" name="cod[fee]" value="{{ (shop.payments.cod.fee / 100)|number_format(2, '.', '') }}" min="0" max="100" step="0.01" class="{{ input }}"></div>
          <fieldset><legend class="{{ label }}">Only in these zones</legend>
            {% for zone in shop.shipping %}
              <label class="mr-3 inline-flex items-center gap-1.5 text-sm text-slate-700"><input type="checkbox" name="cod[zones][]" value="{{ zone.id }}" class="h-4 w-4 rounded border-slate-300" {% if zone.id in shop.payments.cod.zones %}checked{% endif %}> {{ zone.name }}</label>
            {% else %}
              <p class="{{ note }}">Add shipping zones first.</p>
            {% endfor %}
            <p class="{{ note }}">None ticked: everywhere.</p>
          </fieldset>
        </div>
      </section>
      <p class="max-w-3xl text-xs text-slate-500">The keys are kept apart from these settings, never shown again and never exported.</p>
      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}

  {% if tab == 'emails' %}
    {% set em = shop.emails %}
    <form method="post" action="{{ url('admin/shop-settings?tab=emails') }}" class="grid gap-4">
      {{ csrf_field() }}<input type="hidden" name="tab" value="emails">
      <section class="{{ card }}" aria-labelledby="em-look">
        <div class="{{ card_head }}"><h2 id="em-look" class="text-sm font-semibold text-slate-900">How they look</h2>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="emails[html]" value="1" class="h-4 w-4 rounded border-slate-300" {% if em.html %}checked{% endif %}> Send as HTML</label>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-3">
          <div><label class="{{ label }}" for="em-accent">Colour (buttons, the top line)</label><input id="em-accent" type="color" name="emails[accent]" value="{{ em.accent }}" class="h-9 w-16 rounded border border-slate-300 bg-white p-0.5"></div>
          <div><label class="{{ label }}" for="em-logo">Logo address</label><input id="em-logo" name="emails[logo]" value="{{ em.logo }}" class="{{ input }}" placeholder="/uploads/media/logo.png"><p class="{{ note }}">A picture of the site (from Media) or an https address. Empty: the store's name.</p></div>
          <div><label class="{{ label }}" for="em-footer">Footer line</label><textarea id="em-footer" name="emails[footer]" rows="2" class="{{ input }}" maxlength="500" placeholder="Aleon · Ermou 1, Athens · VAT EL123456789">{{ em.footer }}</textarea><p class="{{ note }}">Under the store's name, phone and email, in every email.</p></div>
          <p class="sm:col-span-3 text-xs text-slate-500">Every email also goes as plain text, for mail programs that do not show HTML. Off: plain text only.</p>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="em-texts">
        <div class="{{ card_head }}"><h2 id="em-texts" class="text-sm font-semibold text-slate-900">What they say</h2><span class="text-xs text-slate-400">Blank: the theme's own words (shown greyed)</span></div>
        <div class="divide-y divide-slate-100">
          {% for kind, name in email_kinds %}
            <details class="group px-4 py-3"{% if em.texts[kind] is defined %} open{% endif %}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
                <span class="text-sm font-medium text-slate-800">{{ name }}{% if em.texts[kind] is defined %} <span class="ml-1 rounded bg-blue-50 px-1.5 py-0.5 text-[11px] font-medium text-blue-700">changed</span>{% endif %}</span>
                <span class="flex items-center gap-3 text-xs">
                  {% for lang in languages %}<a href="{{ url('admin/shop-settings?preview=' ~ kind ~ '&lang=' ~ lang) }}" target="_blank" rel="noopener" class="text-blue-700 hover:underline">Preview {{ lang|upper }}</a>{% endfor %}
                </span>
              </summary>
              <div class="mt-3 grid gap-3 {{ languages|length > 1 ? 'lg:grid-cols-2' : '' }}">
                {% for lang in languages %}
                  {% set own = em.texts[kind][lang] ?? {subject: '', text: ''} %}
                  <div class="grid gap-2">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-slate-400">{{ lang }}</p>
                    <input name="emails[texts][{{ kind }}][{{ lang }}][subject]" value="{{ own.subject }}" class="{{ input }}" maxlength="200" placeholder="{{ email_defaults[kind][lang].subject }}" aria-label="{{ name }}, subject ({{ lang }})">
                    <textarea name="emails[texts][{{ kind }}][{{ lang }}][text]" rows="2" class="{{ input }}" maxlength="2000" placeholder="{{ email_defaults[kind][lang].text }}" aria-label="{{ name }}, text ({{ lang }})">{{ own.text }}</textarea>
                  </div>
                {% endfor %}
              </div>
              <p class="{{ note }}">Can use {% for p in email_placeholders[kind] %}<code>{{ '{' ~ p ~ '}' }}</code>{% if not loop.last %}, {% endif %}{% endfor %}. The order, its links and the button follow on their own.</p>
            </details>
          {% endfor %}
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="em-test">
        <div class="{{ card_head }}"><h2 id="em-test" class="text-sm font-semibold text-slate-900">Send a test</h2><span class="text-xs text-slate-400">With a made-up order</span></div>
        <div class="flex flex-wrap items-end gap-3 px-4 py-4">
          <div><label class="{{ label }}" for="em-test-kind">Email</label><select id="em-test-kind" name="test_kind" class="{{ input }}">{% for kind, name in email_kinds %}<option value="{{ kind }}">{{ name }}</option>{% endfor %}</select></div>
          <div><label class="{{ label }}" for="em-test-lang">Language</label><select id="em-test-lang" name="test_lang" class="{{ input }}">{% for lang in languages %}<option value="{{ lang }}">{{ lang|upper }}</option>{% endfor %}</select></div>
          <div class="min-w-[14rem] flex-1"><label class="{{ label }}" for="em-test-to">To</label><input id="em-test-to" type="email" name="test_to" value="{{ shop.store_email }}" class="{{ input }}"></div>
          <button type="submit" name="email_action" value="test" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Save and send the test</button>
        </div>
      </section>
      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}

  {% if tab == 'accounts' %}
    <form method="post" action="{{ url('admin/shop-settings?tab=accounts') }}" class="grid gap-4">
      {{ csrf_field() }}<input type="hidden" name="tab" value="accounts">
      <section class="{{ card }}" aria-labelledby="shop-accounts">
        <div class="{{ card_head }}"><h2 id="shop-accounts" class="text-sm font-semibold text-slate-900">Customers' accounts</h2><span class="text-xs text-slate-400">At /account, apart from the admin's users</span></div>
        <div class="grid gap-3 px-4 py-4">
          <label class="flex items-start gap-2 text-sm text-slate-700"><input type="checkbox" name="signup" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if shop.accounts.signup %}checked{% endif %}><span>Customers can create an account<span class="block text-xs text-slate-500">They see their orders, keep their address and order faster.</span></span></label>
          <label class="flex items-start gap-2 text-sm text-slate-700"><input type="checkbox" name="verify" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if shop.accounts.verify %}checked{% endif %}><span>Confirm the email address before the first sign-in<span class="block text-xs text-slate-500">Off: they sign in at once; the link still confirms the address, and only then do earlier guest orders with it join the account.</span></span></label>
        </div>
      </section>
      <section class="{{ card }}" aria-labelledby="shop-google">
        <div class="{{ card_head }}"><h2 id="shop-google" class="text-sm font-semibold text-slate-900">Sign in with Google</h2>
          <label class="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" name="google" value="1" class="h-4 w-4 rounded border-slate-300" {% if shop.accounts.google %}checked{% endif %}> Offered</label>
        </div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <p class="sm:col-span-2 text-xs text-slate-500">A "Continue with Google" button on the sign-in page. A Google account whose address has an account here signs in to it; a new one makes an account when customers can create one. Google confirms the address, so earlier guest orders with it join the account.</p>
          <div><label class="{{ label }}" for="g-client">Client ID</label><input id="g-client" name="google_client_id" value="{{ shop.accounts.google_client_id }}" class="{{ input }} font-mono" autocomplete="off" spellcheck="false" placeholder="….apps.googleusercontent.com"><p class="{{ note }}">Blank: the client of the admin's Google Sign-In (Settings), with its secret.</p></div>
          <div><label class="{{ label }}" for="g-secret">Client secret</label><input id="g-secret" type="password" name="google_secret[client_secret]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ google_secrets.client_secret.set|default(false) ? 'Set, ends in ' ~ google_secrets.client_secret.last4 ~ ' · blank keeps it' : '' }}">
            {% if google_secrets.client_secret.set|default(false) %}<label class="mt-1.5 flex items-center gap-2 text-xs text-slate-500"><input type="checkbox" name="google_clear" value="1" class="h-4 w-4 rounded border-slate-300"> Remove the stored secret</label>{% endif %}</div>
          <div class="sm:col-span-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <p class="mb-1 font-medium text-slate-800">In Google Cloud › Credentials, add this to the OAuth client's authorised redirect URIs:</p>
            <p><code class="select-all">{{ google_redirect }}</code></p>
          </div>
        </div>
      </section>
      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}

  {% if tab == 'marketing' %}
    {% set m = shop.marketing %}
    <form method="post" action="{{ url('admin/shop-settings?tab=marketing') }}" class="grid gap-4">
      {{ csrf_field() }}<input type="hidden" name="tab" value="marketing">

      <section class="{{ card }}" aria-labelledby="shop-feed">
        <div class="{{ card_head }}"><h2 id="shop-feed" class="text-sm font-semibold text-slate-900">Product feed</h2><span class="text-xs text-slate-400">Meta Commerce Manager · Instagram Shopping · Google Merchant Center</span></div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <label class="flex items-start gap-2 text-sm text-slate-700 sm:col-span-2"><input type="checkbox" name="marketing[feed]" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if m.feed %}checked{% endif %}><span>Publish the product feed<span class="block text-xs text-slate-500">The physical products with their prices, pictures, stock and variants, at the addresses below. Digital products and subscriptions are left out: Meta and Google do not take them.</span></span></label>
          {% if m.feed %}
            <div class="sm:col-span-2 grid gap-1.5">
              {% for f in feed_urls %}
                <div class="flex items-center gap-2 text-xs"><span class="w-8 shrink-0 font-semibold uppercase text-slate-500">{{ f.lang }}</span><a class="truncate font-mono text-blue-700 hover:underline" href="{{ f.url }}" target="_blank" rel="noopener">{{ f.url }}</a></div>
              {% endfor %}
            </div>
          {% endif %}
          <div><label class="{{ label }}" for="mk-brand">Brand</label><input id="mk-brand" name="marketing[brand]" value="{{ m.brand }}" class="{{ input }}" maxlength="70" placeholder="{{ shop.store_name ?: 'The store name' }}"><p class="{{ note }}">For products with no brand of their own.</p></div>
          <div><label class="{{ label }}" for="mk-cat">Google product category</label><input id="mk-cat" name="marketing[category]" value="{{ m.category }}" class="{{ input }}" maxlength="250" placeholder="188"><p class="{{ note }}">The number or the path of Google's list, e.g. <span class="font-mono">188</span> for Jewelry. Optional.</p></div>
          <label class="flex items-start gap-2 text-sm text-slate-700 sm:col-span-2"><input type="checkbox" name="marketing[out_of_stock]" value="1" class="mt-0.5 h-4 w-4 rounded border-slate-300" {% if m.out_of_stock %}checked{% endif %}><span>List products that are out of stock<span class="block text-xs text-slate-500">They show as out of stock in the shop on Instagram. Off: they leave the feed until they are back.</span></span></label>
          <div class="sm:col-span-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <p class="mb-1 font-medium text-slate-800">In Meta Commerce Manager:</p>
            <ol class="ml-4 list-decimal space-y-0.5">
              <li>Verify the domain in Business settings › Brand safety › Domains (its code goes in SEO › Ownership).</li>
              <li>Catalog › Data sources › Data feed › <strong>Scheduled feed</strong>: paste the address above and choose every hour or every day. Add the other languages as their own feeds.</li>
              <li>Set up a Shop with checkout on your website, connect the Instagram business account, and submit it for review.</li>
            </ol>
          </div>
        </div>
      </section>

      <section class="{{ card }}" aria-labelledby="shop-pixel">
        <div class="{{ card_head }}"><h2 id="shop-pixel" class="text-sm font-semibold text-slate-900">Meta Pixel and Conversions API</h2><span class="text-xs text-slate-400">Views, adds to cart, checkouts and purchases</span></div>
        <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
          <div><label class="{{ label }}" for="mk-pixel">Pixel ID</label><input id="mk-pixel" name="marketing[pixel_id]" value="{{ m.pixel_id }}" class="{{ input }} font-mono" inputmode="numeric" maxlength="20" autocomplete="off" placeholder="123456789012345"><p class="{{ note }}">Events Manager › Data sources › your Pixel. Empty: no Pixel on the site.</p></div>
          <div><label class="{{ label }}" for="mk-token">Conversions API access token</label><input id="mk-token" type="password" name="meta_secret[capi_token]" value="" class="{{ input }} font-mono" autocomplete="new-password" placeholder="{{ meta_secrets.capi_token.set|default(false) ? 'Set, ends in ' ~ meta_secrets.capi_token.last4 ~ ' · blank keeps it' : 'Optional' }}"><p class="{{ note }}">Events Manager › your Pixel › Settings › Generate access token. With it, a purchase is also sent from the server, so it counts when a browser blocks the Pixel.</p></div>
          <div><label class="{{ label }}" for="mk-consent">Consent</label><select id="mk-consent" name="marketing[consent]" class="{{ input }}">{% for key, name in consent_modes %}<option value="{{ key }}" {% if m.consent == key %}selected{% endif %}>{{ name }}</option>{% endfor %}</select><p class="{{ note }}">In the EU the Pixel runs only after a visitor agrees. The site's banner asks once and remembers the answer for six months.</p></div>
          <div><label class="{{ label }}" for="mk-privacy">Privacy page</label><select id="mk-privacy" name="marketing[privacy_page]" class="{{ input }}"><option value="">None</option>{% for slug, title in pages %}<option value="{{ slug }}" {% if m.privacy_page == slug %}selected{% endif %}>{{ title }}</option>{% endfor %}</select><p class="{{ note }}">Linked from the banner.</p></div>
          <div><label class="{{ label }}" for="mk-test">Test event code</label><input id="mk-test" name="marketing[test_code]" value="{{ m.test_code }}" class="{{ input }} font-mono" maxlength="34" autocomplete="off" placeholder="TEST12345"><p class="{{ note }}">From Events Manager › Test events, while you check. Empty it afterwards: with it, server events show only as tests.</p></div>
          <div class="flex flex-wrap items-end gap-3">
            <button type="submit" name="meta_action" value="test" class="{{ btn }} border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Save and send a test event</button>
            {% if meta_secrets.capi_token.set|default(false) %}<label class="flex items-center gap-2 text-xs text-slate-500"><input type="checkbox" name="meta_clear" value="1" class="h-4 w-4 rounded border-slate-300">Remove the access token</label>{% endif %}
          </div>
          <div class="sm:col-span-2 rounded-md bg-slate-50 px-3 py-2 text-xs text-slate-600">
            <p class="mb-1 font-medium text-slate-800">What is sent</p>
            <p class="m-0">Every page: PageView. A product: ViewContent. Add to cart, the checkout and a paid order: AddToCart, InitiateCheckout and Purchase, with the same product ids as the feed. The server sends Purchase when an order is paid, only for a visitor who agreed, with the address hashed as Meta asks; the page and the server give it the same event id, so Meta counts it once.</p>
          </div>
        </div>
      </section>
      <div><button type="submit" class="{{ primary }}">Save</button></div>
    </form>
  {% endif %}

  {% if tab == 'import' %}
    {% include '@admin/partials/shop-import.twig' %}
  {% endif %}
{% endblock %}
