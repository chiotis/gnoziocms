{% extends '@admin/base.twig' %}
{% set page_heading = 'Coupons' %}
{% import '@admin/partials/ui.twig' as ui %}
{# Shop > Coupons (docs/shop-plan.md, section 3): the list, and the form of a new or chosen one. #}
{% block content %}
  {% set input = 'block w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
  {% set label = 'block text-xs font-medium text-slate-600 mb-1' %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {% set btn = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium shadow-sm' %}
  {{ ui.flash(message, done == 'ok' ? 'success' : 'error') }}

  {% if editing or creating %}
    {% set c = editing ?? {code: '', kind: 'percent', amount: '', min_cents: 0, starts_at: '', ends_at: '', usage_limit: 0, per_customer: 0, collections: [], active: true, used: 0, note: ''} %}
    <form method="post" action="{{ url('admin/shop-coupons') }}" class="{{ card }} mb-4">
      {{ csrf_field() }}<input type="hidden" name="original" value="{{ editing ? c.code : '' }}">
      <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3"><h2 class="text-sm font-semibold text-slate-900">{{ editing ? 'Coupon ' ~ c.code : 'New coupon' }}</h2>{% if editing %}<span class="text-xs text-slate-400">Used {{ c.used }} times</span>{% endif %}</div>
      <div class="grid gap-4 px-4 py-4 sm:grid-cols-3">
        <div><label class="{{ label }}" for="c-code">Code</label><input id="c-code" name="code" value="{{ c.code }}" class="{{ input }} font-mono uppercase" maxlength="40" required spellcheck="false" autocomplete="off"></div>
        <div><label class="{{ label }}" for="c-kind">Kind</label><select id="c-kind" name="kind" class="{{ input }}">{% for key, name in kinds %}<option value="{{ key }}" {% if c.kind == key %}selected{% endif %}>{{ name }}</option>{% endfor %}</select></div>
        <div><label class="{{ label }}" for="c-amount">Amount (% or €)</label><input id="c-amount" type="number" name="amount" value="{{ c.amount ?: '' }}" min="0" step="0.01" class="{{ input }}"></div>
        <div><label class="{{ label }}" for="c-min">Minimum order (€)</label><input id="c-min" type="number" name="min" value="{{ c.min_cents ? (c.min_cents / 100)|number_format(2, '.', '') : '' }}" min="0" step="0.01" class="{{ input }}"></div>
        <div><label class="{{ label }}" for="c-from">From</label><input id="c-from" type="date" name="starts_at" value="{{ c.starts_at }}" class="{{ input }}"></div>
        <div><label class="{{ label }}" for="c-to">Until</label><input id="c-to" type="date" name="ends_at" value="{{ c.ends_at }}" class="{{ input }}"></div>
        <div><label class="{{ label }}" for="c-limit">Uses in all (0: no limit)</label><input id="c-limit" type="number" name="usage_limit" value="{{ c.usage_limit }}" min="0" class="{{ input }}"></div>
        <div><label class="{{ label }}" for="c-per">Uses per customer (0: no limit)</label><input id="c-per" type="number" name="per_customer" value="{{ c.per_customer }}" min="0" class="{{ input }}"></div>
        <div><label class="{{ label }}" for="c-note">Note (only here)</label><input id="c-note" name="note" value="{{ c.note }}" class="{{ input }}" maxlength="200"></div>
        {% if collections is not empty %}
          <fieldset class="sm:col-span-3"><legend class="{{ label }}">Only for pieces of these collections (none: everything)</legend>
            {% for id, name in collections %}<label class="mr-3 inline-flex items-center gap-1.5 text-sm text-slate-700"><input type="checkbox" name="collections[]" value="{{ id }}" class="h-4 w-4 rounded border-slate-300" {% if id in c.collections %}checked{% endif %}> {{ name }}</label>{% endfor %}
          </fieldset>
        {% endif %}
        <label class="flex items-center gap-2 text-sm text-slate-700 sm:col-span-3"><input type="checkbox" name="active" value="1" class="h-4 w-4 rounded border-slate-300" {% if c.active %}checked{% endif %}> Active</label>
      </div>
      <div class="flex gap-2 border-t border-slate-200 px-4 py-3">
        <button class="{{ btn }} bg-blue-600 text-white hover:bg-blue-700">Save</button>
        <a href="{{ url('admin/shop-coupons') }}" class="{{ btn }} border border-slate-300 bg-white text-slate-700 shadow-none hover:bg-slate-50">Cancel</a>
      </div>
    </form>
  {% else %}
    <div class="mb-4"><a href="{{ url('admin/shop-coupons?new=1') }}" class="{{ btn }} bg-blue-600 text-white hover:bg-blue-700">New coupon</a></div>
  {% endif %}

  <div class="overflow-hidden {{ card }}">
    {% if coupons is empty %}
      {{ ui.empty_state('No coupons', 'A code customers write in the cart: a percentage or an amount off, or free shipping.') }}
    {% else %}
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Code</th><th class="px-4 py-2">Gives</th><th class="px-4 py-2">Valid</th><th class="px-4 py-2 text-right">Used</th><th class="px-4 py-2"></th></tr></thead>
        <tbody class="divide-y divide-slate-100">
          {% for c in coupons %}
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><a class="font-mono font-medium text-blue-700 hover:underline" href="{{ url('admin/shop-coupons?code=' ~ c.code) }}">{{ c.code }}</a> {% if not c.active %}{{ ui.badge('Off', 'slate') }}{% endif %}</td>
              <td class="px-4 py-2 text-slate-600">{{ c.kind == 'percent' ? c.amount ~ '%' : (c.kind == 'fixed' ? '€' ~ c.amount : 'Free shipping') }}{% if c.min_cents %} <span class="text-xs text-slate-400">over €{{ c.min_cents / 100 }}</span>{% endif %}{% if c.collections is not empty %} <span class="text-xs text-slate-400">· {{ c.collections|length }} collections</span>{% endif %}</td>
              <td class="px-4 py-2 text-xs text-slate-500">{{ c.starts_at ?: '—' }} → {{ c.ends_at ?: '—' }}</td>
              <td class="px-4 py-2 text-right tabular-nums">{{ c.used }}{% if c.usage_limit %} / {{ c.usage_limit }}{% endif %}</td>
              <td class="px-4 py-2 text-right">
                <form method="post" action="{{ url('admin/shop-coupons') }}" data-confirm="Delete the coupon {{ c.code }}?">{{ csrf_field() }}<input type="hidden" name="action" value="delete"><input type="hidden" name="code" value="{{ c.code }}"><button class="text-xs font-medium text-red-600 hover:underline">Delete</button></form>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>
{% endblock %}
