{% extends '@admin/base.twig' %}
{% set page_heading = 'Orders' %}
{% import '@admin/partials/ui.twig' as ui %}
{# Shop > Orders (docs/shop-plan.md, section 8): status chips with their counts, search, dates, the list and its CSV. #}
{% block content %}
  {% set input = 'rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
  {% set tones = {pending_payment: 'amber', on_hold: 'amber', paid: 'blue', processing: 'violet', shipped: 'blue', completed: 'green', cancelled: 'slate', refunded: 'red'} %}
  <div class="mb-3 flex flex-wrap items-center gap-1.5">
    <a href="{{ url('admin/shop-orders') }}" class="rounded-full px-3 py-1 text-xs font-medium {{ filters.status == '' ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50' }}">All</a>
    {% for key, name in statuses %}
      {% if counts[key] > 0 or filters.status == key %}
        <a href="{{ url('admin/shop-orders?status=' ~ key) }}" class="rounded-full px-3 py-1 text-xs font-medium {{ filters.status == key ? 'bg-slate-900 text-white' : 'bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-50' }}">{{ name }} <span class="opacity-60">{{ counts[key] }}</span></a>
      {% endif %}
    {% endfor %}
  </div>
  <form method="get" action="{{ url('admin/shop-orders') }}" class="mb-4 flex flex-wrap items-end gap-2">
    {% if filters.status %}<input type="hidden" name="status" value="{{ filters.status }}">{% endif %}
    <label class="grow"><span class="sr-only">Search</span><input type="search" name="q" value="{{ filters.q }}" placeholder="Number, email or name" class="{{ input }} w-full"></label>
    <label class="text-xs text-slate-500">From <input type="date" name="from" value="{{ filters.from }}" class="{{ input }}"></label>
    <label class="text-xs text-slate-500">To <input type="date" name="to" value="{{ filters.to }}" class="{{ input }}"></label>
    <button class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">Show</button>
    <a href="{{ url('admin/shop-orders?' ~ query|merge({export: 'csv'})|url_encode) }}" class="rounded-md px-3 py-1.5 text-sm font-medium text-blue-700 hover:bg-blue-50">CSV with VAT</a>
  </form>

  <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
    {% if orders is empty %}
      {{ ui.empty_state('No orders', filters.q or filters.status or filters.from ? 'Nothing matches these filters.' : 'Orders placed at the checkout appear here.') }}
    {% else %}
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
          <tr><th class="px-4 py-2">Order</th><th class="px-4 py-2">Date</th><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Payment</th><th class="px-4 py-2">Status</th><th class="px-4 py-2 text-right">Total</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for order in orders %}
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-2"><a class="font-mono font-medium text-blue-700 hover:underline" href="{{ url('admin/shop-orders?id=' ~ order.id) }}">{{ order.number }}</a></td>
              <td class="whitespace-nowrap px-4 py-2 text-slate-500">{{ order.created_at|date('d/m/Y H:i') }}</td>
              <td class="px-4 py-2"><span class="text-slate-900">{{ order.name ?: order.email }}</span>{% if order.name %}<span class="block text-xs text-slate-400">{{ order.email }}</span>{% endif %}</td>
              <td class="px-4 py-2 text-slate-500">{{ {viva: 'Viva Wallet', cardlink: 'Cardlink', bank_transfer: 'Bank transfer', cod: 'Cash on delivery'}[order.payment_method] ?? order.payment_method }}</td>
              <td class="px-4 py-2">{{ ui.badge(order.status_label, tones[order.status] ?? 'slate') }}</td>
              <td class="whitespace-nowrap px-4 py-2 text-right font-medium tabular-nums">{{ order.total }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% endif %}
  </div>
  <div class="mt-3 flex items-center justify-between text-xs text-slate-400"><span>{{ total }} orders</span>{{ ui.pagination(page, pages, query) }}</div>
{% endblock %}
