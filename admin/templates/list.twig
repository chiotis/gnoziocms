{% extends '@admin/base.twig' %}
{% set page_heading = current_type|title %}
{% import '@admin/partials/ui.twig' as ui %}

{% block content %}
  {% set singular = current_type ends with 's' ? current_type|slice(0, -1) : current_type %}
  {% set btn_primary = 'inline-flex items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm no-underline hover:bg-blue-700' %}
  {% set btn_secondary = 'inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm no-underline hover:bg-slate-50' %}
  {% set icon_button = 'rounded-md p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-700' %}
  {% set icon_danger = 'rounded-md p-1.5 text-red-500 hover:bg-red-50 hover:text-red-600' %}

  {% if deleted and deleted_to %}
    {{ ui.flash('Deleted. Visitors who ask for ' ~ deleted_from ~ ' are sent to ' ~ deleted_to ~ '.', 'success') }}
  {% else %}
    {{ ui.flash(deleted ? 'Deleted.' : '', 'success') }}
  {% endif %}
  {% if deleted and deleted_gone %}
    <div class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900" role="status">
      Visitors who still ask for <code>{{ deleted_gone }}</code> will see a "not found" page.
      {% if can_redirects %}<a class="font-semibold underline" href="{{ url('admin/redirects?source=' ~ deleted_gone|url_encode) }}#add">Send them somewhere</a>{% endif %}
    </div>
  {% endif %}
  {{ ui.flash(bulk_message, bulk_status == 'ok' ? 'success' : 'error') }}

  <header class="mb-4 flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="min-w-0">
      <p class="truncate text-xs text-slate-400">Manage {{ current_type|title }} content.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {# The products' CSV is in Shop settings > Import & export, beside the WooCommerce import. #}
      {% if current_type != 'products' %}
      <a class="{{ btn_secondary }}" href="{{ url('admin/import?type=' ~ current_type) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        Import CSV
      </a>
      <a class="{{ btn_secondary }}" href="{{ url('admin/export?type=' ~ current_type) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21V9m0 12 4-4m-4 4-4-4M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/></svg>
        Export CSV
      </a>
      {% endif %}
      <a class="{{ btn_primary }}" href="{{ url('admin/new?type=' ~ current_type ~ '&lang=' ~ lang) }}">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
        New {{ singular|title }}
      </a>
    </div>
  </header>

  {# The filter bar: search, status and the type's taxonomies at hand, the rest behind "More filters". It sends itself as
     each choice is made (admin.js, form[data-filter-bar]); every filter is a comma-separated list in the address. #}
  {% set field_small = 'rounded-md border border-slate-300 bg-white px-2.5 py-1.5 text-sm text-slate-700' %}
  {% set clean_query = list_query|filter((v, k) => k != 'page') %}
  <form method="get" action="{{ url('admin/content') }}" class="mb-4 rounded-lg border border-slate-200 bg-white" data-filter-bar role="search" aria-label="Filter {{ current_type }}">
    <input type="hidden" name="type" value="{{ current_type }}">
    <input type="hidden" name="lang" value="{{ lang }}">
    {% if list_query.per_page is defined %}<input type="hidden" name="per_page" value="{{ list_query.per_page }}">{% endif %}
    <div class="flex flex-wrap items-center gap-2 p-2.5">
      <label class="relative block w-full sm:w-64">
        <span class="sr-only">Search</span>
        <svg class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path stroke-linecap="round" d="m20 20-3.5-3.5"/></svg>
        <input type="search" name="q" value="{{ filters.q }}" placeholder="{{ current_type == 'products' ? 'Title, slug or SKU' : 'Title or slug' }}" class="w-full rounded-md border border-slate-300 bg-white py-1.5 pl-8 pr-2.5 text-sm" data-filter-search>
      </label>
      {{ ui.multi_select('status', 'Status', status_options|map(o => {value: o, label: o|title}), filters.status ? filters.status|split(',') : []) }}
      {% for taxonomy in filter_bar.taxonomies %}
        {{ ui.multi_select('in_' ~ taxonomy.name, taxonomy.title, taxonomy.options|map(o => {value: o.id, label: o.label, depth: o.depth, count: o.count}), taxonomy.selected) }}
      {% endfor %}
      <button type="button" data-toggle="filter" data-target="moreFilters" aria-controls="moreFilters" aria-expanded="{{ more_filters_active ? 'true' : 'false' }}" class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4"/></svg>
        More filters
        {% if more_filters_active %}<span class="rounded-full bg-blue-600 px-1.5 text-[11px] font-semibold leading-4 text-white">{{ more_filters_active }}</span>{% endif %}
      </button>
      {% if filters_active %}
        <a href="{{ url('admin/content?' ~ {type: current_type, lang: lang}|merge(list_query.per_page is defined ? {per_page: list_query.per_page} : {})|url_encode) }}" class="ml-auto rounded-md px-2.5 py-1.5 text-sm font-medium text-slate-500 hover:bg-slate-100 hover:text-slate-800">Reset</a>
      {% endif %}
      <noscript><button type="submit" class="{{ btn_secondary }}">Apply</button></noscript>
    </div>

    <div id="moreFilters" class="grid grid-cols-1 gap-3 border-t border-slate-100 px-3 py-3 sm:grid-cols-2 lg:grid-cols-4 {{ more_filters_active ? '' : 'hidden' }}">
      <label class="block">
        <span class="mb-1 block text-xs font-medium text-slate-500">Main image</span>
        <select name="image" class="w-full {{ field_small }}" data-filter-auto>
          <option value="">Any</option>
          <option value="with" {% if filters.image == 'with' %}selected{% endif %}>With a main image</option>
          <option value="without" {% if filters.image == 'without' %}selected{% endif %}>Without a main image</option>
        </select>
      </label>
      {% if filter_bar.stock %}
        <label class="block">
          <span class="mb-1 block text-xs font-medium text-slate-500">Stock</span>
          <select name="stock" class="w-full {{ field_small }}" data-filter-auto>
            <option value="">Any</option>
            {% for value, label in {in: 'In stock', low: 'Low stock', out: 'Out of stock', untracked: 'Stock not tracked'} %}
              <option value="{{ value }}" {% if filters.stock == value %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
      {% if filter_bar.authors is not empty %}
        <label class="block">
          <span class="mb-1 block text-xs font-medium text-slate-500">Author</span>
          <select name="author" class="w-full {{ field_small }}" data-filter-auto>
            <option value="">Anyone</option>
            {% for author in filter_bar.authors %}<option value="{{ author }}" {% if filters.author == author %}selected{% endif %}>{{ author }}</option>{% endfor %}
          </select>
        </label>
      {% endif %}
      <fieldset class="block sm:col-span-2 lg:col-span-1">
        <legend class="mb-1 block text-xs font-medium text-slate-500">Updated</legend>
        <div class="flex items-center gap-1.5">
          <input type="date" name="updated_from" value="{{ filters.updated_from }}" class="min-w-0 flex-1 {{ field_small }}" aria-label="Updated from" data-filter-auto>
          <span class="text-xs text-slate-400">to</span>
          <input type="date" name="updated_to" value="{{ filters.updated_to }}" class="min-w-0 flex-1 {{ field_small }}" aria-label="Updated until" data-filter-auto>
        </div>
      </fieldset>
    </div>

    {% if filters_active %}
      {# What is applied, each with a way to take it off. #}
      {% set chip = 'inline-flex items-center gap-1 rounded-full bg-blue-50 py-0.5 pl-2.5 pr-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-200' %}
      {% set x_icon = '<svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>' %}
      <div class="flex flex-wrap items-center gap-1.5 border-t border-slate-100 px-3 py-2">
        {% if filters.q %}
          <span class="{{ chip }}">“{{ filters.q }}”<a href="{{ url('admin/content?' ~ clean_query|filter((v, k) => k != 'q')|url_encode) }}" class="rounded-full p-0.5 hover:bg-blue-100" aria-label="Remove the search">{{ x_icon|raw }}</a></span>
        {% endif %}
        {% for status in filters.status ? filters.status|split(',') : [] %}
          {% set rest = filters.status|split(',')|filter(s => s != status)|join(',') %}
          <span class="{{ chip }}">Status: {{ status|title }}<a href="{{ url('admin/content?' ~ clean_query|merge({status: rest})|filter(v => v != '')|url_encode) }}" class="rounded-full p-0.5 hover:bg-blue-100" aria-label="Remove status {{ status }}">{{ x_icon|raw }}</a></span>
        {% endfor %}
        {% for taxonomy in filter_bar.taxonomies %}
          {% for id in taxonomy.selected %}
            {% set key = 'in_' ~ taxonomy.name %}
            {% set rest = taxonomy.selected|filter(s => s != id)|join(',') %}
            <span class="{{ chip }}">{{ taxonomy.title }}: {{ filter_bar.labels[taxonomy.name][id]|default(id) }}<a href="{{ url('admin/content?' ~ clean_query|merge({(key): rest})|filter(v => v != '')|url_encode) }}" class="rounded-full p-0.5 hover:bg-blue-100" aria-label="Remove {{ taxonomy.title }} {{ filter_bar.labels[taxonomy.name][id]|default(id) }}">{{ x_icon|raw }}</a></span>
          {% endfor %}
        {% endfor %}
        {% set more_labels = {
          image: filters.image == 'with' ? 'With a main image' : 'Without a main image',
          stock: {in: 'In stock', low: 'Low stock', out: 'Out of stock', untracked: 'Stock not tracked'}[filters.stock]|default(''),
          author: 'Author: ' ~ filters.author,
          updated_from: 'Updated from ' ~ filters.updated_from,
          updated_to: 'Updated until ' ~ filters.updated_to
        } %}
        {% for key, label in more_labels %}
          {% if filters[key]|default('') %}
            <span class="{{ chip }}">{{ label }}<a href="{{ url('admin/content?' ~ clean_query|filter((v, k) => k != key)|url_encode) }}" class="rounded-full p-0.5 hover:bg-blue-100" aria-label="Remove: {{ label }}">{{ x_icon|raw }}</a></span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </form>

  <form method="post" action="{{ url('admin/content-bulk') }}" class="rounded-lg border border-slate-200 bg-white" data-bulk-form>
    {{ csrf_field() }}
    <input type="hidden" name="type" value="{{ current_type }}">
    <input type="hidden" name="lang" value="{{ lang }}">
    {# The list to come back to, and what "select all" on every page means: the entries these filters let through. #}
    {% for name, value in list_query|filter((v, k) => k != 'type' and k != 'lang') %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
    {% if page > 1 %}<input type="hidden" name="page" value="{{ page }}">{% endif %}
    <input type="hidden" name="all_matching" value="0" data-select-rest-input>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="font-medium text-slate-700" data-list-count>{% if total == 0 %}0 {{ filters_active ? 'matching' : '' }} entries{% elseif total_pages > 1 %}{{ shown_from }}–{{ shown_to }} of {{ total }} {{ filters_active ? 'matching' : '' }} entries{% else %}{{ total }} {{ filters_active ? 'matching' : '' }} entr{{ total == 1 ? 'y' : 'ies' }}{% endif %}</span>
        <span class="mx-1 h-4 w-px bg-slate-200"></span>
        <nav class="flex items-center gap-1" aria-label="Language">
          {% for l in languages %}
            <a href="{{ url('admin/content?' ~ list_query|merge({'lang': l})|url_encode) }}" class="rounded-md px-2.5 py-1 text-xs font-medium {{ l == lang ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' }}" {% if l == lang %}aria-current="true"{% endif %}>{{ l|upper }}</a>
          {% endfor %}
        </nav>
      </div>
      {% if items is not empty %}
        <div class="flex items-center gap-2">
          <select name="bulk_action" class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-700" aria-label="Bulk action">
            <option value="">Bulk action…</option>
            <option value="publish">Publish</option>
            <option value="draft">Move to draft</option>
            <option value="delete">Delete</option>
            {% if ai_bulk %}<option value="generate_images">Generate main images (AI)</option>{% endif %}
            {# Filing the selected entries under a term of one of the type's taxonomies, or taking them out of it: the other terms they have stay. #}
            {% for taxonomy in current_type != 'pages' ? filter_bar.taxonomies|default([]) : [] %}
              {% for kind, verb in {'term_add': 'Add to', 'term_remove': 'Remove from'} %}
                <optgroup label="{{ verb }} {{ taxonomy.title }}">
                  {% for o in taxonomy.options %}<option value="{{ kind }}:{{ taxonomy.name }}:{{ o.id }}">{{ verb }}: {% if o.depth > 0 %}{% for i in 1..o.depth %}— {% endfor %}{% endif %}{{ o.label }}</option>{% endfor %}
                </optgroup>
              {% endfor %}
            {% endfor %}
          </select>
          {% if ai_bulk %}
            <label class="hidden items-center gap-1 text-xs text-slate-600" data-ai-bulk-replace><input type="checkbox" name="ai_replace" value="1" class="h-3.5 w-3.5 rounded border-slate-300"> Replace existing images</label>
          {% endif %}
          <button type="submit" class="{{ btn_secondary }}" data-confirm="Apply this action to the selected {{ current_type }}? Deleted items cannot be recovered except from a backup." data-confirm-button="Apply"{% if ai_bulk %} data-ai-bulk-apply data-ai-picture-cost="{{ ai_bulk.picture_cost }}" data-ai-total="{{ total }}" data-ai-blocked="{{ ai_bulk.blocked }}"{% endif %}>Apply</button>
        </div>
      {% endif %}
    </div>

    {# Shown while pictures wait or are being made, and after a run only when some failed (to say why); a run that went well leaves only its row chips. #}
    {% if ai_bulk and (ai_bulk.progress.waiting + ai_bulk.progress.working + ai_bulk.progress.failed) > 0 %}
      {% set p = ai_bulk.progress %}
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-violet-100 bg-violet-50 px-4 py-2 text-sm text-violet-900" role="status" aria-live="polite"
           data-ai-bulk-progress data-ai-endpoint="{{ url('admin/ai-picture') }}" data-ai-type="{{ current_type }}" data-ai-lang="{{ lang }}" data-ai-live="{{ p.waiting + p.working }}">
        <span data-ai-bulk-line>{% if p.waiting + p.working > 0 %}Making AI pictures: {{ p.waiting + p.working }} left{% else %}AI pictures{% endif %}{% if p.done %} · {{ p.done }} done{% endif %}{% if p.failed %} · {{ p.failed }} failed{% endif %}</span>
        <span class="text-xs text-violet-700">{{ p.waiting + p.working > 0 ? 'One at a time, about 15–60 s each. You can leave this page; the cron job goes on.' : 'In the last few hours. Retry them from the Runs tab.' }}</span>
        {% if p.failed and can('ai.manage') %}<a class="text-xs font-medium underline" href="{{ url('admin/ai-publishing?tab=runs') }}">See why</a>{% endif %}
      </div>
    {% endif %}

    {% if total > items|length %}
      {# Shown once every entry on this page is ticked: the rest of the list can be taken in too. #}
      <div class="hidden border-b border-blue-100 bg-blue-50 px-4 py-2 text-sm text-blue-900" data-select-rest="selected[]" role="status">
        <span data-select-rest-page>All {{ items|length }} {{ current_type }} on this page are selected. <button type="button" class="font-semibold underline" data-select-rest-all>Select all {{ total }} {{ filters_active ? 'matching ' : '' }}{{ current_type }}</button></span>
        <span class="hidden" data-select-rest-done>All {{ total }} {{ filters_active ? 'matching ' : '' }}{{ current_type }} are selected, on every page. <button type="button" class="font-semibold underline" data-select-rest-clear>Clear the selection</button></span>
      </div>
    {% endif %}

    {% if items is empty %}
      {% if filters_active %}
        {{ ui.empty_state('Nothing matches these filters', 'Reset the filters to see every ' ~ singular ~ ' in ' ~ lang|upper ~ '.') }}
      {% else %}
        <div class="flex flex-col items-center justify-center px-6 py-16 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100">
            <svg class="h-6 w-6 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m-7 5h8a2 2 0 0 0 2-2V7l-5-5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2z"/></svg>
          </div>
          <h2 class="mt-3 text-sm font-semibold text-slate-900">No content yet</h2>
          <p class="mt-1 max-w-sm text-sm text-slate-400">Create the first {{ singular }} for this language.</p>
          <div class="mt-4">
            <a class="{{ btn_primary }}" href="{{ url('admin/new?type=' ~ current_type ~ '&lang=' ~ lang) }}">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14"/></svg>
              New {{ singular|title }}
            </a>
          </div>
        </div>
      {% endif %}
    {% else %}
      <div class="overflow-x-auto">
        <table class="w-full text-sm" data-sortable>
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50/50 text-left text-xs font-medium text-slate-400">
              <th class="w-8 px-4 py-2"><input type="checkbox" data-select-all="selected[]" class="h-4 w-4 rounded border-slate-300" aria-label="Select all on this page"></th>
              <th class="px-4 py-2 font-medium" data-sort="text">Title</th>
              {% for column in filter_bar.columns %}<th class="px-4 py-2 font-medium" data-sort="text">{{ column.title }}</th>{% endfor %}
              <th class="px-4 py-2 font-medium" data-sort="text">Status</th>
              <th class="px-4 py-2 font-medium">Language</th>
              <th class="px-4 py-2 font-medium" data-sort="number">Updated</th>
              <th class="px-4 py-2 text-right font-medium">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            {% for item in items %}
              {% set status = item.meta.status ?? 'published' %}
              {% set key = item.slug ~ '|' ~ item.lang %}
              {% set is_home = current_type == 'pages' and item.slug == site.home_page and item.lang == site.languages.default %}
              <tr class="group hover:bg-slate-50">
                <td class="px-4 py-2.5"><input type="checkbox" name="selected[]" value="{{ item.slug }}" class="h-4 w-4 rounded border-slate-300" aria-label="Select {{ item.meta.title ?: item.slug }}"{% if item.meta.main_image|default('') %} data-has-image{% endif %}></td>
                <td class="px-4 py-2.5" data-sort-value="{{ item.meta.title ?: item.slug }}">
                  <a href="{{ url('admin/edit?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}" class="font-medium text-slate-900 no-underline hover:text-blue-600">
                    {{ item.meta.title ?: item.slug }}
                  </a>
                  <div class="mt-0.5 flex items-center gap-2 text-xs text-slate-400">
                    <span>/{{ item.slug }}</span>
                    {% if item.meta.generated_by|default('') starts with 'AI publishing' %}<span title="Written by {{ item.meta.generated_by }}">{{ ui.badge('AI', 'violet') }}</span>
                    {% elseif item.meta.generated_by|default('') %}<span title="Written through MCP by {{ item.meta.generated_by }}">{{ ui.badge('MCP', 'amber') }}</span>{% endif %}
                    {% set ai_state = ai_bulk ? ai_bulk.states[item.slug]|default(null) : null %}
                    {% if ai_state %}
                      <span data-ai-state="{{ ai_state.status }}" title="{{ ai_state.status == 'failed' ? ai_state.error : (ai_state.outcome == 'kept' ? 'It had a main image by then, so the new picture was only added to the Media library.' : '') }}">
                        {% if ai_state.status == 'queued' %}{{ ui.badge('Picture waiting', 'amber') }}
                        {% elseif ai_state.status == 'running' %}{{ ui.badge('Making picture', 'blue') }}
                        {% elseif ai_state.status == 'failed' %}{{ ui.badge('Picture failed', 'red') }}
                        {% elseif ai_state.status == 'done' and ai_state.outcome == 'set' %}{{ ui.badge('AI picture', 'green') }}
                        {% elseif ai_state.status == 'done' %}{{ ui.badge('Picture in library', 'slate') }}{% endif %}
                      </span>
                    {% endif %}
                    {% if current_type != 'pages' and item.meta.main_image %}
                      <span class="meta-icon relative inline-flex h-5 w-5 cursor-pointer items-center justify-center rounded border border-slate-200 bg-white text-slate-400" title="Has main image">
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4zM8 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM4 16l5-5 4 4 3-3 4 4"/></svg>
                        <span class="meta-tooltip pointer-events-none fixed z-50 hidden rounded-md border border-slate-300 bg-white p-1.5 shadow">
                          <img src="{{ item.meta.main_image }}" alt="Main image preview" class="h-20 w-32 rounded-md object-cover">
                        </span>
                      </span>
                    {% endif %}
                  </div>
                </td>
                {% for column in filter_bar.columns %}
                  {% set ids = item.meta[column.name] is iterable ? item.meta[column.name] : (item.meta[column.name] is defined and item.meta[column.name] ? [item.meta[column.name]] : []) %}
                  {% set names = ids|map(id => filter_bar.labels[column.name][id]|default(null))|filter(n => n is not null) %}
                  <td class="px-4 py-2.5" data-sort-value="{{ names|join(', ') }}">
                    {% if names is empty %}<span class="text-slate-300" aria-label="None">—</span>{% else %}
                      <div class="flex max-w-[16rem] flex-wrap gap-1">
                        {% for id in ids|filter(id => filter_bar.labels[column.name][id] is defined)|slice(0, 3) %}
                          <a href="{{ url('admin/content?' ~ clean_query|merge({('in_' ~ column.name): id})|url_encode) }}" class="whitespace-nowrap rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-600 no-underline hover:bg-slate-200 hover:text-slate-900" title="Show only {{ filter_bar.labels[column.name][id] }}">{{ filter_bar.labels[column.name][id] }}</a>
                        {% endfor %}
                        {% if names|length > 3 %}<span class="px-1 py-0.5 text-xs text-slate-400" title="{{ names|slice(3)|join(', ') }}">+{{ names|length - 3 }}</span>{% endif %}
                      </div>
                    {% endif %}
                  </td>
                {% endfor %}
                <td class="px-4 py-2.5" data-sort-value="{{ status }}">
                  {{ ui.status_badge(status) }}
                  {% set publish_at = item.publishAtTime() %}
                  {% if publish_at %}
                    <span class="mt-0.5 block whitespace-nowrap text-xs text-slate-500" title="Goes live on {{ publish_at|date('l j F Y, H:i') }}">{{ publish_at|date('Y-m-d H:i') }}</span>
                  {% endif %}
                  {% if current_type == 'pages' and item.slug == site.home_page %}
                    {{ ui.badge('Home', 'blue') }}
                  {% endif %}
                  {% if item.meta.seo is defined and item.meta.seo.noindex %}
                    {{ ui.badge('Noindex', 'pink') }}
                  {% endif %}
                  {% if item.meta.front_matter_error is defined %}
                    <span title="{{ item.meta.front_matter_error }}">{{ ui.badge('Unreadable', 'red') }}</span>
                  {% endif %}
                </td>
                <td class="px-4 py-2.5">
                  <div class="flex flex-wrap items-center gap-1">
                    <span class="inline-flex h-5 min-w-7 items-center justify-center rounded bg-emerald-50 px-1 text-[10px] font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-200">{{ item.lang|upper }}</span>
                    {% for l in translation_langs[key]|default([]) %}
                      <span class="inline-flex h-5 min-w-7 items-center justify-center rounded border border-dashed border-slate-300 px-1 text-[10px] font-semibold text-slate-500">{{ l|upper }}</span>
                    {% endfor %}
                  </div>
                </td>
                <td class="px-4 py-2.5 text-slate-400" data-sort-value="{{ item.mtime }}">{{ item.mtime|date('Y-m-d H:i') }}</td>
                <td class="px-4 py-2.5">
                  <div class="flex items-center justify-end gap-0.5">
                    <a class="{{ icon_button }}" href="{{ url('admin/edit?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}" title="Edit {{ item.meta.title ?: item.slug }}" aria-label="Edit {{ item.meta.title ?: item.slug }}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                    </a>
                    {% if not is_home %}
                      {% if (item.meta.status ?? 'published') == 'published' %}
                        {# A public entry: the next page asks where its visitors should go. #}
                        <a class="{{ icon_danger }}" href="{{ url('admin/delete?type=' ~ current_type ~ '&slug=' ~ item.slug ~ '&lang=' ~ item.lang) }}" title="Delete {{ item.meta.title ?: item.slug }}" aria-label="Delete {{ item.meta.title ?: item.slug }}">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6"/></svg>
                        </a>
                      {% else %}
                        <button type="submit" form="delete-{{ item.slug }}" class="{{ icon_danger }}" title="Delete {{ item.meta.title ?: item.slug }}" aria-label="Delete {{ item.meta.title ?: item.slug }}">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V6"/></svg>
                        </button>
                      {% endif %}
                    {% endif %}
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}

    {% if total > min(per_page_options|filter(o => o > 0)) %}
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 px-4 py-2.5">
        <label class="flex items-center gap-2 text-xs text-slate-500">
          Per page
          <select class="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-600" aria-label="Entries per page" onchange="window.location.search = new URLSearchParams(Object.assign({{ list_query|filter((v, k) => k != 'per_page')|json_encode }}, this.value === '{{ constant('GnozioCMS\\ContentAdmin::PER_PAGE_DEFAULT') }}' ? {} : {per_page: this.value})).toString()">
            {% for option in per_page_options %}
              <option value="{{ option == 0 ? 'all' : option }}" {% if option == per_page %}selected{% endif %}>{{ option == 0 ? 'All' : option }}</option>
            {% endfor %}
          </select>
        </label>
        {{ ui.pagination(page, total_pages, list_query) }}
      </div>
    {% endif %}
  </form>

  {# Row delete forms sit outside the bulk form because HTML forms cannot nest. #}
  {% for item in items %}
    {% if not (current_type == 'pages' and item.slug == site.home_page and item.lang == site.languages.default) %}
      <form id="delete-{{ item.slug }}" method="post" action="{{ url('admin/delete') }}" data-confirm="Delete “{{ item.meta.title ?: item.slug }}” ({{ item.lang|upper }})?" data-confirm-button="Delete" hidden>
        {{ csrf_field() }}
        <input type="hidden" name="type" value="{{ current_type }}">
        <input type="hidden" name="slug" value="{{ item.slug }}">
        <input type="hidden" name="lang" value="{{ item.lang }}">
      </form>
    {% endif %}
  {% endfor %}
  <script src="{{ asset('js/admin-filter-bar.js') }}" defer></script>
  {% if ai_bulk %}<script src="{{ asset('js/admin-ai-picture.js') }}" defer></script>{% endif %}
{% endblock %}
