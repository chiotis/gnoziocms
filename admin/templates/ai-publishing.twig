{% extends '@admin/base.twig' %}
{% set page_heading = 'AI publishing' %}
{% import '@admin/partials/ui.twig' as ui %}
{#
  Manage > AI publishing (docs/ai-publishing-plan.md): Instructions (the house style for pictures), Settings (key, models, limits,
  prices) and Usage (tokens and their estimated cost). Schedules and Runs come with phase 3.
#}

{% block content %}
  {% set btn = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium shadow-sm' %}
  {% set primary = btn ~ ' bg-blue-600 text-white hover:bg-blue-700' %}
  {% set secondary = btn ~ ' border border-slate-300 bg-white text-slate-700 hover:bg-slate-50' %}
  {% set input = 'block w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {% set card_head = 'flex items-center justify-between gap-3 border-b border-slate-200 px-4 py-3' %}
  {% set label = 'block text-xs font-medium text-slate-600 mb-1' %}
  {% set note = 'mt-1 text-xs text-slate-500' %}
  {% set money = '%.4f' %}

  {{ ui.flash(message, done == 'ok' ? 'success' : 'error') }}

  <header class="mb-4 border-b border-slate-200 pb-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <p class="max-w-3xl text-xs text-slate-500">The site writes posts on a timetable and makes their pictures itself, with OpenAI, from one set of instructions, so every post has the site's voice and look. <strong>Schedules</strong> write one post each time they run; pictures can also be made from the editor's Main image (Generate) or for many entries at once from a content list (Bulk action › Generate main images). Every call is counted on the Usage tab.</p>
      <div class="flex flex-wrap items-center gap-2" data-ai-state>
        {% if ai.paused %}
          {{ ui.badge('Paused', 'amber') }}
        {% elseif ai.has_key %}
          {{ ui.badge('Ready', 'green') }}
        {% else %}
          {{ ui.badge('No key yet', 'slate') }}
        {% endif %}
        <span class="text-xs text-slate-500">This month: ${{ money|format(this_month.cost) }} · {{ this_month.pictures }} picture{{ this_month.pictures == 1 ? '' : 's' }}</span>
        <form method="post" action="{{ url('admin/ai-publishing') }}">
          {{ csrf_field() }}<input type="hidden" name="tab" value="{{ tab }}">
          <button type="submit" name="ai_action" value="{{ ai.paused ? 'resume' : 'pause' }}" class="{{ secondary }} py-1 text-xs">{{ ai.paused ? 'Resume' : 'Pause all' }}</button>
        </form>
      </div>
    </div>
    {% if ai.paused and ai.paused_reason %}<p class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">{{ ai.paused_reason }}.</p>{% endif %}
    {% if blocked and not ai.paused %}<p class="mt-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">{{ blocked }}</p>{% endif %}
    <div class="-mb-4 mt-3 flex items-end justify-between gap-3">
      <nav class="flex min-w-0 gap-1 overflow-x-auto" aria-label="AI publishing">
        {% for key, name in tabs %}
          <a href="{{ url('admin/ai-publishing?tab=' ~ key) }}" class="shrink-0 border-b-2 px-3 py-2 text-sm font-medium {{ tab == key ? 'border-blue-600 text-slate-900' : 'border-transparent text-slate-500 hover:text-slate-800' }}"{% if tab == key %} aria-current="page"{% endif %}>{{ name }}</a>
        {% endfor %}
      </nav>
      {% if tab == 'schedules' and schedules and not schedules.editing %}
        {# List or week: the view of the schedules, kept for this person. #}
        <div class="mb-1.5 inline-flex shrink-0 rounded-md border border-slate-300 bg-white p-0.5 shadow-sm" role="group" aria-label="View" data-ai-view-switch>
          {% for key, name in {'list': 'List', 'week': 'Week'} %}
            <a href="{{ url('admin/ai-publishing?tab=schedules&view=' ~ key) }}" class="inline-flex items-center gap-1.5 rounded px-2.5 py-1 text-xs font-medium {{ schedules.view == key ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100' }}"{% if schedules.view == key %} aria-current="true"{% endif %}>
              {% if key == 'list' %}<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
              {% else %}<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7a2 2 0 012-2h12a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V7zM4 10h16M9 3v4M15 3v4"/></svg>{% endif %}
              {{ name }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </header>

  {% if tab == 'instructions' %}
    <form method="post" action="{{ url('admin/ai-publishing?tab=instructions') }}" class="{{ card }} mb-4" data-ai-writing>
      {{ csrf_field() }}
      <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Writing</h2><span class="text-xs text-slate-400">Sent first with every post a schedule writes</span></div>
      <div class="grid gap-4 px-4 py-4 lg:grid-cols-2">
        <div>
          <label class="{{ label }}" for="ai-writing">Writing instructions</label>
          <textarea id="ai-writing" name="writing_instructions" rows="7" class="{{ input }}" maxlength="6000">{{ ai.writing_instructions }}</textarea>
          <p class="{{ note }}">Who reads the site, the voice and tone, typical length and structure, SEO habits. A schedule adds only what is particular to it.</p>
        </div>
        <div class="space-y-4">
          <div>
            <label class="{{ label }}" for="ai-text-avoid">Avoid in the text</label>
            <textarea id="ai-text-avoid" name="text_avoid" rows="4" class="{{ input }}" placeholder="One per line">{{ ai.text_avoid|join("\n") }}</textarea>
            <p class="{{ note }}">One per line, sent as "Never do any of these". Each schedule can add its own.</p>
          </div>
          <div>
            <label class="{{ label }}" for="ai-facts">Facts about the site</label>
            <textarea id="ai-facts" name="site_facts" rows="3" class="{{ input }}" maxlength="4000" placeholder="What the business is and offers, where, its name as it must be written">{{ ai.site_facts }}</textarea>
          </div>
          <div>
            <label class="{{ label }}" for="ai-byline">Byline</label>
            <input id="ai-byline" name="byline" value="{{ ai.byline }}" class="{{ input }}" maxlength="80" placeholder="The author shown on the posts, for example the site's name">
          </div>
        </div>
      </div>
      <div class="flex justify-end border-t border-slate-100 px-4 py-3">
        <button type="submit" name="ai_action" value="save_writing" class="{{ primary }}">Save writing instructions</button>
      </div>
    </form>

    <div class="grid gap-4 lg:grid-cols-3">
      <form method="post" action="{{ url('admin/ai-publishing?tab=instructions') }}" class="{{ card }} lg:col-span-2" data-ai-instructions>
        {{ csrf_field() }}
        <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Pictures</h2><span class="text-xs text-slate-400">Used by every picture the site makes</span></div>
        <div class="space-y-4 px-4 py-4">
          <div>
            <label class="{{ label }}" for="ai-house-style">House style</label>
            <textarea id="ai-house-style" name="house_style" rows="4" class="{{ input }}" maxlength="4000">{{ ai.house_style }}</textarea>
            <p class="{{ note }}">The medium (photo, illustration, 3D, flat), palette, composition, light and mood. Sent word for word, first, with every picture. Illustration and abstract styles stay consistent far better than photographs.</p>
          </div>
          <div>
            <label class="{{ label }}" for="ai-avoid">Avoid in the picture</label>
            <textarea id="ai-avoid" name="picture_avoid" rows="4" class="{{ input }}" placeholder="One per line">{{ ai.picture_avoid|join("\n") }}</textarea>
            <p class="{{ note }}">One per line. Text, letters, numbers and logos are always avoided. Keep the list short: naming a thing, even to forbid it, can pull it into the picture, so where you can, say what the picture <em>does</em> show ("an empty street at dawn" rather than "no people").</p>
          </div>
          <div>
            <label class="{{ label }}" for="ai-references">Reference pictures <span class="font-normal text-slate-400">(up to {{ max_references }})</span></label>
            {% if ai.references %}
              <div class="mb-2 flex flex-wrap gap-2">
                {% for ref in ai.references %}<img src="{{ url(ref|trim('/')) }}" alt="" class="h-16 w-24 rounded border border-slate-200 object-cover">{% endfor %}
              </div>
            {% endif %}
            <textarea id="ai-references" name="references" rows="3" class="{{ input }} font-mono text-xs" placeholder="/uploads/media/…">{{ ai.references|join("\n") }}</textarea>
            <p class="{{ note }}">Addresses of pictures in the Media library, one per line. They are sent with every request so the new pictures follow their style (not their subjects). They keep a look far better than words do.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-4">
            <div>
              <label class="{{ label }}" for="ai-aspect">Shape</label>
              <select id="ai-aspect" name="aspect" class="{{ input }}">{% for a in aspects %}<option value="{{ a }}"{{ ai.aspect == a ? ' selected' }}>{{ a }}</option>{% endfor %}</select>
            </div>
            <div>
              <label class="{{ label }}" for="ai-quality">Quality</label>
              <select id="ai-quality" name="quality" class="{{ input }}">{% for q in qualities %}<option value="{{ q }}"{{ ai.quality == q ? ' selected' }}>{{ {'low': 'Draft (cheapest)', 'medium': 'Standard', 'high': 'High (dearest)'}[q] }}</option>{% endfor %}</select>
            </div>
            <div>
              <label class="{{ label }}" for="ai-format">Format</label>
              <select id="ai-format" name="format" class="{{ input }}">{% for f in formats %}<option value="{{ f }}"{{ ai.format == f ? ' selected' }}>{{ f|upper }}</option>{% endfor %}</select>
            </div>
            <div>
              <label class="{{ label }}" for="ai-variants">Variants in the editor</label>
              <select id="ai-variants" name="variants" class="{{ input }}">{% for n in 1..4 %}<option value="{{ n }}"{{ ai.variants == n ? ' selected' }}>{{ n }}</option>{% endfor %}</select>
            </div>
          </div>
          <p class="text-xs text-slate-500">Quality is the main cost: a draft picture costs a small fraction of a high one. Each variant is a picture paid for.</p>
          {% if content_types %}
            <div data-ai-auto>
              <span class="{{ label }}">Make a main picture automatically</span>
              <div class="flex flex-wrap gap-1.5">
                {% for t in content_types %}
                  <label class="inline-flex cursor-pointer items-center gap-1 rounded-md border border-slate-300 px-2.5 py-1 text-sm has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-800">
                    <input type="checkbox" name="auto_types[]" value="{{ t }}" class="h-3.5 w-3.5"{{ t in ai.auto_types ? ' checked' }}> {{ t|title }}
                  </label>
                {% endfor %}
              </div>
              <p class="{{ note }}">When an entry of a ticked type is published or scheduled without a main image (from the editor or through MCP), the site makes one in this style, from the entry's title and excerpt. An existing picture is never replaced. Posts of the schedules make their own.</p>
            </div>
          {% endif %}
        </div>
        <div class="flex justify-end border-t border-slate-100 px-4 py-3">
          <button type="submit" name="ai_action" value="save_instructions" class="{{ primary }}">Save instructions</button>
        </div>
      </form>

      <div class="space-y-4">
        <div class="{{ card }}" data-ai-test>
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Test picture</h2></div>
          <form method="post" action="{{ url('admin/ai-publishing?tab=instructions') }}" class="space-y-2 px-4 py-3">
            {{ csrf_field() }}
            <label class="{{ label }}" for="ai-test-subject">Subject</label>
            <input id="ai-test-subject" name="subject" class="{{ input }}" placeholder="A cup of coffee on a wooden table by a window.">
            <p class="text-xs text-slate-500">One picture with the saved instructions, so you see the style before using it. Save the instructions first.</p>
            <button type="submit" name="ai_action" value="test_picture" class="{{ secondary }}"{{ ai.has_key ? '' : ' disabled' }}>Make a test picture</button>
          </form>
          {% if tests %}
            <ul class="divide-y divide-slate-100 border-t border-slate-100">
              {% for t in tests %}
                <li class="px-4 py-3 text-sm" data-ai-watch="{{ t.id }}" data-ai-endpoint="{{ url('admin/ai-picture') }}" data-ai-status="{{ t.status }}">
                  <div class="flex items-center justify-between gap-2">
                    <span class="truncate text-slate-700" title="{{ t.subject }}">{{ t.subject }}</span>
                    <span data-ai-badge>{{ ui.status_badge(t.status) }}</span>
                  </div>
                  <div data-ai-variants class="mt-2 grid max-w-md grid-cols-1 gap-2">
                    {% if t.status == 'done' %}{% for i in 0..(t.variants - 1) %}{% if t.variants > 0 %}<a href="{{ url('admin/ai-picture?job=' ~ t.id ~ '&file=' ~ i) }}" target="_blank" rel="noopener"><img src="{{ url('admin/ai-picture?job=' ~ t.id ~ '&file=' ~ i) }}" alt="Test picture" class="w-full rounded border border-slate-200"></a>{% endif %}{% endfor %}{% endif %}
                  </div>
                  <p data-ai-error class="mt-1 text-xs text-red-700">{{ t.status == 'failed' ? t.error }}</p>
                  {% if t.cost is not null %}<p class="mt-1 text-xs text-slate-400">About ${{ money|format(t.cost) }}</p>{% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
        <div class="{{ card }} px-4 py-3 text-xs text-slate-500">
          <p>The writing instructions above and these picture instructions are used by every <a class="font-medium text-blue-700 underline" href="{{ url('admin/ai-publishing?tab=schedules') }}">schedule</a>. A schedule adds a few lines of its own.</p>
        </div>
      </div>
    </div>

  {% elseif tab == 'schedules' %}
    {% set sc = schedules %}
    {% if sc.editing %}
      {% set e = sc.editing %}
      {% set c = e.settings %}
      <form method="post" action="{{ url('admin/ai-publishing?tab=schedules') }}" class="space-y-4" data-ai-schedule-form>
        {{ csrf_field() }}
        <input type="hidden" name="schedule" value="{{ e.id }}">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <a class="text-sm text-slate-500 hover:text-slate-800" href="{{ url('admin/ai-publishing?tab=schedules') }}">‹ All schedules</a>
          <button type="submit" name="ai_action" value="save_schedule" class="{{ primary }}">{{ e.id ? 'Save schedule' : 'Add schedule' }}</button>
        </div>
        <div class="{{ card }}">
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">{{ e.id ? e.name : 'New schedule' }}</h2><span class="text-xs text-slate-400">One post each time it runs</span></div>
          <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class="{{ label }}" for="sc-name">Name</label>
              <input id="sc-name" name="name" value="{{ e.name }}" class="{{ input }}" maxlength="120" placeholder="Tip of the day" required>
            </div>
          </div>
        </div>

        <div class="{{ card }}">
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">When</h2><span class="text-xs text-slate-400">Time zone {{ sc.zone }}</span></div>
          <div class="grid gap-4 px-4 py-4 sm:grid-cols-4">
            <div class="sm:col-span-4">
              <span class="{{ label }}">Days of the week</span>
              <div class="flex flex-wrap gap-1.5">
                {% for n, d in day_names %}
                  <label class="inline-flex cursor-pointer items-center gap-1 rounded-md border border-slate-300 px-2.5 py-1 text-sm has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-800">
                    <input type="checkbox" name="days[]" value="{{ n }}" class="h-3.5 w-3.5"{{ n in c.days ? ' checked' }}> {{ d }}
                  </label>
                {% endfor %}
              </div>
            </div>
            <div>
              <label class="{{ label }}" for="sc-time">Time of day</label>
              <input id="sc-time" type="time" name="time" value="{{ c.time }}" class="{{ input }}" required>
            </div>
            <div>
              <label class="{{ label }}" for="sc-prepare">Write it ahead (minutes)</label>
              <input id="sc-prepare" name="prepare" inputmode="numeric" value="{{ c.prepare }}" class="{{ input }}">
            </div>
            <div>
              <label class="{{ label }}" for="sc-start">From <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="sc-start" type="date" name="start_date" value="{{ c.start_date }}" class="{{ input }}">
            </div>
            <div>
              <label class="{{ label }}" for="sc-end">Until <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="sc-end" type="date" name="end_date" value="{{ c.end_date }}" class="{{ input }}">
            </div>
            <p class="text-xs text-slate-500 sm:col-span-4">The post is written ahead and goes live on the minute. A second post a day is another schedule (Duplicate makes it quick). A run missed by more than {{ sc.missed_window }} minutes (the site or cron was down) is skipped, not made up later.</p>
          </div>
        </div>

        <div class="{{ card }}">
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">What</h2></div>
          <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
            <div>
              <label class="{{ label }}" for="sc-type">Content type</label>
              <select id="sc-type" name="type" class="{{ input }}">{% for t in sc.types %}<option value="{{ t }}"{{ c.type == t ? ' selected' }}>{{ t|title }}</option>{% endfor %}</select>
            </div>
            <div>
              <label class="{{ label }}" for="sc-lang">Language</label>
              <select id="sc-lang" name="lang" class="{{ input }}">{% for l in sc.languages %}<option value="{{ l.code }}"{{ c.lang == l.code ? ' selected' }}>{{ l.name }}</option>{% endfor %}</select>
            </div>
            <div class="sm:col-span-2">
              <label class="{{ label }}" for="sc-content">What the posts are about</label>
              <textarea id="sc-content" name="content" rows="4" class="{{ input }}" maxlength="4000" placeholder="One practical tip for small-business owners about online marketing, 300–400 words." required>{{ c.content }}</textarea>
              <p class="{{ note }}">The topic, the angle, and length or structure if they differ from the writing instructions. Each run is told the titles this schedule wrote before, so it does not repeat them.</p>
            </div>
            <div>
              <label class="{{ label }}" for="sc-text-avoid">Avoid in the text <span class="font-normal text-slate-400">(added to the site's list)</span></label>
              <textarea id="sc-text-avoid" name="text_avoid" rows="2" class="{{ input }}" placeholder="One per line">{{ c.text_avoid|join("\n") }}</textarea>
            </div>
            <div>
              <label class="{{ label }}" for="sc-model">Writing model <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="sc-model" name="model" value="{{ c.model }}" class="{{ input }} font-mono" placeholder="{{ ai.text_model }}" list="sc-models">
              <datalist id="sc-models">{% for m in ai.models.writing %}<option value="{{ m }}">{% endfor %}</datalist>
            </div>
            {% if sc.taxonomies %}
              <div class="sm:col-span-2 space-y-3" data-sc-terms>
                {% for tax, terms in sc.taxonomies %}
                  {% if terms %}
                    <div>
                      <div class="mb-1 flex flex-wrap items-center gap-3">
                        <span class="text-xs font-medium text-slate-600">{{ tax|title }}</span>
                        <label class="inline-flex items-center gap-1 text-xs text-slate-600"><input type="checkbox" name="choose[]" value="{{ tax }}" class="h-3.5 w-3.5"{{ tax in c.choose ? ' checked' }}> Let the model choose from these</label>
                      </div>
                      <div class="flex flex-wrap gap-1.5">
                        {% for t in terms %}
                          <label class="inline-flex cursor-pointer items-center gap-1 rounded-full border border-slate-200 px-2 py-0.5 text-xs has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50">
                            <input type="checkbox" name="terms[{{ tax }}][]" value="{{ t.id }}" class="h-3 w-3"{{ t.id in (c.terms[tax] ?? []) ? ' checked' }}> {{ t.label }}
                          </label>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
                <p class="text-xs text-slate-500">Ticked terms are always given; with "let the model choose", it adds one to three that fit, never a new one. Changed the type? Save first to see its terms.</p>
              </div>
            {% endif %}
          </div>
        </div>

        <div class="{{ card }}" data-sc-material>
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Material</h2><span class="text-xs text-slate-400">Where the facts come from</span></div>
          <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-800"><input type="hidden" name="web_search" value="0"><input type="checkbox" name="web_search" value="1"{{ c.web_search ? ' checked' }}> Search the web while writing</label>
              <p class="{{ note }}">For anything current: news, dates, announcements. The model searches, reads and gives the addresses it used. Each search is billed by OpenAI (counted on the Usage tab). Off, it writes from what it knows, which stops well before today.</p>
            </div>
            <div class="sm:col-span-2">
              <label class="{{ label }}" for="sc-focus">What to search for <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="sc-focus" name="search_focus" value="{{ c.search_focus }}" class="{{ input }}" maxlength="500" placeholder="Official announcements on spatial planning and regional funding in Greece, last week">
            </div>
            <div>
              <label class="{{ label }}" for="sc-feeds">Feeds <span class="font-normal text-slate-400">(RSS or Atom, one per line)</span></label>
              <textarea id="sc-feeds" name="feeds" rows="3" class="{{ input }} font-mono text-xs" placeholder="https://www.example.gr/feed">{{ c.feeds|join("\n") }}</textarea>
              <p class="{{ note }}">Each run takes the newest items this schedule has not used, so an item is written about once.</p>
            </div>
            <div>
              <label class="{{ label }}" for="sc-pages">Pages <span class="font-normal text-slate-400">(read every run, one per line)</span></label>
              <textarea id="sc-pages" name="pages" rows="3" class="{{ input }} font-mono text-xs" placeholder="https://www.example.gr/announcements">{{ c.pages|join("\n") }}</textarea>
              <p class="{{ note }}">An announcements page, a list of events or offers.</p>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="{{ label }}" for="sc-items">Feed items per post</label>
                <input id="sc-items" name="items_per_run" inputmode="numeric" value="{{ c.items_per_run }}" class="{{ input }}">
              </div>
              <div>
                <label class="{{ label }}" for="sc-age">No older than (days)</label>
                <input id="sc-age" name="max_age_days" inputmode="numeric" value="{{ c.max_age_days }}" class="{{ input }}">
              </div>
            </div>
            <label class="inline-flex items-center gap-2 self-end text-sm"><input type="hidden" name="list_sources" value="0"><input type="checkbox" name="list_sources" value="1"{{ c.list_sources ? ' checked' }}> List the sources at the end of the post</label>
            <p class="text-xs text-slate-500 sm:col-span-2">Material from other sites is passed to the model as quoted information, never as instructions. When it cannot write a real post from what it knows, finds and is given, nothing is saved and the run says why.</p>
          </div>
        </div>

        <div class="{{ card }}">
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Picture</h2><span class="text-xs text-slate-400">In the house style of the Instructions tab</span></div>
          <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
            <div>
              <label class="{{ label }}" for="sc-image">What the pictures show</label>
              <textarea id="sc-image" name="image" rows="2" class="{{ input }}" maxlength="1000" placeholder="A single everyday object that stands for the tip.">{{ c.image }}</textarea>
            </div>
            <div>
              <label class="{{ label }}" for="sc-picture-avoid">Avoid in the picture <span class="font-normal text-slate-400">(added to the site's list)</span></label>
              <textarea id="sc-picture-avoid" name="picture_avoid" rows="2" class="{{ input }}" placeholder="One per line">{{ c.picture_avoid|join("\n") }}</textarea>
            </div>
            <label class="inline-flex items-center gap-2 text-sm"><input type="hidden" name="no_picture" value="0"><input type="checkbox" name="no_picture" value="1"{{ c.no_picture ? ' checked' }}> No picture for these posts</label>
            <label class="inline-flex items-center gap-2 text-sm"><input type="hidden" name="picture_required" value="0"><input type="checkbox" name="picture_required" value="1"{{ c.picture_required ? ' checked' }}> Publish only with a picture <span class="text-xs text-slate-400">(if it fails, the post stays a draft)</span></label>
          </div>
        </div>

        <div class="{{ card }}">
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Result</h2></div>
          <div class="grid gap-4 px-4 py-4 sm:grid-cols-2">
            <div class="space-y-1.5">
              {% for value, name in status_modes %}
                <label class="flex items-center gap-2 text-sm"><input type="radio" name="status" value="{{ value }}"{{ c.status == value ? ' checked' }}> {{ name }}</label>
              {% endfor %}
            </div>
            <div>
              <label class="{{ label }}" for="sc-byline">Byline <span class="font-normal text-slate-400">(optional)</span></label>
              <input id="sc-byline" name="byline" value="{{ c.byline }}" class="{{ input }}" maxlength="80" placeholder="{{ ai.byline ?: 'The byline of the writing instructions' }}">
            </div>
          </div>
          <div class="flex justify-end border-t border-slate-100 px-4 py-3">
            <button type="submit" name="ai_action" value="save_schedule" class="{{ primary }}">{{ e.id ? 'Save schedule' : 'Add schedule' }}</button>
          </div>
        </div>
      </form>
    {% elseif sc.view == 'week' and sc.week %}
      {% set w = sc.week %}
      {% set state_names = {'planned': 'Planned', 'off': 'Off', 'due': 'Due', 'working': 'Writing…', 'published': 'Published', 'scheduled': 'Scheduled', 'draft': 'Draft', 'picture': 'Waiting for picture', 'failed': 'Failed', 'missed': 'Missed', 'gone': 'Post deleted'} %}
      {% set state_class = {
        'planned': 'border-blue-200 bg-blue-50 text-blue-900',
        'off': 'border-dashed border-slate-300 bg-white text-slate-500',
        'due': 'border-violet-200 bg-violet-50 text-violet-900',
        'working': 'border-violet-200 bg-violet-50 text-violet-900',
        'published': 'border-emerald-200 bg-emerald-50 text-emerald-900',
        'scheduled': 'border-blue-300 bg-white text-blue-900',
        'draft': 'border-amber-200 bg-amber-50 text-amber-900',
        'picture': 'border-amber-200 bg-amber-50 text-amber-900',
        'failed': 'border-red-200 bg-red-50 text-red-900',
        'missed': 'border-slate-200 bg-slate-100 text-slate-500 line-through',
        'gone': 'border-slate-200 bg-slate-100 text-slate-500'
      } %}
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2" data-ai-week-head>
        <div class="flex items-center gap-2 text-sm">
          <a class="{{ secondary }} px-2 py-1 text-xs" href="{{ url('admin/ai-publishing?tab=schedules&week=' ~ w.prev) }}" aria-label="Previous week">‹</a>
          <strong class="text-slate-900">{{ w.start|date('j M') }} – {{ w.end|date('j M Y') }}</strong>
          <a class="{{ secondary }} px-2 py-1 text-xs" href="{{ url('admin/ai-publishing?tab=schedules&week=' ~ w.next) }}" aria-label="Next week">›</a>
          {% if not w.this_week %}<a class="text-xs font-medium text-blue-700 underline" href="{{ url('admin/ai-publishing?tab=schedules') }}">This week</a>{% endif %}
          <span class="text-xs text-slate-400">Time zone {{ sc.zone }}</span>
        </div>
        <a href="{{ url('admin/ai-publishing?tab=schedules&edit=new') }}" class="{{ primary }}">Add schedule</a>
      </div>
      <div class="{{ card }} overflow-x-auto" data-ai-week>
        <div class="grid min-w-[880px]" style="grid-template-columns: 3.5rem repeat(7, minmax(0, 1fr));">
          <div class="border-b border-slate-200"></div>
          {% for d in w.days %}
            <div class="border-b border-l border-slate-200 px-2 py-2 text-xs font-semibold {{ d.today ? 'bg-blue-50 text-blue-900' : 'text-slate-700' }}"{% if d.today %} aria-current="date"{% endif %}>
              {{ d.label }}{% if d.today %} <span class="font-normal">· today</span>{% endif %}
              <span class="block font-normal text-slate-400">{{ d.runs|length }} post{{ d.runs|length == 1 ? '' : 's' }}</span>
            </div>
          {% endfor %}
          {% for h in w.hours[0]..w.hours[1] %}
            <div class="border-b border-slate-100 px-1.5 py-1 text-right text-[11px] text-slate-400">{{ '%02d'|format(h) }}:00</div>
            {% for d in w.days %}
              {% set here = d.runs|filter(r => r.hour == h) %}
              <div class="group relative min-h-[2.25rem] border-b border-l border-slate-100 p-1 {{ d.today ? 'bg-blue-50/40' : '' }}" data-ai-week-cell="{{ d.date }} {{ '%02d'|format(h) }}">
                {% for r in here %}
                  {% set href = r.entry and r.state in ['published', 'scheduled', 'draft', 'picture'] ? url('admin/edit?type=' ~ (r.entry|split('/')[0]) ~ '&slug=' ~ (r.entry|split('/')[1]) ~ '&lang=' ~ (r.entry|split('/')[2]))
                    : (r.state == 'failed' ? url('admin/ai-publishing?tab=runs&show=failed') : url('admin/ai-publishing?tab=schedules&edit=' ~ r.schedule)) %}
                  <a href="{{ href }}" class="relative z-10 mb-1 block rounded border px-1.5 py-1 text-[11px] leading-tight shadow-sm hover:shadow {{ state_class[r.state] ?? state_class.planned }}" title="{{ r.name }} · {{ r.time }} · {{ state_names[r.state] ?? r.state }}{{ r.title ? ' · ' ~ r.title : '' }}{{ r.error ? ' · ' ~ r.error : '' }}" data-ai-week-run="{{ r.state }}">
                    <span class="font-semibold">{{ r.time }}</span> {{ r.name }}{% if r.manual %} <span class="opacity-70">(run now)</span>{% endif %}
                    <span class="block opacity-80">{{ state_names[r.state] ?? r.state }}{% if r.title %} · {{ r.title }}{% endif %}</span>
                  </a>
                {% endfor %}
                {% set wd = d.date|date('N') %}
                <a href="{{ url('admin/ai-publishing?tab=schedules&edit=new&day=' ~ wd ~ '&time=' ~ '%02d'|format(h) ~ ':00') }}" class="absolute inset-0 z-0 flex items-end justify-end p-1 text-[11px] text-blue-700 opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100" aria-label="Add a schedule on {{ d.label }} at {{ '%02d'|format(h) }}:00"><span class="rounded bg-white/90 px-1">+ Add</span></a>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
      <div class="mt-2 flex flex-wrap items-center gap-2 text-[11px] text-slate-500" data-ai-week-legend>
        {% for key in ['planned', 'off', 'working', 'scheduled', 'published', 'draft', 'failed', 'missed'] %}
          <span class="inline-flex items-center gap-1"><span class="inline-block h-3 w-3 rounded border {{ state_class[key] }}"></span>{{ state_names[key] }}</span>
        {% endfor %}
        <span class="ml-auto">Click an empty hour to add a schedule there.</span>
      </div>
    {% else %}
      <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
        <p class="text-xs text-slate-500">Each schedule writes one post each time it runs, from the writing and picture instructions plus its own lines. The cron job runs them (every 5 minutes, Admin › System).</p>
        <a href="{{ url('admin/ai-publishing?tab=schedules&edit=new') }}" class="{{ primary }}">Add schedule</a>
      </div>
      <div class="{{ card }}" data-ai-schedules>
        {% if sc.list is empty %}
          <p class="px-4 py-6 text-center text-sm text-slate-500">No schedules yet. Add one: a name, the days and time, and a few lines about what the posts are about.</p>
        {% else %}
          <ul class="divide-y divide-slate-100">
            {% for s in sc.list %}
              <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3" data-ai-schedule="{{ s.id }}">
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <a href="{{ url('admin/ai-publishing?tab=schedules&edit=' ~ s.id) }}" class="font-medium text-slate-900 hover:text-blue-700">{{ s.name }}</a>
                    {{ s.enabled ? ui.badge('On', 'green') : ui.badge('Off', 'slate') }}
                    {% if s.last_status == 'failed' %}<span title="{{ s.last_error }}">{{ ui.badge('Last run failed', 'red') }}</span>{% endif %}
                  </div>
                  <p class="mt-0.5 text-xs text-slate-500">
                    {% for n, d in day_names %}{% if n in s.settings.days %}{{ d }} {% endif %}{% endfor %}· {{ s.settings.time }} · {{ s.settings.type }} {{ s.settings.lang|upper }}
                    · {{ status_modes[s.settings.status] }}{{ s.settings.no_picture ? ' · no picture' : '' }}{{ s.settings.web_search ? ' · web search' : '' }}{{ s.settings.feeds ? ' · ' ~ s.settings.feeds|length ~ ' feed' ~ (s.settings.feeds|length == 1 ? '' : 's') : '' }}{{ s.settings.pages ? ' · ' ~ s.settings.pages|length ~ ' page' ~ (s.settings.pages|length == 1 ? '' : 's') : '' }}
                  </p>
                  <p class="text-xs text-slate-500">
                    {{ s.next ? 'Next: ' ~ s.next : (s.enabled ? 'No run ahead (dates)' : 'Switched off') }}
                    {% if s.last and s.last.title %} · Last: <a class="underline" href="{{ url('admin/edit?type=' ~ (s.last.entry|split('/')[0]) ~ '&slug=' ~ (s.last.entry|split('/')[1]) ~ '&lang=' ~ (s.last.entry|split('/')[2])) }}">{{ s.last.title }}</a>{% endif %}
                    · {{ s.month_posts }} this month
                  </p>
                </div>
                <form method="post" action="{{ url('admin/ai-publishing?tab=schedules') }}" class="flex flex-wrap items-center gap-1.5">
                  {{ csrf_field() }}<input type="hidden" name="schedule" value="{{ s.id }}">
                  <button type="submit" name="ai_action" value="schedule_run" class="{{ secondary }} py-1 text-xs" data-confirm="Write a post for “{{ s.name }}” now? It gets the schedule's usual status." data-confirm-button="Write it now"{{ ai.has_key ? '' : ' disabled' }}>Run now</button>
                  <button type="submit" name="ai_action" value="schedule_toggle" class="{{ secondary }} py-1 text-xs">{{ s.enabled ? 'Switch off' : 'Switch on' }}</button>
                  <button type="submit" name="ai_action" value="schedule_duplicate" class="{{ secondary }} py-1 text-xs">Duplicate</button>
                  <button type="submit" name="ai_action" value="schedule_delete" class="{{ secondary }} py-1 text-xs text-red-700" data-confirm="Delete “{{ s.name }}”? The posts it wrote stay." data-confirm-button="Delete">Delete</button>
                </form>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}

  {% elseif tab == 'runs' %}
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <nav class="flex gap-1 text-xs" aria-label="Show">
        {% for key, name in {'': 'All', 'live': 'Waiting and working', 'failed': 'Failed'} %}
          <a href="{{ url('admin/ai-publishing?tab=runs' ~ (key ? '&show=' ~ key : '')) }}" class="rounded-md px-2.5 py-1 font-medium {{ show == key ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' }}">{{ name }}</a>
        {% endfor %}
      </nav>
      {% if runs.waiting %}
        <form method="post" action="{{ url('admin/ai-publishing?tab=runs') }}">
          {{ csrf_field() }}
          <button type="submit" name="ai_action" value="cancel_waiting" class="{{ secondary }} py-1 text-xs" data-confirm="Cancel every picture that is still waiting? Pictures being made now finish." data-confirm-button="Cancel them">Cancel the {{ runs.waiting }} waiting</button>
        </form>
      {% endif %}
    </div>
    {% set live_rows = runs.rows|filter(r => r.status in ['queued', 'running'])|length %}
    <div class="{{ card }}" data-ai-runs{% if live_rows %} data-ai-runs-live="{{ live_rows }}" data-ai-endpoint="{{ url('admin/ai-picture') }}"{% endif %}>
      {% if live_rows %}<p class="border-b border-violet-100 bg-violet-50 px-4 py-2 text-sm text-violet-900" role="status" aria-live="polite" data-ai-runs-line>Working: {{ live_rows }} waiting. Keep this page open, or the cron job finishes them.</p>{% endif %}
      {% if runs.rows is empty %}
        <p class="px-4 py-3 text-sm text-slate-500">No pictures yet{{ show ? ' with this status' : '' }}.</p>
      {% else %}
        <div class="overflow-x-auto">
          <table class="w-full min-w-[720px] text-sm">
            <thead><tr class="border-b border-slate-100 text-left text-xs text-slate-500">
              <th class="px-4 py-2 font-medium">When</th><th class="px-2 font-medium">From</th><th class="px-2 font-medium">Entry and subject</th><th class="px-2 font-medium">Result</th><th class="px-2 text-right font-medium">Cost</th><th class="px-4"></th>
            </tr></thead>
            <tbody class="divide-y divide-slate-50">
              {% for r in runs.rows %}
                <tr data-ai-run="{{ r.id }}">
                  <td class="whitespace-nowrap px-4 py-2 text-xs text-slate-500">{{ r.created|date('j M H:i') }}</td>
                  <td class="px-2 text-xs">{{ r.kind == 'post' ? 'Post' : 'Picture' }} · {{ {'editor': 'Editor', 'test': 'Test', 'bulk': 'Bulk', 'schedule': 'Schedule', 'mcp': 'MCP', 'automatic': 'Automatic'}[r.source] ?? r.source }}{% if r.by %}<span class="block text-slate-400">{{ r.by }}</span>{% endif %}</td>
                  <td class="max-w-md px-2 py-2">
                    {% if r.slug %}<a class="font-medium text-slate-800 hover:text-blue-700" href="{{ url('admin/edit?type=' ~ r.type ~ '&slug=' ~ r.slug ~ '&lang=' ~ r.lang) }}">{{ r.type }}/{{ r.slug }} <span class="text-xs text-slate-400">{{ r.lang|upper }}</span></a>{% endif %}
                    {% if r.subject %}<span class="block truncate text-xs text-slate-500" title="{{ r.subject }}">{{ r.subject }}</span>{% endif %}
                  </td>
                  <td class="px-2 py-2 text-xs">
                    {{ ui.status_badge(r.status) }}
                    {% if r.kind == 'post' and r.status == 'done' %}<span class="text-slate-500">{{ r.post_status == 'scheduled' ? 'goes live ' ~ r.publish_at : r.post_status }}{{ r.searches ? ' · ' ~ r.searches ~ ' search' ~ (r.searches == 1 ? '' : 'es') : '' }}{{ r.sources ? ' · ' ~ r.sources ~ ' source' ~ (r.sources == 1 ? '' : 's') : '' }}</span>
                    {% elseif r.status == 'done' and r.outcome == 'set' %}<span class="text-slate-500">set as main image</span>
                    {% elseif r.status == 'done' and r.outcome == 'kept' %}<span class="text-slate-500">in the library (it had a main image by then)</span>
                    {% elseif r.status == 'done' and r.pictures %}<span class="text-slate-500">{{ r.pictures }} picture{{ r.pictures == 1 ? '' : 's' }}</span>{% endif %}
                    {% if r.status == 'queued' and r.wait %}<span class="text-slate-500">tries again in {{ (r.wait / 60)|round(0, 'ceil') }} min</span>{% endif %}
                    {% if r.error %}<span class="mt-0.5 block {{ r.status == 'failed' ? 'text-red-700' : 'text-slate-500' }}">{{ r.error }}</span>{% endif %}
                    {% if r.status == 'failed' and (r.queries or r.pages or r.similar) %}
                      <details class="mt-1 text-slate-500" data-ai-run-details>
                        <summary class="cursor-pointer">What it looked at{{ r.searches ? ' (' ~ r.searches ~ ' search' ~ (r.searches == 1 ? '' : 'es') ~ ')' : '' }}</summary>
                        {% if r.queries %}<p class="mt-1"><span class="font-medium text-slate-600">Searched for:</span> {{ r.queries|join(' · ') }}</p>{% endif %}
                        {% if r.pages %}<ul class="mt-1 list-disc pl-4">{% for u in r.pages %}<li class="truncate"><a class="underline" href="{{ u }}" target="_blank" rel="noopener noreferrer">{{ u }}</a></li>{% endfor %}</ul>{% endif %}
                        {% if r.similar %}{% set sp = r.similar|split('/') %}<p class="mt-1"><span class="font-medium text-slate-600">Similar post:</span> <a class="underline" href="{{ url('admin/edit?type=' ~ sp[0] ~ '&slug=' ~ sp[1] ~ '&lang=' ~ sp[2]) }}">{{ r.similar }}</a></p>{% endif %}
                      </details>
                    {% endif %}
                  </td>
                  <td class="whitespace-nowrap px-2 text-right text-xs">{{ r.cost is not null ? '$' ~ money|format(r.cost) : '' }}</td>
                  <td class="whitespace-nowrap px-4 text-right">
                    {% if r.status in ['failed', 'cancelled'] %}
                      <form method="post" action="{{ url('admin/ai-publishing?tab=runs') }}" class="inline">{{ csrf_field() }}<input type="hidden" name="job" value="{{ r.id }}"><button type="submit" name="ai_action" value="retry_job" class="{{ secondary }} py-0.5 text-xs">Retry</button></form>
                    {% elseif r.status == 'queued' %}
                      <form method="post" action="{{ url('admin/ai-publishing?tab=runs') }}" class="inline">{{ csrf_field() }}<input type="hidden" name="job" value="{{ r.id }}"><button type="submit" name="ai_action" value="cancel_job" class="{{ secondary }} py-0.5 text-xs">Cancel</button></form>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
    <p class="mt-2 text-xs text-slate-500">The last 100. A failed picture costs nothing unless OpenAI made it; every call, failed or not, is on the Usage tab.</p>

  {% elseif tab == 'settings' %}
    {% if not can_settings %}
      <p class="rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-700">The key, models, limits and prices are changed by people who may change the site settings.</p>
    {% else %}
    <form method="post" action="{{ url('admin/ai-publishing?tab=settings') }}" class="space-y-4" autocomplete="off" data-ai-settings>
      {{ csrf_field() }}
      <div class="grid gap-4 lg:grid-cols-3">
        <div class="{{ card }} lg:col-span-2">
          <div class="{{ card_head }}">
            <h2 class="text-sm font-semibold text-slate-900">OpenAI</h2>
            {{ ai.has_key ? ui.badge('Key ' ~ ai.key_hint, 'green') : ui.badge('No key', 'slate') }}
          </div>
          <div class="space-y-4 px-4 py-4">
            <div>
              <label class="{{ label }}" for="ai-key">API key</label>
              <input id="ai-key" type="password" name="openai_key" class="{{ input }} font-mono" placeholder="{{ ai.has_key ? 'Kept. Paste a new key to replace it.' : 'sk-…' }}" autocomplete="new-password" spellcheck="false">
              <p class="{{ note }}">Kept on this server only: never shown again, exported or logged. {% if ai.has_key %}<label class="ml-2 inline-flex items-center gap-1"><input type="checkbox" name="clear_key" value="1"> Remove the key</label>{% endif %}</p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <div>
                <label class="{{ label }}" for="ai-image-model">Picture model</label>
                {% if ai.models.pictures %}
                  <select id="ai-image-model" name="image_model" class="{{ input }}">
                    {% if ai.image_model not in ai.models.pictures %}<option value="{{ ai.image_model }}" selected>{{ ai.image_model }} (not offered to this key)</option>{% endif %}
                    {% for m in ai.models.pictures %}<option value="{{ m }}"{{ ai.image_model == m ? ' selected' }}>{{ m }}</option>{% endfor %}
                  </select>
                {% else %}
                  <input id="ai-image-model" name="image_model" value="{{ ai.image_model }}" class="{{ input }} font-mono">
                {% endif %}
              </div>
              <div>
                <label class="{{ label }}" for="ai-text-model">Writing model <span class="font-normal text-slate-400">(used from phase 3)</span></label>
                {% if ai.models.writing %}
                  <select id="ai-text-model" name="text_model" class="{{ input }}">
                    {% if ai.text_model not in ai.models.writing %}<option value="{{ ai.text_model }}" selected>{{ ai.text_model }} (not offered to this key)</option>{% endif %}
                    {% for m in ai.models.writing %}<option value="{{ m }}"{{ ai.text_model == m ? ' selected' }}>{{ m }}</option>{% endfor %}
                  </select>
                {% else %}
                  <input id="ai-text-model" name="text_model" value="{{ ai.text_model }}" class="{{ input }} font-mono">
                {% endif %}
              </div>
            </div>
            <p class="text-xs text-slate-500">{% if ai.models.checked_at %}The lists are the models this key can use, read {{ ai.models.checked_at|date('j M Y, H:i') }}. {% endif %}<em>Check key</em> reads them again; model names change often.</p>
          </div>
          <div class="flex flex-wrap justify-end gap-2 border-t border-slate-100 px-4 py-3">
            {% if ai.has_key %}<button type="submit" name="ai_action" value="check_key" class="{{ secondary }}">Check key</button>{% endif %}
            <button type="submit" name="ai_action" value="save_settings" class="{{ primary }}">Save settings</button>
          </div>
        </div>

        <details class="{{ card }} px-4 py-3 text-sm text-slate-700" {{ ai.has_key ? '' : 'open' }}>
          <summary class="cursor-pointer font-semibold text-slate-900">Getting an OpenAI key</summary>
          <ol class="mt-2 list-decimal space-y-1.5 pl-5 text-xs">
            <li>Sign in at <a class="text-blue-700 underline" href="https://platform.openai.com" target="_blank" rel="noopener">platform.openai.com</a>.</li>
            <li><em>Settings › Billing</em>: add a payment method and some credit. The API is billed apart from a ChatGPT subscription.</li>
            <li><em>Settings › Organization › General</em>: <strong>verify the organization</strong>. Picture models need it; it takes a few minutes with an ID.</li>
            <li>Make a project named after this site, with a monthly budget, and in it <strong>create a new secret key</strong> (or a service account key). Copy it at once: it is shown once.</li>
            <li>Paste it here, save, and the site checks it.</li>
          </ol>
          <p class="mt-2 text-xs text-slate-500">Set a spending limit at OpenAI too, apart from the caps here. Never paste the key in a chat or a screenshot.</p>
        </details>
      </div>

      <div class="{{ card }}">
        <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">Limits</h2></div>
        <div class="grid gap-3 px-4 py-4 sm:grid-cols-4">
          <div>
            <label class="{{ label }}" for="ai-cost-cap">Monthly cap, estimated (US $)</label>
            <input id="ai-cost-cap" name="monthly_cost_cap" inputmode="decimal" value="{{ ai.monthly_cost_cap }}" class="{{ input }}" placeholder="No cap">
          </div>
          <div>
            <label class="{{ label }}" for="ai-picture-cap">Monthly cap, pictures</label>
            <input id="ai-picture-cap" name="monthly_picture_cap" inputmode="numeric" value="{{ ai.monthly_picture_cap }}" class="{{ input }}" placeholder="No cap">
          </div>
          <div>
            <span class="{{ label }}">At the cap</span>
            <label class="mr-3 inline-flex items-center gap-1 text-sm"><input type="radio" name="cap_action" value="pause"{{ ai.cap_action == 'pause' ? ' checked' }}> Stop</label>
            <label class="inline-flex items-center gap-1 text-sm"><input type="radio" name="cap_action" value="warn"{{ ai.cap_action == 'warn' ? ' checked' }}> Warn only</label>
          </div>
          <div>
            <label class="{{ label }}" for="ai-keep">Keep run logs (days)</label>
            <input id="ai-keep" name="keep_logs_days" inputmode="numeric" value="{{ ai.keep_logs_days }}" class="{{ input }}">
          </div>
        </div>
      </div>

      <div class="{{ card }}">
        <div class="{{ card_head }}">
          <h2 class="text-sm font-semibold text-slate-900">Prices</h2>
          <span class="text-xs text-slate-400">{{ ai.prices_checked ? 'Checked ' ~ ai.prices_checked|date('j M Y') : 'Not checked yet' }}</span>
        </div>
        <div class="overflow-x-auto px-4 py-3">
          <p class="mb-2 text-xs text-slate-500">US dollars per million tokens (web search: per call), from <a class="text-blue-700 underline" href="https://openai.com/api/pricing" target="_blank" rel="noopener">OpenAI's pricing page</a>. They turn the exact token counts into an estimate. A model with an empty price is counted in tokens and shown as "price unknown". Changing a price never changes what was already counted.</p>
          <table class="w-full min-w-[720px] text-sm">
            <thead><tr class="text-left text-xs text-slate-500">
              <th class="py-1 pr-2 font-medium">Model</th><th class="px-1 font-medium">Text in</th><th class="px-1 font-medium">Cached in</th><th class="px-1 font-medium">Text out</th><th class="px-1 font-medium">Image in</th><th class="px-1 font-medium">Image out</th><th class="px-1 font-medium">Search</th>
            </tr></thead>
            <tbody>
              {% set rows = ai.prices|merge({'': {}}) %}
              {% set i = 0 %}
              {% for model, row in rows %}
                <tr>
                  <td class="py-1 pr-2"><input name="prices[{{ i }}][model]" value="{{ model }}" class="{{ input }} font-mono text-xs" placeholder="model name"></td>
                  {% for f in price_fields %}<td class="px-1"><input name="prices[{{ i }}][{{ f }}]" value="{{ row[f] ?? '' }}" inputmode="decimal" class="{{ input }} text-xs"></td>{% endfor %}
                </tr>
                {% set i = i + 1 %}
              {% endfor %}
            </tbody>
          </table>
          <label class="mt-2 inline-flex items-center gap-1 text-xs text-slate-600"><input type="checkbox" name="prices_checked" value="1"> I checked these prices against OpenAI's page today</label>
        </div>
        <div class="flex justify-end border-t border-slate-100 px-4 py-3">
          <button type="submit" name="ai_action" value="save_settings" class="{{ primary }}">Save settings</button>
        </div>
      </div>
    </form>
    {% endif %}

  {% elseif tab == 'usage' %}
    {% set u = usage %}
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2 text-sm">
        <a class="{{ secondary }} py-1 text-xs" href="{{ url('admin/ai-publishing?tab=usage&month=' ~ u.previous_month) }}">‹</a>
        <strong class="text-slate-900">{{ u.month_label }}</strong>
        {% if u.next_month %}<a class="{{ secondary }} py-1 text-xs" href="{{ url('admin/ai-publishing?tab=usage&month=' ~ u.next_month) }}">›</a>{% endif %}
      </div>
      <a class="{{ secondary }} py-1 text-xs" href="{{ url('admin/ai-publishing?tab=usage&export=csv&month=' ~ u.month) }}">Export CSV</a>
    </div>
    <div class="mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-ai-usage>
      {% set t = u.total %}
      <div class="{{ card }} px-4 py-3"><p class="text-xs text-slate-500">Estimated cost</p><p class="text-xl font-semibold text-slate-900">${{ money|format(t.cost ?? 0) }}</p>
        <p class="text-xs text-slate-400">Last month ${{ money|format(u.previous.cost ?? 0) }}{% if u.forecast is not null %} · month end about ${{ '%.2f'|format(u.forecast) }}{% endif %}</p></div>
      <div class="{{ card }} px-4 py-3"><p class="text-xs text-slate-500">Tokens</p><p class="text-xl font-semibold text-slate-900">{{ (t.tokens ?? 0)|number_format }}</p>
        <p class="text-xs text-slate-400">{{ (t.text_input ?? 0)|number_format }} text in · {{ (t.image_output ?? 0)|number_format }} image out</p></div>
      <div class="{{ card }} px-4 py-3"><p class="text-xs text-slate-500">Pictures made</p><p class="text-xl font-semibold text-slate-900">{{ t.pictures ?? 0 }}</p>
        <p class="text-xs text-slate-400">{{ t.calls ?? 0 }} calls{% if t.failed %} · {{ t.failed }} failed{% endif %}</p></div>
      <div class="{{ card }} px-4 py-3"><p class="text-xs text-slate-500">Caps</p>
        <p class="text-sm text-slate-800">{{ ai.monthly_cost_cap is not null ? '$' ~ ai.monthly_cost_cap : 'No cost cap' }} · {{ ai.monthly_picture_cap ?? 'no' }} picture cap</p>
        <p class="text-xs text-slate-400">At the cap: {{ ai.cap_action == 'pause' ? 'stop' : 'warn only' }}</p></div>
    </div>
    {% if t and t.unknown %}<p class="mb-3 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">{{ t.unknown }} call{{ t.unknown == 1 ? '' : 's' }} used a model without a price, so the cost above leaves {{ t.unknown == 1 ? 'it' : 'them' }} out. Add the price on the Settings tab.</p>{% endif %}
    <p class="mb-4 text-xs text-slate-500">Token counts are exact, as OpenAI returns them; the cost is an estimate from the price table. The bill is OpenAI's.</p>

    <div class="grid gap-4 lg:grid-cols-2">
      <div class="{{ card }}">
        <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">By day</h2></div>
        {% if u.by_day %}
          <ul class="space-y-1 px-4 py-3 text-xs">
            {% for d in u.by_day %}
              <li class="flex items-center gap-2"><span class="w-20 shrink-0 text-slate-500">{{ d.label|date('D j M') }}</span>
                <span class="h-2 rounded bg-blue-500" style="width: {{ max(d.share, 1) }}%"></span>
                <span class="shrink-0 text-slate-700">${{ money|format(d.cost) }}</span></li>
            {% endfor %}
          </ul>
        {% else %}<p class="px-4 py-3 text-sm text-slate-500">Nothing this month.</p>{% endif %}
      </div>
      {% for group in [['By source', u.by_source, {'editor': 'Editor', 'test': 'Test pictures', 'bulk': 'Bulk', 'schedule': 'Schedules', 'mcp': 'MCP', 'automatic': 'Automatic', 'preview': 'Preview', 'check': 'Checks'}], ['By kind', u.by_kind, {'picture': 'Pictures', 'writing': 'Writing', 'search': 'Web search'}], ['By model', u.by_model, {}]] %}
        <div class="{{ card }}">
          <div class="{{ card_head }}"><h2 class="text-sm font-semibold text-slate-900">{{ group[0] }}</h2></div>
          {% if group[1] %}
            <table class="w-full text-sm">
              <thead><tr class="text-left text-xs text-slate-500"><th class="px-4 py-1.5 font-medium">{{ group[0]|replace({'By ': ''})|capitalize }}</th><th class="px-2 font-medium">Calls</th><th class="px-2 font-medium">Tokens</th><th class="px-4 text-right font-medium">Estimated</th></tr></thead>
              <tbody class="divide-y divide-slate-50">
                {% for r in group[1] %}
                  <tr><td class="px-4 py-1.5 {{ group[2] ? '' : 'font-mono text-xs' }}">{{ group[2][r.label] ?? r.label }}</td><td class="px-2">{{ r.calls }}</td><td class="px-2">{{ r.tokens|number_format }}</td>
                    <td class="px-4 text-right">${{ money|format(r.cost) }}{% if r.unknown %} <span class="text-xs text-amber-700">+ {{ r.unknown }} unknown</span>{% endif %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          {% else %}<p class="px-4 py-3 text-sm text-slate-500">Nothing this month.</p>{% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}

  <script src="{{ asset('js/admin-ai-picture.js') }}" defer></script>
{% endblock %}
