{% extends '@admin/base.twig' %}
{% set page_heading = 'Files' %}
{% import '@admin/partials/ui.twig' as ui %}
{#
  Shop > Files (docs/shop-plan.md, section 6): an overview of the private files the digital products sell, and how each has done. They are
  uploaded and removed in the Downloads card of their product, which each row links to.
#}
{% macro bytes(n) %}{{ n < 1048576 ? (max(1, n / 1024)|number_format(0) ~ ' KB') : ((n / 1048576)|number_format(1) ~ ' MB') }}{% endmacro %}
{% block content %}
  {% import _self as m %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {% set th = 'px-3 py-2 text-left text-xs font-medium text-slate-500' %}
  {% set num = 'px-3 py-2 text-right text-xs font-medium text-slate-500' %}

  <dl class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
    {% for stat in [
      {label: 'Files', value: totals.files},
      {label: 'Total size', value: m.bytes(totals.bytes)},
      {label: 'Orders with a link', value: totals.links},
      {label: 'Downloads', value: totals.downloads}
    ] %}
      <div class="{{ card }} px-4 py-3"><dt class="text-xs text-slate-500">{{ stat.label }}</dt><dd class="m-0 mt-0.5 text-lg font-semibold text-slate-900">{{ stat.value }}</dd></div>
    {% endfor %}
  </dl>

  {% if empty_products is not empty %}
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <p class="m-0 font-medium">No file yet: an order of these would get nothing to download.</p>
      <ul class="mb-0 mt-1 flex flex-wrap gap-x-4 gap-y-1 p-0">
        {% for p in empty_products %}<li class="list-none"><a class="underline" href="{{ url(p.url) }}">{{ p.title }}</a></li>{% endfor %}
      </ul>
    </div>
  {% endif %}

  {% if files is empty %}
    <div class="{{ card }}">{{ ui.empty_state('No files yet', 'Set a product\'s Kind to Digital product and upload its files in the product\'s Downloads card.') }}</div>
  {% else %}
    <div class="{{ card }} overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-slate-200">
          <tr><th class="{{ th }}">File</th><th class="{{ th }}">Product</th><th class="{{ num }}">Size</th><th class="{{ th }}">Uploaded</th><th class="{{ num }}">Orders</th><th class="{{ num }}">Downloads</th><th class="{{ th }}">Last downloaded</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {% for f in files %}
            <tr>
              <td class="max-w-[16rem] truncate px-3 py-2 font-medium text-slate-800" title="{{ f.name }}">{{ f.name }}</td>
              <td class="px-3 py-2">
                {% if f.url %}<a class="text-blue-700 hover:underline" href="{{ url(f.url) }}">{{ f.title }}</a>{% else %}<span class="text-slate-400">Product deleted</span>{% endif %}
                {% if f.url and not f.digital %}<span class="ml-1 text-xs text-amber-700">not digital now</span>{% endif %}
              </td>
              <td class="whitespace-nowrap px-3 py-2 text-right text-slate-600">{{ m.bytes(f.size) }}</td>
              <td class="whitespace-nowrap px-3 py-2 text-slate-600">{{ f.created_at|date('d/m/Y') }}</td>
              <td class="px-3 py-2 text-right text-slate-600">{{ f.links }}</td>
              <td class="px-3 py-2 text-right text-slate-600">{{ f.downloads }}</td>
              <td class="whitespace-nowrap px-3 py-2 text-slate-600">{{ f.last_at ? f.last_at|date('d/m/Y H:i') : '–' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
{% endblock %}
