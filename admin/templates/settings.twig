{% extends '@admin/base.twig' %}
{% set page_heading = 'Settings' %}

{% block content %}
  {% set panel_class = 'section-panel space-y-4' %}
  {% set section_class = 'rounded-lg border border-slate-200 bg-white p-4' %}
  {% set section_header_class = 'mb-3' %}
  {% set secondary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50' %}
  {% set primary_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700' %}
  {% set danger_button_class = 'inline-flex shrink-0 items-center gap-1.5 rounded-md border border-red-200 bg-white px-3 py-1.5 text-sm font-medium text-red-600 shadow-sm transition hover:bg-red-50' %}


  {% import '@admin/partials/secret-input.twig' as local %}
  {% import '@admin/partials/ui.twig' as ui %}
  {% import '@admin/partials/fields.twig' as fields %}
  {% import '@admin/partials/settings-sidebar.twig' as settings_sidebar %}

  {% if saved %}
    {{ ui.flash('Saved.', 'success') }}
  {% endif %}
  {% if test_status == 'ok' %}
    {{ ui.flash('Test email sent.', 'success') }}
  {% elseif test_status == 'fail' %}
    {{ ui.flash('Test email failed. Check your SMTP/SES settings.', 'error') }}
  {% elseif test_status == 'missing' %}
    {{ ui.flash('Please enter a test recipient email.', 'error') }}
  {% endif %}
  {% if settings_error %}
    {{ ui.flash(settings_error, 'error') }}
  {% endif %}
  {% if storage_measured and storage.used_human is defined %}
    {{ ui.flash('Storage measured again: ' ~ storage.used_human ~ ' used.', 'success') }}
  {% endif %}

  <form method="post" class="space-y-4">
    {{ csrf_field() }}
    <input type="hidden" name="active_tab" value="{{ active_tab }}" data-active-tab-input>

    <div class="flex flex-col gap-3 border-b border-slate-200 pb-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <p class="truncate text-xs text-slate-400">Configure your GnozioCMS installation</p>
      </div>
    </div>

    <div class="section-layout">
      {{ settings_sidebar.nav(active_tab, true) }}
      <div class="section-body">

      {% if can('limits.manage') %}
      <div class="{{ panel_class }}{% if active_tab != 'limits' %} hidden{% else %} active{% endif %}" data-panel="limits">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Storage</h2>
            <p class="mt-0.5 text-xs text-slate-400">How much space this site may use. Only a super admin sees this. The bar in the sidebar and on the dashboard follows it: orange from 80%, red from 90%, when everyone in the admin is shown a message, and at 100% new uploads are blocked.</p>
          </div>
          {% set limit_mb = settings_form.storage_limit_mb %}
          {% set as_gb = limit_mb >= 1024 and limit_mb % 1024 == 0 %}
          <div class="set-rows">
            <div>
              <label for="storage-limit">Storage limit</label>
              <span class="set-inline">
                <input id="storage-limit" type="number" name="storage_limit_value" value="{{ as_gb ? limit_mb // 1024 : limit_mb }}" min="0" step="any" class="{{ input_class }}" aria-describedby="storage-limit-help">
                <select name="storage_limit_unit" class="{{ select_class }}" aria-label="Unit">
                  <option value="mb"{% if not as_gb %} selected{% endif %}>MB</option>
                  <option value="gb"{% if as_gb %} selected{% endif %}>GB</option>
                </select>
              </span>
              <p id="storage-limit-help">The default is 1 GB. Enter 0 for no limit. What counts: uploads {{ storage.parts.uploads }}, content {{ storage.parts.content }}, files sent through forms {{ storage.parts.forms }}, and the system database and backups {{ storage.parts.system }}.</p>
            </div>
            <div>
              <span>Used now</span>
              <strong class="pt-1 text-xs font-medium {{ storage.level == 'danger' ? 'text-red-700' : (storage.level == 'warn' ? 'text-orange-700' : 'text-slate-800') }}">{{ storage.used_human }}{% if storage.limit %} of {{ storage.limit_human }} ({{ storage.percent_of_limit }}%){% endif %}</strong>
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1" id="storage-measured">
                <span>Measured {{ storage.measured_at|date('Y-m-d H:i') }}. Measured again automatically every 12 hours; uploads and deletions in Media count at once.</span>
                <button type="submit" form="storage-recalculate" class="font-medium text-slate-600 underline hover:text-slate-900">Recalculate now</button>
              </p>
            </div>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">File uploads</h2>
            <p class="mt-0.5 text-xs text-slate-400">What can be added to the media library (and as a main image while editing). A file that is too big or of a kind that is not ticked is refused with the reason.</p>
          </div>
          <div class="set-rows">
            <div>
              <label for="upload-limit">Largest file (MB)</label>
              <input id="upload-limit" type="number" name="upload_limit_mb" value="{{ settings_form.upload_limit_mb }}" min="0" step="1" class="{{ input_class }}" aria-describedby="upload-limit-help">
            <p id="upload-limit-help">The default is 20 MB. Enter 0 to allow what the server allows.{% if server_upload_mb %} This server takes at most <strong class="font-semibold text-slate-600">{{ server_upload_mb }} MB</strong> in one upload (PHP <code class="rounded bg-slate-100 px-1 py-0.5">upload_max_filesize</code> and <code class="rounded bg-slate-100 px-1 py-0.5">post_max_size</code>), so a higher number here does not go beyond that.{% endif %}</p>
            </div>
            <div role="group" aria-labelledby="upload-types-label">
              <span id="upload-types-label">Kinds of file allowed</span>
              <input type="hidden" name="upload_types_present" value="1">
              <div class="set-options">
                {% for key, group in upload_groups %}
                  <label>
                    <input type="checkbox" name="upload_types[]" value="{{ key }}" {% if key in settings_form.upload_types %}checked{% endif %} class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
                    <span><strong>{{ group.label }}</strong><small>{{ group.help }}</small></span>
                  </label>
                {% endfor %}
              </div>
              <p>Only harmless kinds of file can be allowed at all: programs, scripts, and web pages are never accepted, whatever is ticked. At least one kind stays ticked.</p>
            </div>
          </div>
        </div>
      </div>
      {% endif %}

      <div class="{{ panel_class }}{% if active_tab != 'basics' %} hidden{% else %} active{% endif %}" data-panel="basics">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Site Identity</h2>
            <p class="mt-0.5 text-xs text-slate-400">Basic information used across the public site and admin.</p>
          </div>
          <div class="set-rows">
            <label class="block">
              <span>Site name</span>
              <input type="text" name="title" value="{{ settings_form.title }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Tagline</span>
              <input type="text" name="tagline" value="{{ settings_form.tagline }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Base URL</span>
              <input type="text" name="base_url" value="{{ settings_form.base_url }}" placeholder="https://example.com" class="{{ input_class }}">
              <span class="block">Links in emails, payment returns and downloads are built from this address only. The shop's card payments and customer accounts need it.</span>
            </label>
            <label class="block">
              <span>Home page</span>
              <input type="text" name="home_page" value="{{ settings_form.home_page }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Trusted proxies</span>
              <textarea name="trusted_proxies" rows="2" placeholder="127.0.0.1" class="{{ input_class }} font-mono text-sm">{{ settings_form.trusted_proxies }}</textarea>
              <span class="block">Addresses or ranges (10.0.0.0/8) of the proxies in front of the site, one per line: Varnish, nginx, cloudflared. Only requests from them may say who the visitor is (X-Forwarded-For) and whether the visit is on HTTPS. 127.0.0.1 and ::1 (this machine) are listed until the list is changed; empty it when nothing stands in front, so no header is believed.</span>
            </label>
            <label class="block">
              <span>Sign out after (minutes without use)</span>
              <input type="number" name="admin_idle_minutes" value="{{ settings_form.admin_idle_minutes }}" min="10" max="1440" step="1" class="{{ input_class }}">
              <span class="block">An admin session ends after this long without use (10 to 1440), and 24 hours after signing in in any case.</span>
            </label>
            <input type="hidden" name="hsts_shown" value="1">
            <label class="flex">
              <input type="checkbox" name="hsts" value="1" {% if settings_form.hsts %}checked{% endif %}>
              <span><span class="font-medium">Always use HTTPS (HSTS)</span>
                <span class="block text-xs text-slate-500">Browsers that have visited the site ask for it only over HTTPS for a year. Turn it on only when the whole site, and every address it answers on, works over HTTPS.</span></span>
            </label>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Localization</h2>
            <p class="mt-0.5 text-xs text-slate-400">Default language, available locales, date formatting and the time zone of publishing times.</p>
          </div>
          <div class="set-rows">
            <label class="block">
              <span>Default language</span>
              <input type="text" name="languages_default" value="{{ settings_form.languages_default }}" placeholder="el" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Available languages</span>
              <input type="text" name="languages_available" value="{{ settings_form.languages_available }}" placeholder="el, en" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Date format</span>
              <input type="text" name="date_format" value="{{ settings_form.date_format }}" placeholder="d/m/Y" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Time zone</span>
              <select name="timezone" class="{{ input_class }}">
                <option value="">The server's ({{ server_timezone }})</option>
                {% for zone in timezones %}<option value="{{ zone }}" {% if settings_form.timezone == zone %}selected{% endif %}>{{ zone }}</option>{% endfor %}
              </select>
            </label>
          </div>
        </div>

        {% if can('seo.manage') %}
          <div class="{{ section_class }}">
            <div>
              <h2 class="text-sm font-semibold text-slate-900">Search engines</h2>
              <p class="mt-0.5 text-xs text-slate-400">Titles, descriptions, the sitemap, robots.txt and the rest of how the site meets search engines are in <a href="{{ url('admin/seo') }}" class="font-medium text-blue-700 hover:underline">SEO</a>.</p>
            </div>
          </div>
        {% endif %}

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Picture quality</h2>
            <p class="mt-0.5 text-xs text-slate-400">The site makes a lighter copy of each picture in the sizes a page needs. Higher quality keeps more detail, for example in product photos, and makes the copies larger. A change applies to every picture: the new copies are made as pages ask for them.</p>
          </div>
          <div class="set-rows">
          <div role="radiogroup" aria-labelledby="picture-quality-label">
            <span id="picture-quality-label">Quality</span>
            <div class="set-options">
            {% for key, option in {
              standard: {label: 'Standard', help: 'Light pages. Fine for most photos.'},
              high: {label: 'High', help: 'Sharper detail; copies about half as large again.'},
              best: {label: 'Best', help: 'Closest to the originals; copies about twice as large.'}
            } %}
              <label>
                <input type="radio" name="picture_quality" value="{{ key }}" {% if settings_form.picture_quality|default('standard') == key %}checked{% endif %} class="h-4 w-4 border-slate-300 text-blue-600 focus:ring-blue-500">
                <span><strong>{{ option.label }}</strong><small>{{ option.help }}</small></span>
              </label>
            {% endfor %}
            </div>
          </div>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'smtp' %} hidden{% else %} active{% endif %}" data-panel="smtp">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Mailer</h2>
            <p class="mt-0.5 text-xs text-slate-400">Outgoing email identity and provider.</p>
          </div>
          <div class="set-rows">
            <label class="block">
              <span>Provider</span>
              <select name="mail_driver" class="{{ select_class }}">
                <option value="smtp" {% if settings_form.mail_driver == 'smtp' %}selected{% endif %}>SMTP</option>
                <option value="ses" {% if settings_form.mail_driver == 'ses' %}selected{% endif %}>AWS SES</option>
              </select>
            </label>
            <label class="block">
              <span>Test recipient</span>
              <input type="text" name="test_email_to" placeholder="you@example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>From email</span>
              <input type="text" name="mail_from" value="{{ settings_form.mail_from }}" placeholder="no-reply@example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>From name</span>
              <input type="text" name="mail_from_name" value="{{ settings_form.mail_from_name }}" placeholder="GnozioCMS" class="{{ input_class }}">
            </label>
          </div>
          <div class="mt-3 flex items-center justify-between gap-3 border-t border-slate-100 pt-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-slate-50 px-2 py-0.5 text-[11px] font-medium text-slate-500 ring-1 ring-inset ring-slate-200">Configured in YAML</span>
            <button type="submit" class="{{ secondary_button_class }}" name="send_test" value="1">Send test email</button>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">SMTP Configuration</h2>
            <p class="mt-0.5 text-xs text-slate-400">Server credentials used when SMTP is selected.</p>
          </div>
          <div class="set-rows">
            <label class="block">
              <span>Host</span>
              <input type="text" name="smtp_host" value="{{ settings_form.smtp_host }}" placeholder="smtp.example.com" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Port</span>
              <input type="number" name="smtp_port" value="{{ settings_form.smtp_port }}" placeholder="587" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Username</span>
              <input type="text" name="smtp_user" value="{{ settings_form.smtp_user }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Password</span>
              {{ local.secret_input('smtp_pass', settings_form.smtp_pass_set, input_class, '', settings_form.smtp_pass_lost) }}
            </label>
            <label class="block">
              <span>Encryption</span>
              <select name="smtp_encryption" class="{{ select_class }}">
                <option value="" {% if settings_form.smtp_encryption == '' %}selected{% endif %}>None</option>
                <option value="tls" {% if settings_form.smtp_encryption == 'tls' %}selected{% endif %}>TLS</option>
                <option value="ssl" {% if settings_form.smtp_encryption == 'ssl' %}selected{% endif %}>SSL</option>
              </select>
            </label>
          </div>
        </div>

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">AWS SES</h2>
            <p class="mt-0.5 text-xs text-slate-400">Credentials used when AWS SES is selected.</p>
          </div>
          <div class="set-rows">
            <label class="block">
              <span>Access key</span>
              <input type="text" name="ses_key" value="{{ settings_form.ses_key }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Secret key</span>
              {{ local.secret_input('ses_secret', settings_form.ses_secret_set, input_class, '', settings_form.ses_secret_lost) }}
            </label>
            <label class="block">
              <span>Region</span>
              <input type="text" name="ses_region" value="{{ settings_form.ses_region }}" placeholder="eu-central-1" class="{{ input_class }}">
            </label>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'auth' %} hidden{% else %} active{% endif %}" data-panel="auth">
        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Google Sign-In</h2>
            <p class="mt-0.5 text-xs text-slate-400">Allow existing GnozioCMS users to sign in with matching Google accounts.</p>
          </div>
          <div class="set-rows">
            <label class="flex">
              <input type="checkbox" name="google_enabled" value="1" {% if settings_form.google_enabled %}checked{% endif %}>
              <span><span class="font-medium">Enable Google Sign-In</span>
                <span class="block">Users must already exist in GnozioCMS with the same email address.</span></span>
            </label>
            <label class="block">
              <span>Google Client ID</span>
              <input type="text" name="google_client_id" value="{{ settings_form.google_client_id }}" class="{{ input_class }}">
            </label>
            <label class="block">
              <span>Google Client Secret</span>
              {{ local.secret_input('google_client_secret', settings_form.google_client_secret_set, input_class, '', settings_form.google_client_secret_lost) }}
            </label>
            <label class="block">
              <span>Allowed domain</span>
              <input type="text" name="google_allowed_domain" value="{{ settings_form.google_allowed_domain }}" placeholder="example.com" class="{{ input_class }}">
              <span class="block">Leave empty to allow any Google account that matches an active GnozioCMS user email.</span>
            </label>
          </div>
        </div>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'apis' %} hidden{% else %} active{% endif %}" data-panel="apis">
        {% if youtube_status == 'ok' %}
          {{ ui.flash(youtube_message ?: 'The key works.', 'success') }}
        {% elseif youtube_status == 'fail' %}
          {{ ui.flash(youtube_message ?: 'The key did not work.', 'error') }}
        {% endif %}
        <section class="lc-card en-card" aria-labelledby="api-h-youtube">
          <div class="en-card-head">
            <h2 id="api-h-youtube" class="en-card-title">YouTube</h2>
            <span class="en-chip {{ settings_form.youtube_key_set ? 'is-live' : 'is-draft' }}">{{ settings_form.youtube_key_set ? 'Key saved' : 'No key' }}</span>
          </div>
          <p class="en-help m-0">Used by the <strong>YouTube playlist</strong> block. Without a key a playlist shows its 15 newest videos, from YouTube's public feed. With a key it shows up to 50, with their lengths.</p>
          <div class="en-rows">
            <div class="seo-row">
              <label class="seo-label" for="youtube_key">API key</label>
              <div>{{ local.secret_input('youtube_key', settings_form.youtube_key_set, 'lc-input', 'AIza…', settings_form.youtube_key_lost) }}</div>
            </div>
            <div class="seo-row">
              <label class="seo-label" for="youtube_cache_hours">Keep a playlist for</label>
              <div>
                <select id="youtube_cache_hours" name="youtube_cache_hours" class="lc-input lc-select">
                  {% for hours, label in {'1': '1 hour', '6': '6 hours', '24': '1 day', '72': '3 days'} %}
                    <option value="{{ hours }}"{% if settings_form.youtube_cache_hours == hours %} selected{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
                <p class="seo-help">A playlist is fetched again after this long. A page never waits for YouTube, and if YouTube cannot be asked the last copy is shown.</p>
              </div>
            </div>
          </div>
          <div class="en-actions mt-2">
            <button type="submit" name="youtube_test" value="1" class="{{ secondary_button_class }}"{% if not settings_form.youtube_key_set %} title="Save a key first, or type one and press this button"{% endif %}>Save and test the key</button>
          </div>
          <details class="en-details-note">
            <summary>How to get a key</summary>
            <ol>
              <li>In the <a class="en-link" href="https://console.cloud.google.com/" target="_blank" rel="noopener">Google Cloud console</a>, make a project (or use one you have).</li>
              <li>Under <em>APIs &amp; Services &gt; Library</em>, switch on <em>YouTube Data API v3</em>.</li>
              <li>Under <em>Credentials</em>, make an <em>API key</em> and, to be safe, limit it to that API (and to this server's address if it has a fixed one). Keys limited to websites do not work here: the site asks YouTube from the server.</li>
              <li>Paste it above and press <em>Save and test the key</em>. A key has a daily quota of 10,000 units; a playlist costs about 3, once for as long as it is kept.</li>
            </ol>
            <p class="seo-help">The key is kept in the site's system database and is never sent to the browser. Only public and unlisted playlists can be shown.</p>
          </details>
        </section>
        <section class="lc-card en-card" aria-labelledby="api-h-maps">
          <div class="en-card-head">
            <h2 id="api-h-maps" class="en-card-title">Maps</h2>
            <span class="en-chip {{ settings_form.maps_tiles_url ? 'is-live' : 'is-draft' }}">{{ settings_form.maps_tiles_url ? 'Own tiles' : 'OpenStreetMap' }}</span>
          </div>
          <p class="en-help m-0">Used by the maps of the <strong>Map</strong> block, of archives with the Map layout, and of the pages of points, routes and businesses. The map itself is drawn by the visitor's browser, from the tiles below.</p>
          <div class="en-rows">
            <div class="seo-row">
              <label class="seo-label" for="maps_load">Load a map</label>
              <div>
                <select id="maps_load" name="maps_load" class="lc-input lc-select">
                  <option value="click"{% if settings_form.maps_load != 'auto' %} selected{% endif %}>When the visitor asks for it</option>
                  <option value="auto"{% if settings_form.maps_load == 'auto' %} selected{% endif %}>As soon as it comes into view</option>
                </select>
                <p class="seo-help">Loading a map tells the tile server the visitor's address. "When the visitor asks" makes no request to anyone until then.</p>
              </div>
            </div>
            <div class="seo-row">
              <label class="seo-label" for="maps_tiles_url">Tile address</label>
              <div>
                <input type="text" id="maps_tiles_url" name="maps_tiles_url" value="{{ settings_form.maps_tiles_url }}" class="lc-input" placeholder="https://tile.openstreetmap.org/{z}/{x}/{y}.png" autocomplete="off">
                <p class="seo-help">Leave empty for OpenStreetMap's own tiles, which are meant for light use. A busy site should use a provider (MapTiler, Thunderforest, Stadia…) or its own server: paste its address here, with <code>{z}</code>, <code>{x}</code> and <code>{y}</code> in it. It must start with https://.</p>
              </div>
            </div>
            <div class="seo-row">
              <label class="seo-label" for="maps_attribution">Credit</label>
              <div>
                <input type="text" id="maps_attribution" name="maps_attribution" value="{{ settings_form.maps_attribution }}" class="lc-input" placeholder="© MapTiler © OpenStreetMap contributors" autocomplete="off">
                <p class="seo-help">Shown in the corner of every map. Your provider says what it must say; plain text and links only.</p>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="{{ panel_class }}{% if active_tab != 'cache' %} hidden{% else %} active{% endif %}" data-panel="cache">
        {% if cache.notice == 'purged' %}
          {{ ui.flash('The cache was cleared' ~ (cache.mode == 'varnish' ? ' and the Varnish confirmed it (' ~ cache.status ~ ')' : '') ~ '. Visitors get the pages as they are now.', 'success') }}
        {% elseif cache.notice == 'purge_failed' %}
          {{ ui.flash('The built-in copies and the compiled templates were cleared, but the Varnish at ' ~ cache.address ~ (cache.status ? ' answered ' ~ cache.status : ' did not answer') ~ '. See "How to set it up" under Varnish.', 'error') }}
        {% endif %}
        {% set cache_front = cache.mode != 'none' %}

        <div class="{{ section_class }}">
          <div class="{{ section_header_class }}">
            <h2 class="text-sm font-semibold text-slate-900">Cache status</h2>
            <p class="mt-0.5 text-xs text-slate-400">A page cache keeps the public pages ready, so a visit does not make the page again: a few milliseconds instead of a few hundred. A site has one of two: the built-in cache, or a Varnish in front of it.</p>
          </div>
          <div class="set-rows">
            <div>
              <span>Built-in cache</span>
              <strong class="pt-1 text-xs font-medium text-slate-800">{% if cache.pages.enabled %}On: {{ cache.pages.entries }} {{ cache.pages.entries == 1 ? 'page' : 'pages' }} kept ({{ cache.pages.size }}){% else %}Off{% endif %}</strong>
            </div>
            <div>
              <span>Varnish</span>
              <strong class="pt-1 text-xs font-medium text-slate-800">{% if cache.mode == 'cloudpanel' %}CloudPanel's, found by itself{% elseif cache.mode == 'varnish' %}At {{ cache.address }}{% else %}None set{% endif %}</strong>
            </div>
            <div>
              <span>Visitors get</span>
              <p class="pt-1">
                {%- if cache_front -%}
                  Public pages from the Varnish. It is emptied on every change saved in the admin.
                {%- elseif cache.pages.enabled and not cache.base_url -%}
                  <strong class="font-medium text-orange-700">A page made on every visit: the built-in cache is on but keeps nothing until the site has a Base URL (General).</strong>
                {%- elseif cache.pages.enabled -%}
                  Public pages from the built-in copies. They are made again on every change saved in the admin, and at least every {{ cache.pages.ttl_minutes }} minutes.
                {%- else -%}
                  A page made on every visit. Turn on the built-in cache below to make visits faster.
                {%- endif -%}
              </p>
            </div>
            <div>
              <span>Clear by hand</span>
              <div>
                <button type="submit" form="cache-clear" class="{{ secondary_button_class }}">Clear cache now</button>
                <p class="mt-1 text-[11px] leading-4 text-slate-500">Empties the built-in copies, asks the Varnish to drop this site's pages, and makes the compiled templates again. Every change saved in the admin already does this. You need it after files were changed on the server outside the admin (by hand, by a script, by an upload over FTP), and to test the Varnish address.</p>
              </div>
            </div>
          </div>
        </div>

        <section class="{{ section_class }}" aria-labelledby="cache-h-built-in">
          <div class="flex items-start justify-between gap-3">
            <h2 id="cache-h-built-in" class="text-sm font-semibold text-slate-900">Built-in page cache</h2>
            {{ ui.badge(cache.pages.enabled ? 'On' : 'Off', cache.pages.enabled ? 'green' : 'slate') }}
          </div>
          <p class="mt-0.5 text-xs text-slate-400">For hosting with nothing in front of the site, which is most shared hosting. The site keeps a copy of each public page and sends it to the next visitor, so a visit reads one file instead of running the CMS. Nothing has to be installed.</p>
          <div class="set-rows mt-3">
            <input type="hidden" name="cache_shown" value="1">
            <label class="flex">
              <input type="checkbox" name="page_cache" value="1" {% if cache.pages.enabled %}checked{% endif %}>
              <span><span class="font-medium">Keep a copy of public pages</span>
                <span class="block text-xs text-slate-500">Takes effect when you save. Turning it off or on drops every copy kept so far.</span></span>
            </label>
            {% if cache_front %}
              <p class="set-indent text-xs text-orange-700">A Varnish is already in front of this site and does the same job. Leave this off: it would add nothing.</p>
            {% elseif not cache.base_url %}
              <p class="set-indent text-xs text-orange-700">It needs the site's Base URL (<a href="{{ url('admin/settings?tab=basics') }}" class="font-medium underline">General</a>): only pages asked for on that address are kept. Until it is set nothing is kept.</p>
            {% endif %}
          </div>
          <details class="en-details-note">
            <summary>When to use it</summary>
            <ul class="mt-1.5 list-disc space-y-1 pl-5">
              <li><strong>Turn it on</strong> on shared hosting, or on any server with no Varnish or CDN cache in front of the site.</li>
              <li><strong>Leave it off</strong> when a Varnish (for example CloudPanel's) or a CDN already keeps the pages, and while you are building the site by changing its files on the server, since such changes show only after up to {{ cache.pages.ttl_minutes }} minutes or after <em>Clear cache now</em>.</li>
            </ul>
          </details>
          <details class="en-details-note">
            <summary>What is kept, what is not, and how fresh it is</summary>
            <ul class="mt-1.5 list-disc space-y-1 pl-5">
              <li><strong>Kept:</strong> pages, the sitemap, feeds and robots.txt, opened by a visitor who is not signed in, on the site's own address (the Base URL), with nothing after a <code>?</code> in the address.</li>
              <li><strong>Never kept:</strong> anything seen by someone signed in (editors may see drafts), searches, filters and sorts, the shop's cart, checkout and account, pages that are not found or that redirect, pictures and downloads, an answer over {{ cache.pages.max_mb }} MB, and the MCP server.</li>
              <li><strong>Fresh:</strong> every change saved in the admin, and every scheduled entry going live, drops all the copies at once. A copy is never used for more than {{ cache.pages.ttl_minutes }} minutes either, so what changes outside the admin (a file edited on the server, a script) shows within {{ cache.pages.ttl_minutes }} minutes, or at once with <em>Clear cache now</em>.</li>
              <li><strong>Room:</strong> at most {{ cache.pages.max_entries|number_format }} pages, in <code>storage/cache/pages</code>. They count in Limits like the rest of the site.</li>
              <li><strong>To check it works:</strong> open a page in a private window twice and look at the response headers (the browser's developer tools, Network), or run <code>curl -sI {{ cache.base_url ?: 'https://example.com' }}/</code> twice. <code>X-Page-Cache: hit</code> means the copy was sent; <code>miss</code> means the page was made and kept.</li>
            </ul>
          </details>
        </section>

        <section class="{{ section_class }}" aria-labelledby="cache-h-varnish">
          <div class="flex items-start justify-between gap-3">
            <h2 id="cache-h-varnish" class="text-sm font-semibold text-slate-900">Varnish in front of the site</h2>
            {{ ui.badge(cache.mode == 'cloudpanel' ? 'CloudPanel' : (cache.mode == 'varnish' ? 'Address set' : 'Not set'), cache_front ? 'green' : 'slate') }}
          </div>
          {% if cache.mode == 'cloudpanel' %}
            <p class="mt-0.5 text-xs text-slate-400">CloudPanel's Varnish keeps the public pages (cache tag <span class="font-mono">{{ cache.tag ?: '—' }}</span>). There is nothing to set up: the site finds it by itself and empties it on every change saved in the admin, so visitors see a change at once.</p>
            <details class="en-details-note">
              <summary>How it works on CloudPanel</summary>
              <ul class="mt-1.5 list-disc space-y-1 pl-5">
                <li>How long a page is kept is CloudPanel's <em>Cache Lifetime</em> (the site's Varnish Cache settings in CloudPanel). Because every change empties it, it can stay long.</li>
                <li>Pages seen by someone signed in, the shop's cart, checkout and account, and the MCP server are never kept.</li>
                <li>If changes do not show: check that Varnish Cache is on for the site in CloudPanel, then press <em>Clear cache now</em>.</li>
              </ul>
            </details>
          {% else %}
            <p class="mt-0.5 text-xs text-slate-400">For a server where a Varnish stands in front of the site. With its address here, every change saved in the admin asks it to drop this site's pages (a <span class="font-mono">PURGE /</span> with the site's host), so a change shows at once however long Varnish keeps a page. Leave it empty when there is no Varnish. CloudPanel's Varnish is found by itself and needs no address.</p>
            <div class="set-rows mt-3">
              <label class="block">
                <span>Varnish address</span>
                <input type="text" name="cache_address" value="{{ cache.address }}" placeholder="127.0.0.1:6081" autocomplete="off" class="{{ input_class }} font-mono">
                <span class="block">Where Varnish listens, as host:port, seen from this server. Usually <span class="font-mono">127.0.0.1:6081</span> when it runs on the same machine.</span>
              </label>
            </div>
            <details class="en-details-note">
              <summary>How to set it up</summary>
              <ol>
                <li>Put Varnish in front of the site: visitors reach Varnish, and Varnish asks the site's web server.</li>
                <li>Let this server purge. Add this to the Varnish configuration (VCL), with the addresses this server connects from:
{% verbatim %}<pre class="mt-1.5 overflow-x-auto rounded-md bg-slate-900 p-2.5 font-mono text-[11px] leading-4 text-slate-100">acl purgers { "127.0.0.1"; "::1"; }

sub vcl_recv {
    if (req.method == "PURGE") {
        if (client.ip !~ purgers) { return (synth(405, "Not allowed")); }
        ban("req.http.host == " + req.http.host);
        return (synth(200, "Purged"));
    }
}</pre>{% endverbatim %}</li>
                <li>Add Varnish's address to <em>Trusted proxies</em> in <a class="en-link" href="{{ url('admin/settings?tab=basics') }}">General</a> (127.0.0.1 is there until the list is changed), so the site sees each visitor's own address and whether the visit is on HTTPS.</li>
                <li>Write the address above, save, then press <em>Clear cache now</em>. It says what Varnish answered: <strong>200</strong> is right; <strong>405</strong> means the VCL does not let this server purge; no answer means the address is wrong or Varnish does not listen there.</li>
              </ol>
            </details>
            <details class="en-details-note">
              <summary>How long Varnish keeps a page, and what it must not keep</summary>
              <ul class="mt-1.5 list-disc space-y-1 pl-5">
                <li>Public pages say <span class="font-mono">Cache-Control: public, max-age=0, s-maxage=60</span>: Varnish keeps them a minute, and browsers ask again every time. Since every change purges, the VCL may keep them much longer (<span class="font-mono">beresp.ttl</span>).</li>
                <li>Pages for someone signed in say <span class="font-mono">private, no-store</span>, and the MCP server (<span class="font-mono">/mcp</span>, <span class="font-mono">/_mcp/</span>, <span class="font-mono">/.well-known/oauth-*</span>) says <span class="font-mono">no-store</span> and is sent with a POST or an <span class="font-mono">Authorization</span> header. Varnish's default VCL respects all of these. A VCL that removes cookies or keeps everything must let these through, and must pass the <span class="font-mono">Authorization</span> header to the site.</li>
                <li>Do not turn the built-in cache on as well: with Varnish in front it adds nothing.</li>
              </ul>
            </details>
          {% endif %}
        </section>
      </div>

      </div>
    </div>

    {% embed '@admin/partials/action-bar.twig' %}
      {% block leading %}
        <a href="{{ url('admin/settings?tab=' ~ active_tab) }}" class="{{ secondary_button_class }}" data-section-discard>Discard</a>
      {% endblock %}
      {% block actions %}
        <button type="submit" class="{{ primary_button_class }}">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Save changes
        </button>
      {% endblock %}
    {% endembed %}
  </form>
  <form id="cache-clear" method="post" action="{{ url('admin/settings?tab=cache') }}" hidden>
    {{ csrf_field() }}
    <input type="hidden" name="cache_action" value="clear">
  </form>
  {% if can('limits.manage') %}
  <form id="storage-recalculate" method="post" action="/admin/settings?tab=limits" hidden>
    {{ csrf_field() }}
    <input type="hidden" name="storage_action" value="recalculate">
  </form>
  {% endif %}

{% endblock %}
