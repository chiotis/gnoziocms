{% extends '@admin/base.twig' %}
{% set page_heading = 'Publishing calendar' %}
{% import '@admin/partials/ui.twig' as ui %}
{#
  Overview > Publishing calendar (src/PublishingCalendar.php): what every active content type published or will publish, month
  or week, by people, AI publishing and MCP; with the AI schedules' planned, missed and failed runs for those who manage them.
#}

{% macro link(q, changes) %}{{ url('admin/publishing-calendar?' ~ (q|merge(changes)|filter(v => v != '' and v != 'all')|url_encode)) }}{% endmacro %}

  {% macro item(i, colour_of, run_class, state_names, compact) %}
    {% if i.kind == 'entry' %}
      {% set scheduled = i.status == 'scheduled' %}
      <a href="{{ url('admin/edit?type=' ~ i.type ~ '&slug=' ~ i.slug ~ '&lang=' ~ i.lang) }}"
         class="relative z-10 mb-1 block rounded border border-l-4 px-1.5 py-1 text-[11px] leading-tight hover:shadow {{ colour_of[i.type] ?? 'border-l-slate-400' }} {{ scheduled ? 'border-y-blue-200 border-r-blue-200 border-dashed bg-blue-50/50 text-slate-800' : 'border-y-slate-200 border-r-slate-200 bg-white text-slate-800' }}"
         title="{{ i.title }} · {{ i.type|title }}{{ i.lang ? ' (' ~ i.lang ~ ')' : '' }} · {{ scheduled ? 'Scheduled' : 'Published' }}{{ i.time ? ' ' ~ i.time : '' }}{{ i.by ? ' · ' ~ (i.source == 'people' ? 'by ' : 'written by ') ~ i.by : '' }}{{ i.visible ? '' : ' · hidden' }}"
         data-calendar-entry="{{ i.status }}" data-calendar-source="{{ i.source }}">
        {# A line for the time and who wrote it, then the title on up to two lines. #}
        <span class="flex items-center gap-1">
          {% if i.time %}<span class="font-semibold tabular-nums">{{ i.time }}</span>{% endif %}
          {% if scheduled %}<svg class="h-3 w-3 shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-label="Scheduled"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>{% endif %}
          {% if not compact %}<span class="truncate text-slate-500">{{ i.type|title }}{% if i.lang %} · {{ i.lang|upper }}{% endif %}{% if i.by %} · {{ i.by }}{% endif %}</span>{% endif %}
          {% if i.source == 'ai' %}<span class="ml-auto shrink-0 rounded bg-violet-100 px-1 text-[10px] font-semibold text-violet-800">AI</span>
          {% elseif i.source == 'mcp' %}<span class="ml-auto shrink-0 rounded bg-amber-100 px-1 text-[10px] font-semibold text-amber-800">MCP</span>{% endif %}
        </span>
        <span class="block {{ compact ? 'line-clamp-2' : '' }} font-medium">{{ i.title }}</span>
      </a>
    {% else %}
      {% set href = i.entry and i.state in ['published', 'scheduled', 'draft', 'picture'] ? url('admin/edit?type=' ~ (i.entry|split('/')[0]) ~ '&slug=' ~ (i.entry|split('/')[1]) ~ '&lang=' ~ (i.entry|split('/')[2]))
        : (i.state == 'failed' ? url('admin/ai-publishing?tab=runs&show=failed') : url('admin/ai-publishing?tab=schedules&edit=' ~ i.schedule)) %}
      <a href="{{ href }}" class="relative z-10 mb-1 block rounded border px-1.5 py-1 text-[11px] leading-tight hover:shadow {{ run_class[i.state] ?? run_class.planned }}"
         title="AI schedule {{ i.name }} · {{ i.time }} · {{ state_names[i.state] ?? i.state }}{{ i.title ? ' · ' ~ i.title : '' }}{{ i.error ? ' · ' ~ i.error : '' }}"
         data-calendar-run="{{ i.state }}">
        <span class="flex items-center gap-1">
          <span class="font-semibold tabular-nums">{{ i.time }}</span>
          <span class="truncate opacity-80">{{ state_names[i.state] ?? i.state }}</span>
          <span class="ml-auto shrink-0 rounded bg-violet-100 px-1 text-[10px] font-semibold text-violet-800">AI</span>
        </span>
        <span class="block {{ compact ? 'line-clamp-2' : '' }} font-medium">{{ i.title ?: i.name }}{% if not compact and i.title %} <span class="font-normal opacity-80">· {{ i.name }}</span>{% endif %}{% if i.manual %} <span class="font-normal opacity-70">(run now)</span>{% endif %}</span>
      </a>
    {% endif %}
  {% endmacro %}

{% block content %}
  {% set btn = 'inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium shadow-sm' %}
  {% set primary = btn ~ ' bg-blue-600 text-white hover:bg-blue-700' %}
  {% set secondary = btn ~ ' border border-slate-300 bg-white text-slate-700 hover:bg-slate-50' %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {% set seg = 'inline-flex shrink-0 rounded-md border border-slate-300 bg-white p-0.5 shadow-sm' %}
  {% set seg_on = 'bg-slate-900 text-white' %}
  {% set seg_off = 'text-slate-600 hover:bg-slate-100' %}

  {# The query of this screen, with one value changed. #}
  {% set q = {'view': view, 'date': date, 'type': filters.type, 'source': filters.source, 'lang': filters.lang} %}
  {% import _self as cal %}

  {# A colour for each content type, in the order of the menu. #}
  {% set type_colours = ['border-l-blue-500', 'border-l-emerald-500', 'border-l-amber-500', 'border-l-fuchsia-500', 'border-l-cyan-500', 'border-l-rose-500', 'border-l-lime-500', 'border-l-indigo-500', 'border-l-orange-500', 'border-l-teal-500'] %}
  {% set type_dots = ['bg-blue-500', 'bg-emerald-500', 'bg-amber-500', 'bg-fuchsia-500', 'bg-cyan-500', 'bg-rose-500', 'bg-lime-500', 'bg-indigo-500', 'bg-orange-500', 'bg-teal-500'] %}
  {% set colour_of = {} %}
  {% set dot_of = {} %}
  {% for t in calendar_types %}
    {% set colour_of = colour_of|merge({(t): type_colours[loop.index0 % type_colours|length]}) %}
    {% set dot_of = dot_of|merge({(t): type_dots[loop.index0 % type_dots|length]}) %}
  {% endfor %}

  {% set state_names = {'planned': 'Planned', 'off': 'Schedule off', 'due': 'Due', 'working': 'Writing…', 'published': 'Published', 'scheduled': 'Scheduled', 'draft': 'Draft', 'picture': 'Waiting for picture', 'failed': 'Failed', 'missed': 'Missed', 'gone': 'Post deleted'} %}
  {% set run_class = {
    'planned': 'border-dashed border-violet-300 bg-violet-50/60 text-violet-900',
    'off': 'border-dashed border-slate-300 bg-white text-slate-500',
    'due': 'border-violet-300 bg-violet-50 text-violet-900',
    'working': 'border-violet-300 bg-violet-50 text-violet-900',
    'published': 'border-emerald-200 bg-emerald-50 text-emerald-900',
    'scheduled': 'border-blue-300 bg-white text-blue-900',
    'draft': 'border-amber-200 bg-amber-50 text-amber-900',
    'picture': 'border-amber-200 bg-amber-50 text-amber-900',
    'failed': 'border-red-200 bg-red-50 text-red-900',
    'missed': 'border-slate-200 bg-slate-100 text-slate-500 line-through',
    'gone': 'border-slate-200 bg-slate-100 text-slate-500'
  } %}


  <header class="mb-4 flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 pb-4">
    <p class="max-w-3xl text-xs text-slate-500">Everything the site has published and will publish, of every content type: posts written by people, by AI publishing and through MCP{% if with_ai %}, and the AI schedules' coming runs{% endif %}. Entries sit on their date; scheduled ones on the time they go live. Drafts and entries without a date are not shown.</p>
    <div class="flex flex-wrap items-center gap-1.5 text-xs" data-calendar-totals>
      {{ ui.badge(totals.published ~ ' published', 'green') }}
      {{ ui.badge(totals.scheduled ~ ' scheduled', 'blue') }}
      {% if with_ai %}{{ ui.badge(totals.planned ~ ' planned by AI', 'violet') }}{% endif %}
      <span class="text-slate-500">{{ totals.people }} by people · {{ totals.ai }} by AI</span>
    </div>
  </header>

  <div class="mb-3 flex flex-wrap items-center justify-between gap-2" data-calendar-head>
    <div class="flex items-center gap-2 text-sm">
      <a class="{{ secondary }} px-2 py-1 text-xs" href="{{ cal.link(q, {'date': prev}) }}" aria-label="Previous {{ view }}">‹</a>
      <strong class="min-w-[9rem] text-center text-slate-900" data-calendar-title>{{ period }}</strong>
      <a class="{{ secondary }} px-2 py-1 text-xs" href="{{ cal.link(q, {'date': next}) }}" aria-label="Next {{ view }}">›</a>
      {% if not current %}<a class="text-xs font-medium text-blue-700 underline" href="{{ cal.link(q, {'date': ''}) }}">Today</a>{% endif %}
      <span class="hidden text-xs text-slate-400 sm:inline">Time zone {{ zone }}</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <div class="{{ seg }}" role="group" aria-label="Who wrote it">
        {% for key, name in {'all': 'All', 'people': 'People', 'ai': 'AI'} %}
          <a href="{{ cal.link(q, {'source': key}) }}" class="rounded px-2.5 py-1 text-xs font-medium {{ filters.source == key ? seg_on : seg_off }}"{% if filters.source == key %} aria-current="true"{% endif %}>{{ name }}</a>
        {% endfor %}
      </div>
      {% if languages|length > 1 %}
        <div class="{{ seg }}" role="group" aria-label="Language">
          <a href="{{ cal.link(q, {'lang': ''}) }}" class="rounded px-2 py-1 text-xs font-medium {{ filters.lang == '' ? seg_on : seg_off }}">All</a>
          {% for code in languages %}
            <a href="{{ cal.link(q, {'lang': code}) }}" class="rounded px-2 py-1 text-xs font-medium {{ filters.lang == code ? seg_on : seg_off }}"{% if filters.lang == code %} aria-current="true"{% endif %}>{{ code|upper }}</a>
          {% endfor %}
        </div>
      {% endif %}
      <div class="{{ seg }}" role="group" aria-label="View" data-calendar-view-switch>
        {% for key, name in {'month': 'Month', 'week': 'Week'} %}
          <a href="{{ cal.link(q, {'view': key}) }}" class="rounded px-2.5 py-1 text-xs font-medium {{ view == key ? seg_on : seg_off }}"{% if view == key %} aria-current="true"{% endif %}>{{ name }}</a>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="mb-3 flex flex-wrap items-center gap-1.5" role="group" aria-label="Content type" data-calendar-types>
    <a href="{{ cal.link(q, {'type': ''}) }}" class="rounded-full border px-2.5 py-0.5 text-xs font-medium {{ filters.type == '' ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 bg-white text-slate-600 hover:bg-slate-50' }}">All types</a>
    {% for t in calendar_types %}
      <a href="{{ cal.link(q, {'type': t}) }}" class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium {{ filters.type == t ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 bg-white text-slate-600 hover:bg-slate-50' }}"{% if filters.type == t %} aria-current="true"{% endif %}>
        <span class="inline-block h-2 w-2 rounded-full {{ dot_of[t] }}"></span>{{ t|title }}
      </a>
    {% endfor %}
  </div>

  {% if view == 'month' %}
    <div class="{{ card }} overflow-x-auto" data-calendar-month>
      <div class="grid min-w-[760px] grid-cols-7">
        {% for name in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] %}
          <div class="border-b border-slate-200 px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wide text-slate-500 {{ loop.first ? '' : 'border-l' }}">{{ name }}</div>
        {% endfor %}
        {% for d in days %}
          {% set shown = 4 %}
          <div class="min-h-[7.5rem] border-b border-slate-100 p-1.5 {{ d.weekday == 1 ? '' : 'border-l' }} {{ d.today ? 'bg-blue-50/50' : (d.in_period ? '' : 'bg-slate-50') }}" data-calendar-day="{{ d.date }}"{% if d.today %} aria-current="date"{% endif %}>
            <div class="mb-1 flex items-center justify-between">
              <a href="{{ cal.link(q, {'view': 'week', 'date': d.date}) }}" class="inline-flex h-6 min-w-[1.5rem] items-center justify-center rounded-full px-1 text-xs font-semibold {{ d.today ? 'bg-blue-600 text-white' : (d.in_period ? 'text-slate-700 hover:bg-slate-100' : 'text-slate-400 hover:bg-slate-100') }}" aria-label="Week of {{ d.label }}">{{ d.number }}</a>
              {% if d.items|length %}<span class="text-[10px] text-slate-400">{{ d.items|length }}</span>{% endif %}
            </div>
            <div class="{{ d.in_period ? '' : 'opacity-60' }}">
              {% for i in d.items|slice(0, shown) %}{{ cal.item(i, colour_of, run_class, state_names, true) }}{% endfor %}
              {% if d.items|length > shown %}
                <details class="group">
                  <summary class="cursor-pointer list-none text-[11px] font-medium text-blue-700 hover:underline group-open:hidden">+ {{ d.items|length - shown }} more</summary>
                  {% for i in d.items|slice(shown) %}{{ cal.item(i, colour_of, run_class, state_names, true) }}{% endfor %}
                </details>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="{{ card }} overflow-x-auto" data-calendar-week>
      <div class="grid min-w-[880px]" style="grid-template-columns: 3.5rem repeat(7, minmax(0, 1fr));">
        <div class="border-b border-slate-200"></div>
        {% for d in days %}
          <div class="border-b border-l border-slate-200 px-2 py-2 text-xs font-semibold {{ d.today ? 'bg-blue-50 text-blue-900' : 'text-slate-700' }}"{% if d.today %} aria-current="date"{% endif %}>
            {{ d.label }}{% if d.today %} <span class="font-normal">· today</span>{% endif %}
            <span class="block font-normal text-slate-400">{{ d.items|length }} item{{ d.items|length == 1 ? '' : 's' }}</span>
          </div>
        {% endfor %}
        {% set untimed = days|filter(d => d.items|filter(i => i.time == '')|length > 0)|length > 0 %}
        {% if untimed %}
          <div class="border-b border-slate-200 px-1.5 py-1 text-right text-[11px] text-slate-400">All day</div>
          {% for d in days %}
            <div class="border-b border-l border-slate-200 p-1 {{ d.today ? 'bg-blue-50/40' : '' }}">
              {% for i in d.items|filter(i => i.time == '') %}{{ cal.item(i, colour_of, run_class, state_names, false) }}{% endfor %}
            </div>
          {% endfor %}
        {% endif %}
        {% for h in hours[0]..hours[1] %}
          <div class="border-b border-slate-100 px-1.5 py-1 text-right text-[11px] text-slate-400">{{ '%02d'|format(h) }}:00</div>
          {% for d in days %}
            <div class="group relative min-h-[2.25rem] border-b border-l border-slate-100 p-1 {{ d.today ? 'bg-blue-50/40' : '' }}" data-calendar-cell="{{ d.date }} {{ '%02d'|format(h) }}">
              {% for i in d.items|filter(i => i.time != '' and i.hour == h) %}{{ cal.item(i, colour_of, run_class, state_names, false) }}{% endfor %}
              {% if can_ai and not d.past %}
                <a href="{{ url('admin/ai-publishing?tab=schedules&edit=new&day=' ~ d.weekday ~ '&time=' ~ '%02d'|format(h) ~ ':00') }}" class="absolute inset-0 z-0 flex items-end justify-end p-1 text-[11px] text-blue-700 opacity-0 transition-opacity group-hover:opacity-100 focus:opacity-100" aria-label="Add an AI schedule on {{ d.label }} at {{ '%02d'|format(h) }}:00"><span class="rounded bg-white/90 px-1">+ AI schedule</span></a>
              {% endif %}
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-500" data-calendar-legend>
    <span class="inline-flex items-center gap-1"><span class="inline-block h-3 w-3 rounded border border-l-4 border-slate-300 border-l-slate-500 bg-white"></span>Published</span>
    <span class="inline-flex items-center gap-1"><span class="inline-block h-3 w-3 rounded border border-dashed border-blue-300 bg-blue-50"></span>Scheduled</span>
    {% if with_ai %}
      {% for key in ['planned', 'working', 'draft', 'failed', 'missed'] %}
        <span class="inline-flex items-center gap-1"><span class="inline-block h-3 w-3 rounded border {{ run_class[key] }}"></span>AI {{ state_names[key]|lower }}</span>
      {% endfor %}
    {% endif %}
    {% if view == 'week' and can_ai %}<span class="ml-auto">Click an empty hour to add an AI schedule there.</span>{% elseif view == 'month' %}<span class="ml-auto">Click a day's number for its week.</span>{% endif %}
  </div>
{% endblock %}
