{% extends '@admin/base.twig' %}
{% set page_heading = customer is defined ? (customer.name ?: customer.email) : 'Customers' %}
{% import '@admin/partials/ui.twig' as ui %}
{# Shop > Customers (docs/shop-plan.md, section 8): the list with what each has ordered, and one customer with their orders. #}
{% block content %}
  {% set input = 'rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
  {% set card = 'rounded-lg border border-slate-200 bg-white' %}
  {{ ui.flash(message, done == 'ok' ? 'success' : 'error') }}
  {% if customer is defined %}
    <a href="{{ url('admin/shop-customers') }}" class="mb-3 inline-block text-sm text-slate-500 hover:text-slate-800">← Customers</a>
    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_320px]">
      <section class="{{ card }}">
        <div class="border-b border-slate-200 px-4 py-3"><h2 class="text-sm font-semibold text-slate-900">Orders</h2></div>
        {% if orders is empty %}
          {{ ui.empty_state('No orders yet', '') }}
        {% else %}
          <table class="min-w-full divide-y divide-slate-100 text-sm">
            {% for order in orders %}
              <tr><td class="px-4 py-2"><a class="font-mono text-blue-700 hover:underline" href="{{ url('admin/shop-orders?id=' ~ order.id) }}">{{ order.number }}</a></td><td class="px-4 py-2 text-slate-500">{{ order.created_at|date('d/m/Y') }}</td><td class="px-4 py-2">{{ ui.badge(order.status_label, 'slate') }}</td><td class="px-4 py-2 text-right tabular-nums">{{ order.total }}</td></tr>
            {% endfor %}
          </table>
        {% endif %}
      </section>
      <aside class="grid content-start gap-4">
        <section class="{{ card }} px-4 py-3 text-sm">
          <p class="font-medium text-slate-900">{{ customer.name ?: '—' }}</p>
          <p><a class="text-blue-700 hover:underline" href="mailto:{{ customer.email }}">{{ customer.email }}</a> {{ customer.verified ? ui.badge('Confirmed', 'green') : ui.badge('Not confirmed', 'amber') }}</p>
          {% if customer.phone %}<p class="text-slate-600">{{ customer.phone }}</p>{% endif %}
          {% if customer.address_lines is not empty %}<p class="mt-2 whitespace-pre-line text-slate-600">{{ customer.address_lines|join('\n') }}</p>{% endif %}
          <p class="mt-2 text-xs text-slate-400">Since {{ customer.created_at|date('d/m/Y') }}{% if customer.last_login_at %} · last signed in {{ customer.last_login_at|date('d/m/Y') }}{% endif %}</p>
        </section>
        <form method="post" action="{{ url('admin/shop-customers') }}" class="{{ card }} px-4 py-3" data-confirm="Delete {{ customer.email }}'s account? Their orders stay, linked to nobody. This cannot be undone.">
          {{ csrf_field() }}<input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{ customer.id }}">
          <button class="text-sm font-medium text-red-600 hover:underline">Delete the account</button>
          <p class="mt-1 text-xs text-slate-400">When they ask to be forgotten. Orders stay for the accounts.</p>
        </form>
      </aside>
    </div>
  {% else %}
    <form method="get" action="{{ url('admin/shop-customers') }}" class="mb-4 flex gap-2">
      <label class="grow"><span class="sr-only">Search</span><input type="search" name="q" value="{{ q }}" placeholder="Email or name" class="{{ input }} w-full"></label>
      <button class="rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">Search</button>
    </form>
    <div class="overflow-hidden {{ card }}">
      {% if customers is empty %}
        {{ ui.empty_state('No customers', q ? 'Nobody matches.' : 'Customers who create an account at /account appear here.') }}
      {% else %}
        <table class="min-w-full divide-y divide-slate-200 text-sm">
          <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500"><tr><th class="px-4 py-2">Customer</th><th class="px-4 py-2">Since</th><th class="px-4 py-2 text-right">Orders</th><th class="px-4 py-2 text-right">Spent</th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            {% for c in customers %}
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-2"><a class="text-blue-700 hover:underline" href="{{ url('admin/shop-customers?id=' ~ c.id) }}">{{ c.name ?: c.email }}</a>{% if c.name %}<span class="block text-xs text-slate-400">{{ c.email }}</span>{% endif %}</td>
                <td class="px-4 py-2 text-slate-500">{{ c.created_at|date('d/m/Y') }}</td>
                <td class="px-4 py-2 text-right tabular-nums">{{ c.orders }}</td>
                <td class="px-4 py-2 text-right tabular-nums">{{ c.spent_text }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
    <div class="mt-3 flex items-center justify-between text-xs text-slate-400"><span>{{ total }} customers</span>{{ ui.pagination(page, pages, q ? {q: q} : {}) }}</div>
  {% endif %}
{% endblock %}
