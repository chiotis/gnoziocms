{#
  Theme > Export and import: the whole theme carried to another site (ThemeTransfer). The buttons are wired by
  admin-theme-transfer.js; they work on saved settings, not on the unsaved choices of this screen. The controls have no
  `name`, so the Save button of the screen never sends them.

  transfer.parts    the parts an import can take: key => {label, ticked}
  transfer.backup   {at} when the theme from before the last import is kept

  Classes the script sets (kept here so the CSS build sees them): text-red-700 text-slate-600 py-1 pr-3 align-top
#}
<section class="rounded-lg border border-slate-200 bg-white p-4" aria-labelledby="transfer-title" data-theme-transfer data-endpoint="{{ url('admin/theme') }}">
  <div class="mb-3 border-b border-slate-100 pb-3">
    <h2 id="transfer-title" class="text-sm font-semibold text-slate-900">Export and import the theme</h2>
    <p class="mt-0.5 text-xs text-slate-500">Carry this site's whole theme to another GnozioCMS site: Branding and its font files, Header, Footer and the other sections, Single and Archive Layouts, the templates built with blocks, Footer Blocks and Custom CSS. Template files and blocks of your own in <code class="rounded bg-slate-100 px-1 py-0.5 text-[11px]">custom/</code> are code and are copied by hand.</p>
  </div>

  <div class="space-y-3">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <a class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" href="{{ url('admin/theme?transfer=export') }}" download>
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16"/></svg>
        Export theme
      </a>
      <span class="text-xs text-slate-500">A zip of the saved theme. Save your changes first.</span>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <label class="inline-flex shrink-0 cursor-pointer items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50 focus-within:ring-2 focus-within:ring-blue-500">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 20V8m0 0l-4 4m4-4l4 4M4 4h16"/></svg>
        Import…
        <input type="file" class="sr-only" accept=".zip,.json,application/zip,application/json" data-tt-file>
      </label>
      <span class="text-xs text-slate-500">Shows what each part would change, and you choose the parts. The theme from before is kept so you can undo.</span>
    </div>

    <div class="space-y-3 rounded-md border border-slate-200 bg-slate-50 p-3" data-tt-preview hidden aria-live="polite">
      <p class="text-sm font-semibold text-slate-800" data-tt-summary></p>
      <div class="space-y-1.5" data-tt-parts></div>
      <ul class="list-disc space-y-1 pl-5 text-xs text-amber-800" data-tt-warnings></ul>
      <p class="text-xs text-slate-500" data-tt-extra></p>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md bg-blue-600 px-3 py-1.5 text-sm font-medium text-white shadow-sm transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50" data-tt-apply>Import the ticked parts</button>
        <button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" data-tt-cancel>Cancel</button>
      </div>
    </div>

    {# The attribute is on a wrapper: `flex` would show a hidden element. #}
    <div data-tt-undo-row{% if not transfer.backup %} hidden{% endif %}><div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <button type="button" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm transition hover:bg-slate-50" data-tt-undo>Undo the last import</button>
      <span class="text-xs text-slate-500">Puts the theme back as it was{% if transfer.backup.at|default('') %} before {{ transfer.backup.at|date('j M Y, H:i') }}{% endif %}. Imported font files stay.</span>
    </div></div>
    <p class="text-xs text-slate-600" data-tt-status role="status"></p>
  </div>

  {# One part of the preview; the script fills a copy for each. #}
  <template data-tt-part>
    <details class="rounded-md border border-slate-200 bg-white">
      <summary class="flex cursor-pointer items-center gap-2 px-3 py-2 text-sm">
        <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500" data-tt-tick>
        <span class="font-medium text-slate-800" data-tt-label></span>
        <span class="ml-auto text-xs text-slate-500" data-tt-count></span>
      </summary>
      <div class="overflow-x-auto border-t border-slate-100 px-3 py-2">
        <table class="w-full text-left text-xs">
          <thead class="text-slate-500"><tr><th scope="col" class="py-1 pr-3 font-medium">Setting</th><th scope="col" class="py-1 pr-3 font-medium">Now</th><th scope="col" class="py-1 font-medium">Import</th></tr></thead>
          <tbody class="divide-y divide-slate-100 text-slate-700" data-tt-rows></tbody>
        </table>
      </div>
    </details>
  </template>
</section>
<script src="{{ asset('js/admin-theme-transfer.js') }}" defer></script>
