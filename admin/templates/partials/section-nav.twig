{#
  The left-hand list of a settings screen (Settings, Shop settings): sections under small group headings, the current
  one in a white pill, its form on the right. Below 1024 px the list is a select above the form instead.

    {% import '@admin/partials/section-nav.twig' as section_nav %}
    {{ section_nav.nav(groups, current, 'Settings', true) }}

  groups:  [{label: 'System', items: [{key: 'backup', label: 'Backups', href: '…', icon: '<path …/>'}]}]
  switch:  true when every section is a panel of one form in the page ([data-panel="key"]): admin.js shows the chosen
           one without loading the page and keeps ?tab= in the address. false: the items are plain links.
#}
{% macro nav(groups, current, label, switch = false) %}
  <div class="section-nav" data-section-nav="{{ switch ? 'switch' : 'links' }}">
    <label class="section-nav-select">
      <span class="sr-only">{{ label }}</span>
      <select data-section-select class="block w-full rounded-md border border-slate-300 bg-white px-2.5 py-2 text-sm font-medium text-slate-800 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500">
        {% for group in groups %}
          <optgroup label="{{ group.label }}">
            {% for item in group.items %}
              <option value="{{ item.key }}" data-href="{{ item.href }}"{% if item.key == current %} selected{% endif %}>{{ item.label }}</option>
            {% endfor %}
          </optgroup>
        {% endfor %}
      </select>
    </label>
    <nav class="section-nav-list" aria-label="{{ label }}">
      {% for group in groups %}
        <p class="section-nav-heading" id="section-nav-{{ loop.index }}">{{ group.label }}</p>
        <ul class="section-nav-items" aria-labelledby="section-nav-{{ loop.index }}">
          {% for item in group.items %}
            <li><a href="{{ item.href }}" class="section-nav-link" data-section="{{ item.key }}"{% if item.key == current %} aria-current="page"{% endif %}><svg fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">{{ item.icon|default('<path stroke-linecap="round" d="M5 12h14"/>')|raw }}</svg><span>{{ item.label }}</span></a></li>
          {% endfor %}
        </ul>
      {% endfor %}
    </nav>
  </div>
{% endmacro %}

