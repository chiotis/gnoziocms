{#
  The section list of the Settings screens: Settings' own sections (panels of one form at admin/settings?tab=…) and the
  screens that live under Settings with their own page (MCP at admin/mcp, Omni at admin/omni). Each is listed only for
  whoever may open it. The settings of backups and updates are on those screens (admin/backups?view=settings,
  admin/updates?view=settings), under their own permissions. `current` is the section shown; on admin/settings the list switches its panels in the page and
  the others stay links (admin.js, enhanceSectionNav).

    {% import '@admin/partials/settings-sidebar.twig' as settings_sidebar %}
    {{ settings_sidebar.nav('mcp') }}
#}
{% macro nav(current, switch = false) %}
  {% import '@admin/partials/section-nav.twig' as section_nav %}
  {% set tab = url('admin/settings?tab=') %}
  {% set own = can('settings.manage') %}
  {% set groups = [
    {label: 'Site', items: own ? [{key: 'basics', label: 'General', href: tab ~ 'basics', icon: section_nav.icon('sliders')}] : []},
    {label: 'Communication', items: own ? [{key: 'smtp', label: 'Email / SMTP', href: tab ~ 'smtp', icon: section_nav.icon('mail')}] : []},
    {label: 'Access', items: own ? [{key: 'auth', label: 'Sign-in', href: tab ~ 'auth', icon: section_nav.icon('key')}] : []},
    {label: 'Integrations', items: (own ? [{key: 'apis', label: 'APIs', href: tab ~ 'apis', icon: section_nav.icon('plug')}] : [])
      |merge(can('mcp.manage') ? [{key: 'mcp', label: 'MCP', href: url('admin/mcp'), icon: section_nav.icon('chip')}] : [])
      |merge(can('omni.manage') ? [{key: 'omni', label: 'Omni', href: url('admin/omni'), icon: section_nav.icon('radar')}] : [])},
    {label: 'System', items: (own ? [{key: 'cache', label: 'Cache', href: tab ~ 'cache', icon: section_nav.icon('bolt')}] : [])
      |merge(own and can('limits.manage') ? [{key: 'limits', label: 'Limits', href: tab ~ 'limits', icon: section_nav.icon('gauge')}] : [])}
  ] %}
  {{ section_nav.nav(groups|filter(g => g.items|length > 0), current, 'Settings', switch) }}
{% endmacro %}
