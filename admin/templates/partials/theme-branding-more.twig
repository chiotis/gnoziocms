{#
  Theme > Branding: the Forms and Phones cards, and a pointer to Export, import and reset (Advanced), where Branding is exported,
  imported and reset with the rest of the theme. Included by theme-branding.twig, which has d (the schema of design), vd (its values)
  and pd (the field name prefix).
#}
{% import '@admin/partials/layout-controls.twig' as c %}
<details class="bp-card">
  <summary><span>Forms</span><small>Fields, focus, errors</small></summary>
  <div class="bp-body">
    <dl class="m-0 space-y-2.5">
      {% for key in ['input_bg', 'input_border', 'input_border_width', 'input_ring', 'error_style'] %}
        {% if d[key] is defined %}{{ c.choice(d[key], pd ~ key ~ ']', vd[key], 'select', {}) }}{% endif %}
      {% endfor %}
    </dl>
    <p class="m-0 text-[11px] leading-4 text-slate-500">Applies to the public forms, the form block and the search field. The choices are built from the palette, so the text and the focus ring keep their contrast; the focus is always a visible ring. Field corners are in Shape and depth; the size of labels and field text is in <button type="button" class="bp-goto" data-goto-tab="typography">Typography</button>.</p>
    <button type="button" class="bp-reset" data-bp-reset="forms">Reset form overrides</button>
  </div>
</details>

<details class="bp-card">
  <summary><span>Phones</span><small>Optional margins on small screens</small></summary>
  <div class="bp-body">
    <div class="bp-nums">
      {% for key in ['mobile_gutter', 'mobile_section_space'] %}
        {% if d[key] is defined %}{{ c.num(d[key], pd ~ key ~ ']', vd[key], 'px') }}{% endif %}
      {% endfor %}
    </div>
    <p class="m-0 text-[11px] leading-4 text-slate-500">Empty keeps the automatic responsive sizes. These apply to screens up to 640px wide.</p>
    <button type="button" class="bp-reset" data-bp-reset="phones">Reset phone overrides</button>
  </div>
</details>

<p class="bp-moved">To carry this look to another site, or put a section back to its defaults, use <button type="button" class="bp-goto" data-goto-tab="transfer">Export, import and reset</button>.</p>
