{#
  Theme > Archive Layouts: one card for each list of entries, the content types and the taxonomies (the pages of a category or
  a tag). The settings are the ones the Content types and Taxonomies screens used to hold; only what differs from the
  defaults is stored, in the site's content type files and taxonomy files.

  archive_cards     from LayoutsAdmin::archiveCards(): types, taxonomies
  archive_layouts   the layouts of a list
#}
{% import '@admin/partials/layout-controls.twig' as c %}
{% import '@admin/partials/fields.twig' as fields %}
{% import _self as m %}
{% set short = {cards: 'Cards', list: 'List', compact: 'Compact', overlay: 'Tiles', featured: 'Featured', magazine: 'Magazine', editorial: 'Editorial', map: 'Map'} %}

{% macro card(item, name, kind, archive_layouts, short, labels, title_layouts) %}
  {% import '@admin/partials/layout-controls.twig' as c %}
  {% set a = item.archive %}
  {% set field_class = 'w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-900 placeholder:text-slate-400' %}
  {% set heading = kind == 'type' ? item.label : item.title %}
  {% set id = 'archive-' ~ kind ~ '-' ~ (kind == 'type' ? item.type : item.name) %}
  {% set list_key = kind == 'type' ? item.type : 'taxonomy:' ~ item.name %}
  <article class="lc-card rounded-xl border border-slate-200 bg-white" data-layout-card data-built="{{ item.built and item.built.use ? 'built' : 'theme' }}" aria-labelledby="{{ id }}">
    <header class="flex items-start gap-3 p-3 pb-2">
      <div class="min-w-0 flex-1">
        <h3 id="{{ id }}" class="truncate text-sm font-semibold text-slate-900">{{ heading }}</h3>
        <p class="mt-0.5 text-xs text-slate-500">
          {% if kind == 'type' %}{{ item.count }} {{ item.count == 1 ? 'entry' : 'entries' }} · <code class="rounded bg-slate-100 px-1 text-[11px]">/{{ item.type }}</code>
          {% else %}{{ item.terms }} {{ item.terms == 1 ? 'term' : 'terms' }} · every {{ item.kind }} page{% endif %}
        </p>
        <p class="mt-1.5 text-xs font-medium text-slate-700" data-lc-summary>{{ archive_layouts[a.layout] ?? a.layout }} · {{ a.columns }} columns · {{ a.per_page == 0 ? 'all on one page' : a.per_page ~ ' per page' }}</p>
      </div>
    </header>
    {% if item.built %}
      {# The page of the list: the theme's template, or one built with blocks (Entry list with a card made of blocks), for any list also of a type added later. #}
      <div class="lc-built border-t border-slate-100 p-3">
        <dl class="m-0"><div class="lc-row">
          <dt>Page</dt>
          <dd class="m-0 flex flex-wrap items-center gap-2">
            {{ c.seg('archive_template[' ~ list_key ~ ']', {theme: "The theme's", built: 'Built with blocks'}, item.built.use ? 'built' : 'theme', 'How the list of ' ~ heading ~ ' is made', 'built') }}
            <a href="{{ url(item.built.url) }}" class="lc-built-edit rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-700 no-underline hover:bg-slate-50">Edit template</a>
            <button type="button" class="rounded-md px-2 py-1 text-xs font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900" data-built-reset title="Draw the list with the theme's template again. The built template stays stored, so you can switch it on again.">Reset</button>
          </dd>
        </div></dl>
        <p class="mt-1.5 text-[11px] leading-4 text-slate-500" data-built-note>
          {% if item.built.blocks %}{{ item.built.blocks }} {{ item.built.blocks == 1 ? 'block' : 'blocks' }} in the template{% if item.built.card %}, {{ item.built.card }} in the card{% endif %}.{% else %}No template yet: choose Edit template to build one.{% endif %}
          While it is on, the Entry list block sets the layout, columns, order and size of a page; the title area, filters and texts below still apply.
        </p>
      </div>
    {% endif %}
    <dl class="m-0 space-y-2.5 border-t border-slate-100 p-3">
      <div class="lc-row">
        <dt>Layout</dt>
        <dd class="m-0">{{ c.tiles(name ~ '[layout]', short, a.layout, 'Layout', 'archive', 'archive', archive_layouts) }}</dd>
      </div>
      <div class="lc-row">
        <dt>Title area</dt>
        <dd class="m-0">{{ c.tiles(name ~ '[title_layout]', title_layouts, a.title_layout, 'Title area', 'title', '') }}</dd>
      </div>
      <div class="lc-row">
        <dt><label for="{{ id }}-picture">Picture</label></dt>
        <dd class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
          <input id="{{ id }}-picture" type="text" name="{{ name }}[title_image]" value="{{ a.title_image }}" placeholder="/uploads/media/picture.jpg" aria-label="Picture of the title area" class="{{ field_class }} min-w-0 flex-1" data-image-field>
          {{ c.chip(name ~ '[title_parallax]', 'Parallax', a.title_parallax) }}
        </dd>
      </div>
      <div class="lc-row">
        <dt>Columns</dt>
        <dd class="m-0 flex flex-wrap items-center gap-x-4 gap-y-2">
          {{ c.seg(name ~ '[columns]', {'2': '2', '3': '3', '4': '4'}, a.columns, 'Columns', 'columns') }}
          <label class="flex items-center gap-1.5 text-xs text-slate-600">Per page
            <input type="number" name="{{ name }}[per_page]" min="0" max="60" value="{{ a.per_page }}" class="w-16 rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-900" data-lc="per_page" aria-describedby="{{ id }}-pp">
          </label>
          <span id="{{ id }}-pp" class="text-[11px] text-slate-500">0 shows everything on one page</span>
        </dd>
      </div>
      <div class="lc-row">
        <dt><label for="{{ id }}-order">Order</label></dt>
        <dd class="m-0">
          <select id="{{ id }}-order" name="{{ name }}[order]" class="{{ field_class }} sm:w-auto">
            {% for value, label in item.orders %}<option value="{{ value }}"{% if a.order == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
          </select>
        </dd>
      </div>
      <div class="lc-row">
        <dt>Show</dt>
        <dd class="m-0 flex flex-wrap gap-1.5">
          {{ c.chip(name ~ '[show_image]', 'Images', a.show_image) }}
          {{ c.chip(name ~ '[show_excerpt]', 'Excerpt', a.show_excerpt) }}
          {{ c.chip(name ~ '[show_date]', 'Date', a.show_date) }}
          {{ c.chip(name ~ '[show_meta]', 'Category and card fields', a.show_meta) }}
          {{ c.chip(name ~ '[breadcrumbs]', 'Breadcrumbs', a.breadcrumbs) }}
        </dd>
      </div>
      <div class="lc-row" data-map-only>
        <dt>Map</dt>
        <dd class="m-0 flex flex-wrap items-center gap-x-4 gap-y-2">
          {{ c.seg(name ~ '[map_height]', {'small': 'Small', 'medium': 'Medium', 'large': 'Large', 'tall': 'Tall'}, a.map_height, 'Map height', 'map_height') }}
          <label class="flex items-center gap-1.5 text-xs text-slate-600">List
            <select name="{{ name }}[map_list]" class="{{ field_class }} sm:w-auto">
              {% for value, label in {'right': 'Right', 'left': 'Left', 'below': 'Below', 'over_right': 'Over the map, right (full width)', 'over_left': 'Over the map, left (full width)', 'none': 'None'} %}<option value="{{ value }}"{% if a.map_list == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
            </select>
          </label>
        </dd>
      </div>
      {% if item.options %}{{ c.options(item.options, name ~ '[options]', a.options|default({})) }}{% endif %}
      {% if item.filters is not empty %}
        <div class="lc-row">
          <dt>Filters</dt>
          <dd class="m-0 flex flex-wrap gap-1.5">
            {% for filter in item.filters %}
              <label class="lc-chip"><input type="checkbox" name="{{ name }}[taxonomies][]" value="{{ filter }}"{% if filter in a.taxonomies %} checked{% endif %}><span>{{ filter|capitalize }}</span></label>
            {% endfor %}
          </dd>
        </div>
      {% endif %}
      {% if kind == 'taxonomy' and item.hierarchical %}
        <div class="lc-row">
          <dt>Sub-terms</dt>
          <dd class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1.5">
            <input type="hidden" name="{{ name }}[children_shown]" value="1">
            {{ c.chip(name ~ '[include_children]', 'List entries of the sub-terms too', a.include_children) }}
            <span class="text-[11px] text-slate-500">A parent’s page and feed then carry what is filed under its children.</span>
          </dd>
        </div>
      {% endif %}
      {% if kind == 'taxonomy' and item.listable|length > 1 %}
        <div class="lc-row">
          <dt>Lists</dt>
          <dd class="m-0 flex flex-wrap gap-1.5">
            {% for type in item.listable %}
              <label class="lc-chip"><input type="checkbox" name="{{ name }}[types][]" value="{{ type }}"{% if not a.types or type in a.types %} checked{% endif %}><span>{{ labels[type] ?? type }}</span></label>
            {% endfor %}
          </dd>
        </div>
      {% endif %}
    </dl>
    <details class="border-t border-slate-100 px-3 py-2.5">
      <summary class="cursor-pointer select-none text-xs font-medium text-slate-600">Page title and subtitle</summary>
      <div class="mt-2 grid gap-2 sm:grid-cols-2">
        <label class="grid gap-1 text-xs font-medium text-slate-600">Title
          <input type="text" name="{{ name }}[title]" value="{{ a.title }}" placeholder="{{ kind == 'taxonomy' ? 'Default: “' ~ (item.kind == 'category' ? 'Category' : (item.kind == 'tag' ? 'Tag' : item.title)) ~ ': Name”' : 'Default: the theme’s text' }}" class="{{ field_class }}">
        </label>
        <label class="grid gap-1 text-xs font-medium text-slate-600">Subtitle
          <input type="text" name="{{ name }}[subtitle]" value="{{ a.subtitle }}" class="{{ field_class }}">
        </label>
      </div>
      {% if kind == 'taxonomy' %}<p class="mt-1 text-[11px] text-slate-500">Write {term} where the name should appear, for example “Articles about {term}”. A term’s own description is the subtitle unless one is written here.</p>{% endif %}
    </details>
  </article>
{% endmacro %}

<div class="space-y-4">
  <p class="text-xs text-slate-500">One card for each list of entries. Only what you change is stored; the rest follows the theme’s defaults.</p>

  <section aria-labelledby="archive-types-title">
    <h2 id="archive-types-title" class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Content types</h2>
    <div class="grid items-start gap-3 xl:grid-cols-2">
      {% for item in archive_cards.types %}
        {{ m.card(item, 'archive_types[' ~ item.type ~ ']', 'type', archive_layouts, short, {}, archive_title_layouts) }}
      {% else %}
        <p class="text-sm text-slate-500">No content type has a list yet.</p>
      {% endfor %}
    </div>
  </section>

  {% if archive_cards.taxonomies is not empty %}
    <section aria-labelledby="archive-tax-title">
      <h2 id="archive-tax-title" class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Categories, tags and other taxonomies</h2>
      <div class="grid items-start gap-3 xl:grid-cols-2">
        {% for item in archive_cards.taxonomies %}
          {{ m.card(item, 'archive_taxonomies[' ~ item.name ~ ']', 'taxonomy', archive_layouts, short, archive_cards.type_labels, archive_title_layouts) }}
        {% endfor %}
      </div>
    </section>
  {% endif %}
  <section aria-labelledby="archive-other-title">
    <h2 id="archive-other-title" class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">Other pages</h2>
    <div class="grid items-start gap-3 xl:grid-cols-2">
      {% set sp = search_page %}
      <article class="lc-card rounded-xl border border-slate-200 bg-white" data-layout-card aria-labelledby="archive-search" data-lang-scope>
        <header class="flex items-start gap-3 p-3 pb-2">
          <div class="min-w-0 flex-1">
            <h3 id="archive-search" class="truncate text-sm font-semibold text-slate-900">Search</h3>
            <p class="mt-0.5 text-xs text-slate-500">The search page · <code class="rounded bg-slate-100 px-1 text-[11px]">/search</code></p>
          </div>
          {{ fields.lang_switch() }}
        </header>
        <dl class="m-0 space-y-2.5 border-t border-slate-100 p-3">
          <div class="lc-row">
            <dt>Title area</dt>
            <dd class="m-0">{{ c.tiles('archive_search[title_layout]', archive_title_layouts, sp.title_layout, 'Title area', 'title', '') }}</dd>
          </div>
          <div class="lc-row">
            <dt><label for="archive-search-picture">Picture</label></dt>
            <dd class="m-0 flex flex-wrap items-center gap-x-3 gap-y-2">
              <input id="archive-search-picture" type="text" name="archive_search[title_image]" value="{{ sp.title_image }}" placeholder="/uploads/media/picture.jpg" aria-label="Picture of the title area" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-900 placeholder:text-slate-400 min-w-0 flex-1" data-image-field>
              {{ c.chip('archive_search[title_parallax]', 'Parallax', sp.title_parallax) }}
            </dd>
          </div>
          {{ c.text({label: 'Title', type: 'text', translatable: true, placeholder: 'Default: the theme’s word for it (Admin > Translations: search.title)', help: ''}, 'archive_search[title]', sp.title) }}
          {{ c.text({label: 'Subtitle', type: 'text', translatable: true, placeholder: 'Default: the theme’s line (Admin > Translations: search.subtitle)', help: ''}, 'archive_search[subtitle]', sp.subtitle) }}
        </dl>
      </article>
    </div>
  </section>
</div>
