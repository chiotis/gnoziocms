{#
  A password box for a saved secret: blank keeps what is saved, a box below removes it. Used by Settings and by the
  settings of Backups and Updates.

    {% import '@admin/partials/secret-input.twig' as local %}
    {{ local.secret_input('smtp_pass', settings_form.smtp_pass_set, input_class, '') }}
#}
{% macro secret_input(name, is_set, input_class, empty_placeholder, lost = false) %}
  <input type="password" id="{{ name }}" name="{{ name }}" value="" autocomplete="new-password" placeholder="{{ is_set ? 'Saved. Leave blank to keep it.' : (lost ? 'To be entered again' : empty_placeholder) }}" class="{{ input_class }}">
  {% if lost %}<span class="mt-1 block text-xs text-amber-700">Saved on another server: it cannot be opened here (the site's key is not in backups). Enter it again.</span>{% endif %}
  {% if is_set %}
    <span class="mt-1 flex items-center gap-1.5 text-xs text-slate-400">
      <input type="checkbox" name="clear_secret[]" value="{{ name }}" class="h-3.5 w-3.5 rounded border-slate-300">
      Remove the saved value
    </span>
  {% endif %}
{% endmacro %}
