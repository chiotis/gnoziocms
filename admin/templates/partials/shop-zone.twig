{# One shipping zone on Shop settings > Shipping: its name, countries, postcodes and methods. z is its index (or __Z__ in the template). #}
{% set input = 'block w-full rounded-md border border-slate-300 px-2.5 py-1.5 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-1 focus:ring-blue-500' %}
{% set label = 'block text-xs font-medium text-slate-600 mb-1' %}
<section class="rounded-lg border border-slate-200 bg-white" data-zone data-z="{{ z }}">
  <input type="hidden" name="zones[{{ z }}][id]" value="{{ zone.id }}">
  <div class="grid gap-3 border-b border-slate-200 px-4 py-3 sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end">
    <div><label class="{{ label }}">Zone</label><input name="zones[{{ z }}][name]" value="{{ zone.name }}" class="{{ input }}" maxlength="80" placeholder="Greece"></div>
    <div><label class="{{ label }}">Countries</label><input name="zones[{{ z }}][countries]" value="{{ zone.countries|join(', ') }}" class="{{ input }} font-mono uppercase" placeholder="GR, CY or *" spellcheck="false"></div>
    <div><label class="{{ label }}">Postcodes starting with (optional)</label><input name="zones[{{ z }}][postcodes]" value="{{ zone.postcodes|join(', ') }}" class="{{ input }} font-mono" placeholder="84, 85" spellcheck="false"></div>
    <button type="button" class="rounded-md px-2 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50" data-remove-zone>Remove the zone</button>
  </div>
  <div class="grid gap-2 px-4 py-3" data-methods>
    {% for method in zone.methods %}
      {% include '@admin/partials/shop-method.twig' with {m: loop.index0, method: method, table: tables[loop.index0]|default('')} %}
    {% endfor %}
  </div>
  <div class="px-4 pb-3"><button type="button" class="text-xs font-medium text-blue-700 hover:underline" data-add-method>Add a method</button></div>
</section>
