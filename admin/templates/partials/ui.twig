{#
  Shared admin UI macros. Import with: {% import '@admin/partials/ui.twig' as ui %}
#}

{# Server message shown in the bottom bar by admin.js. type: success | info | warning | error #}
{% macro flash(message, type) %}
  {% if message %}<template data-flash data-type="{{ type|default('success') }}">{{ message }}</template>{% endif %}
{% endmacro %}

{# Status pill. tone: green | amber | red | blue | violet | pink | slate #}
{% macro badge(label, tone) %}
  {% set tones = {
    'green': 'bg-emerald-50 text-emerald-700 ring-emerald-200',
    'amber': 'bg-amber-50 text-amber-700 ring-amber-200',
    'red': 'bg-red-50 text-red-700 ring-red-200',
    'blue': 'bg-blue-50 text-blue-700 ring-blue-200',
    'violet': 'bg-violet-50 text-violet-700 ring-violet-200',
    'pink': 'bg-pink-50 text-pink-700 ring-pink-200',
    'slate': 'bg-slate-100 text-slate-600 ring-slate-200'
  } %}
  <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset {{ tones[tone|default('slate')] ?? tones.slate }}">{{ label }}</span>
{% endmacro %}

{# Maps common status values to a badge tone so every screen colours them the same way. #}
{% macro status_badge(value) %}
  {% set map = {
    'published': 'green', 'active': 'green', 'success': 'green', 'sent': 'green', 'ok': 'green', 'info': 'blue',
    'draft': 'slate', 'inactive': 'slate', 'disabled': 'slate',
    'warning': 'amber', 'pending': 'amber', 'scheduled': 'blue',
    'failed': 'red', 'error': 'red', 'critical': 'red',
    'done': 'green', 'queued': 'amber', 'running': 'blue', 'cancelled': 'slate'
  } %}
  {{ _self.badge(value, map[value|lower] ?? 'slate') }}
{% endmacro %}

{# Filter toggle button for a hidden panel with the given id. Shows a dot while filters are applied. #}
{% macro filter_button(target, active) %}
  <button type="button" data-toggle="filter" data-target="{{ target }}" aria-controls="{{ target }}" class="relative inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 shadow-sm hover:bg-slate-50">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4"/></svg>
    Filters
    {% if active %}<span class="absolute -right-1 -top-1 h-2.5 w-2.5 rounded-full bg-blue-500 ring-2 ring-white" aria-label="Filters applied"></span>{% endif %}
  </button>
{% endmacro %}

{# A dropdown of checkboxes in a filter bar (form[data-filter-bar]): name[] for each ticked value. The bar sends its form
   when the dropdown closes with something changed. options: {value, label, depth?, count?}; selected: the ticked values. #}
{% macro multi_select(name, title, options, selected) %}
  {% set picked = options|filter(o => o.value in selected) %}
  <details class="relative" data-multiselect>
    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-medium shadow-sm [&::-webkit-details-marker]:hidden {{ picked is empty ? 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50' : 'border-blue-300 bg-blue-50 text-blue-700' }}">
      <span>{{ title }}{% if picked|length == 1 %}:{% endif %}</span>
      {% if picked|length == 1 %}<span class="-ml-0.5 max-w-[9rem] truncate font-normal">{{ (picked|first).label }}</span>
      {% elseif picked|length > 1 %}<span class="rounded-full bg-blue-600 px-1.5 text-[11px] font-semibold leading-4 text-white">{{ picked|length }}</span>{% endif %}
      <svg class="h-3.5 w-3.5 opacity-60" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/></svg>
    </summary>
    <div class="absolute left-0 z-30 mt-1 w-72 max-w-[calc(100vw-2rem)] rounded-lg border border-slate-200 bg-white shadow-lg" role="group" aria-label="{{ title }}">
      {% if options|length > 8 %}
        <div class="border-b border-slate-100 p-2">
          <input type="search" placeholder="Find {{ title|lower }}…" class="w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm" data-multiselect-find aria-label="Find {{ title|lower }}">
        </div>
      {% endif %}
      <div class="max-h-72 overflow-y-auto p-1">
        {% for option in options %}
          <label class="flex cursor-pointer items-center gap-2 rounded px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-50" style="padding-left: {{ 0.5 + (option.depth|default(0)) * 1 }}rem" data-multiselect-option="{{ option.label|lower }}">
            <input type="checkbox" name="{{ name }}[]" value="{{ option.value }}" class="h-4 w-4 rounded border-slate-300" {% if option.value in selected %}checked{% endif %}>
            <span class="min-w-0 flex-1 truncate">{{ option.label }}</span>
            {% if option.count is defined %}<span class="text-xs tabular-nums text-slate-400">{{ option.count }}</span>{% endif %}
          </label>
        {% endfor %}
      </div>
      <div class="flex items-center justify-between gap-2 border-t border-slate-100 px-2 py-1.5">
        <button type="button" class="rounded px-2 py-1 text-xs font-medium text-slate-500 hover:bg-slate-100 hover:text-slate-800" data-multiselect-clear>Clear</button>
        <button type="button" class="rounded-md bg-blue-600 px-2.5 py-1 text-xs font-medium text-white hover:bg-blue-700" data-multiselect-done>Show results</button>
      </div>
    </div>
  </details>
{% endmacro %}

{# Empty state block used inside table cards. #}
{% macro empty_state(title, text) %}
  <div class="flex flex-col items-center justify-center px-6 py-14 text-center">
    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-slate-100">
      <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20 13V7a2 2 0 00-2-2H6a2 2 0 00-2 2v6m16 0v4a2 2 0 01-2 2H6a2 2 0 01-2-2v-4m16 0h-4l-2 3h-4l-2-3H4"/></svg>
    </div>
    <h2 class="mt-3 text-sm font-semibold text-slate-900">{{ title }}</h2>
    {% if text %}<p class="mt-1 max-w-sm text-sm text-slate-400">{{ text }}</p>{% endif %}
  </div>
{% endmacro %}

{# Previous/next pagination that keeps the current query string. #}
{% macro pagination(page, total_pages, base_query) %}
  {% if total_pages > 1 %}
    {% set link = 'inline-flex items-center rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-slate-50' %}
    <nav class="flex items-center gap-1.5" aria-label="Pagination">
      {% if page > 1 %}<a class="{{ link }}" href="?{{ base_query|merge({'page': page - 1})|url_encode }}">Previous</a>{% endif %}
      <span class="px-1 text-xs text-slate-400">Page {{ page }} of {{ total_pages }}</span>
      {% if page < total_pages %}<a class="{{ link }}" href="?{{ base_query|merge({'page': page + 1})|url_encode }}">Next</a>{% endif %}
    </nav>
  {% endif %}
{% endmacro %}
