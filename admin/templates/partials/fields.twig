{#
  Form controls for FieldSchema definitions (theme settings and content type fields).
  field: a normalized definition from FieldSchema::normalize(); name: the input name; value: current value.
#}
{#
  Texts with a version for each language (a field with `translatable: true`, shown while the site has more than one language):
    lang_switch()                       the chips that choose which language the texts of the nearest [data-lang-scope] show
    i18n_inputs(field, name, value, class)   one input for each language, named name[default] (the site's own language) and name[en]…;
                                        the value is a plain text (the default one) or a map; admin-langs.js shows one at a time
#}
{% macro lang_switch() %}
  {% if admin_languages|length > 1 %}
    <span class="bk-pills is-light" data-lang-switch role="group" aria-label="Language of the texts">
      {% for code in admin_languages %}<button type="button" data-lang-pick="{{ code }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" title="{{ loop.first ? 'The site\'s own language' : 'Translation' }}">{{ code|upper }}</button>{% endfor %}
    </span>
  {% endif %}
{% endmacro %}

{% macro i18n_inputs(field, name, value, cls, id) %}
  {% set source = value is iterable ? (value.default ?? '') : value %}
  {% for code in admin_languages %}
    {% set key = loop.first ? 'default' : code %}
    {% set text = loop.first ? source : (value is iterable ? (value[code] ?? '') : '') %}
    {% set hint = loop.first ? field.placeholder : (source ?: field.placeholder) %}
    {% if field.type == 'textarea' %}
      <textarea{% if id %} id="{{ id }}{{ loop.first ? '' : '-' ~ code }}"{% endif %} name="{{ name }}[{{ key }}]" rows="2" placeholder="{{ hint }}" class="{{ cls }}" data-lang="{{ code }}" lang="{{ code }}"{% if not loop.first %} aria-label="{{ field.label }} ({{ code|upper }})" hidden{% endif %}>{{ text }}</textarea>
    {% else %}
      <input{% if id %} id="{{ id }}{{ loop.first ? '' : '-' ~ code }}"{% endif %} type="text" name="{{ name }}[{{ key }}]" value="{{ text }}" placeholder="{{ hint }}" class="{{ cls }}" data-lang="{{ code }}" lang="{{ code }}"{% if not loop.first %} aria-label="{{ field.label }} ({{ code|upper }})" hidden{% endif %}>
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro field(field, name, value, depth) %}
  {% import _self as m %}
  {% set control = 'w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-300' %}
  {% set span = field.span == 'full' ? ' col-span-full' : '' %}
  {% if field.type == 'repeater' %}
    {{ m.repeater(field, name, value, span, depth|default(1)) }}
  {% elseif field.type == 'toggle' %}
    <label class="flex items-start justify-between gap-4 rounded-md border border-slate-100 px-3 py-2.5{{ span }}">
      <span>
        <span class="block text-sm font-medium text-slate-800">{{ field.label }}</span>
        {% if field.help %}<span class="block text-xs text-slate-400">{{ field.help }}</span>{% endif %}
      </span>
      <input type="checkbox" name="{{ name }}" value="1" {% if value %}checked{% endif %} class="mt-0.5 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500">
    </label>
  {% elseif field.type == 'relation' %}
    <div class="block{{ span }}" role="group" aria-label="{{ field.label }}">
      <span class="mb-1 block text-sm font-medium text-slate-700">{{ field.label }}</span>
      {{ m.relation(field, name, value, control) }}
      {% if field.help %}<span class="mt-1 block text-xs text-slate-400">{{ field.help }}</span>{% endif %}
    </div>
  {% else %}
    <label class="block{{ span }}">
      <span class="mb-1 block text-sm font-medium text-slate-700">{{ field.label }}</span>
      {% if field.type == 'select' or field.type == 'icon' %}
        <select name="{{ name }}" class="{{ control }}"{% if field.type == 'icon' %} data-icon-picker{% endif %}>
          {% for option_value, option_label in field.options %}
            <option value="{{ option_value }}" {% if value ~ '' == option_value ~ '' %}selected{% endif %}>{{ option_label }}</option>
          {% endfor %}
        </select>
      {% elseif field.translatable|default(false) and admin_languages|length > 1 %}
        {{ m.i18n_inputs(field, name, value, control) }}
      {% elseif field.type == 'textarea' %}
        <textarea name="{{ name }}" rows="3" placeholder="{{ field.placeholder }}" class="{{ control }}">{{ value is iterable ? value|localized : value }}</textarea>
      {% elseif field.type == 'markdown' %}
        <textarea name="{{ name }}" rows="6" placeholder="{{ field.placeholder }}" class="{{ control }}">{{ value }}</textarea>
      {% elseif field.type == 'date' %}
        <input type="date" name="{{ name }}" value="{{ value }}" class="{{ control }}">
      {% elseif field.type == 'decimal' %}
        <input type="number" step="any" name="{{ name }}" value="{{ value }}"{% if field.min is not null %} min="{{ field.min }}"{% endif %}{% if field.max is not null %} max="{{ field.max }}"{% endif %} placeholder="{{ field.placeholder }}" class="{{ control }}">
      {% elseif field.type == 'number' %}
        <input type="number" name="{{ name }}" value="{{ value }}"{% if field.min is not null %} min="{{ field.min }}"{% endif %}{% if field.max is not null %} max="{{ field.max }}"{% endif %} placeholder="{{ field.placeholder }}" class="{{ control }}">
      {% elseif field.type == 'color' %}
        <span class="flex items-center gap-2">
          <span class="h-8 w-8 shrink-0 rounded-md border border-slate-200" style="background: {{ value ?: 'transparent' }};" aria-hidden="true"></span>
          <input type="text" name="{{ name }}" value="{{ value }}" placeholder="{{ field.placeholder }}" class="{{ control }}">
        </span>
      {% else %}
        <input type="{{ field.type == 'email' ? 'email' : 'text' }}" name="{{ name }}" value="{{ value is iterable ? value|localized : value }}" placeholder="{{ field.placeholder }}" class="{{ control }}"{% if field.type == 'image' %} data-image-field{% elseif field.type == 'video' %} data-image-field data-media-kind="video"{% elseif field.type == 'file' %} data-image-field data-media-kind="{{ field.kind|default('all') }}"{% elseif field.type == 'location' %} data-location-field inputmode="decimal" autocomplete="off"{% endif %}>
      {% endif %}
      {% if field.help %}<span class="mt-1 block text-xs text-slate-400">{{ field.help }}</span>{% endif %}
    </label>
  {% endif %}
{% endmacro %}

{#
  A relation (an entry, or several, pointed at by their id): chips of what is chosen and a search box that offers more (admin-relations.js).
  Each chip carries its own hidden input, so a form sent with no script still keeps what it held; the disabled input only keeps the field's
  name, which the repeater renames with the row, and the script copies it onto the chips it adds. Nothing is chosen = nothing is sent.
#}
{% macro relation(field, name, value, control) %}
  {% import _self as m %}
  {% set chosen = value is iterable ? value : (value ? [value] : []) %}
  <div class="rel" data-relation data-types="{{ field.types|join(',') }}" data-multiple="{{ field.multiple ? 1 : 0 }}" data-max="{{ field.max ?? 0 }}" data-url="/admin/relations">
    <input type="hidden" name="{{ name }}" value="" disabled data-rel-name>
    <ul class="rel-chips" data-rel-chips aria-label="Chosen">
      {% for id in chosen %}{{ m.relation_chip(field, name, id) }}{% endfor %}
    </ul>
    <div class="rel-box">
      <input type="text" class="rel-search {{ control }}" data-rel-search placeholder="{{ field.multiple ? 'Add an entry: search by title…' : 'Choose an entry: search by title…' }}" role="combobox" aria-expanded="false" aria-autocomplete="list" autocomplete="off"{% if field.max and chosen|length >= field.max %} disabled{% endif %}>
      <ul class="rel-results" data-rel-results role="listbox" hidden></ul>
    </div>
    {% if field.multiple and field.max %}<span class="rel-hint">Up to {{ field.max }}.</span>{% endif %}
  </div>
{% endmacro %}

{% macro relation_chip(field, name, id) %}
  {% set info = field.labels[id] ?? null %}
  <li class="rel-chip{{ info is null ? ' is-missing' : (info.hidden ? ' is-hidden' : '') }}" data-rel-chip>
    <input type="hidden" name="{{ name }}{{ field.multiple ? '[]' : '' }}" value="{{ id }}">
    <span class="rel-title">{{ info ? info.title : 'Missing entry' }}</span>
    {% if info is null %}<span class="rel-state">gone</span>{% elseif info.hidden %}<span class="rel-state">{{ info.status ?: 'hidden' }}</span>{% endif %}
    {% if info %}<a class="rel-btn" href="{{ info.edit_url }}" target="_blank" rel="noopener" aria-label="Open {{ info.title }} in a new tab">↗</a>{% endif %}
    {% if field.multiple %}<button type="button" class="rel-btn" data-rel-left aria-label="Move earlier">‹</button><button type="button" class="rel-btn" data-rel-right aria-label="Move later">›</button>{% endif %}
    <button type="button" class="rel-btn" data-rel-remove aria-label="Remove {{ info ? info.title : 'the missing entry' }}">✕</button>
  </li>
{% endmacro %}

{#
  A list of rows, each with the same fields (up to max rows). Rows are added, removed and moved in the browser
  (data-repeater in admin.js); a new row is cloned from the template, so it starts empty.
  A row of a top-level list may hold a list of its own (depth 2, see FieldSchema::MAX_DEPTH): the template of each level has its
  own placeholder for the row number (__INDEX__, then __INDEX2__), so adding a row to one list never renumbers the other, and
  data-repeater-name is the name the rows of that list start with, which admin.js keeps up to date when rows move.
#}
{% macro repeater(field, name, value, span, depth) %}
  {% import _self as m %}
  {% set depth = depth|default(1) %}
  {% set placeholder = depth > 1 ? '__INDEX' ~ depth ~ '__' : '__INDEX__' %}
  {% set rows = value is iterable ? value : [] %}
  {% set has_translatable = field.fields|filter(sub => sub.translatable|default(false))|length > 0 %}
  <fieldset class="rounded-md border border-slate-200 {{ depth > 1 ? 'col-span-full bg-white p-2' : 'p-3' }}{{ span }}" data-repeater data-repeater-name="{{ name }}" data-repeater-placeholder="{{ placeholder }}" data-repeater-min="{{ field.min ?? 0 }}" data-repeater-max="{{ field.max ?? 0 }}" data-repeater-item="{{ field.item_label }}"{% if has_translatable %} data-lang-scope{% endif %}>
    <legend class="px-1 text-sm font-medium text-slate-700">{{ field.label }}</legend>
    {% if has_translatable %}<div class="mb-2">{{ m.lang_switch() }}</div>{% endif %}
    {% if field.help %}<p class="mb-2 text-xs text-slate-400">{{ field.help }}</p>{% endif %}
    {# Sent first: with no rows it says "none"; rows after it replace it. #}
    <input type="hidden" name="{{ name }}" value="">
    <ol class="space-y-2" data-repeater-rows>
      {% for row in rows %}
        {{ m.repeater_row(field, name, loop.index0, row, depth) }}
      {% endfor %}
    </ol>
    <template data-repeater-template>{{ m.repeater_row(field, name, placeholder, {}, depth) }}</template>
    <button type="button" class="mt-2 inline-flex items-center rounded-md border border-slate-300 bg-white {{ depth > 1 ? 'px-2 py-1 text-xs' : 'px-3 py-1.5 text-sm' }} font-medium text-slate-700 hover:bg-slate-50" data-repeater-add>Add {{ field.item_label|lower }}</button>
  </fieldset>
{% endmacro %}

{% macro repeater_row(field, name, index, row, depth) %}
  {% import _self as m %}
  {% set depth = depth|default(1) %}
  <li class="rounded-md border border-slate-200 bg-slate-50 {{ depth > 1 ? 'p-2' : 'p-3' }}" data-repeater-row>
    <div class="mb-2 flex items-center justify-between gap-2" data-repeater-head>
      <span class="text-xs font-semibold uppercase tracking-wide text-slate-500" data-repeater-title>{{ field.item_label }}</span>
      <span class="inline-flex gap-1">
        <button type="button" class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-600 hover:bg-slate-100" data-repeater-up aria-label="Move {{ field.item_label|lower }} up">↑</button>
        <button type="button" class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-slate-600 hover:bg-slate-100" data-repeater-down aria-label="Move {{ field.item_label|lower }} down">↓</button>
        <button type="button" class="rounded-md border border-slate-300 bg-white px-2 py-1 text-xs text-red-600 hover:bg-red-50" data-repeater-remove aria-label="Remove {{ field.item_label|lower }}">Remove</button>
      </span>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {% for sub_key, sub in field.fields %}
        {{ m.field(sub, name ~ '[' ~ index ~ '][' ~ sub_key ~ ']', row[sub_key]|default(sub.type == 'toggle' ? false : (sub.type == 'repeater' or (sub.type == 'relation' and sub.multiple) ? [] : '')), depth + 1) }}
      {% endfor %}
    </div>
  </li>
{% endmacro %}
