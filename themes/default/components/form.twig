{#
  Frontend form. Every control has a label; help text and errors are tied to the control with
  aria-describedby, invalid controls carry aria-invalid, and the status message is announced.
  Each part is drawn by components/form-field.twig. A form with `step` parts is shown one step at a time by form-logic.js.
#}
{% set form_id = 'form-' ~ form.slug %}
{% set autocomplete_by_type = {'email': 'email', 'tel': 'tel', 'url': 'url'} %}
{% set autocomplete_by_name = {'name': 'name', 'full_name': 'name', 'first_name': 'given-name', 'last_name': 'family-name', 'company': 'organization', 'phone': 'tel', 'email': 'email', 'address': 'street-address', 'city': 'address-level2', 'zip': 'postal-code', 'postcode': 'postal-code', 'country': 'country-name'} %}
{% set has_file_field = form_fields|filter(f => f.type == 'file')|length > 0 %}
{# Showing a part only for some answers, and steps, need form-logic.js; a form without either loads nothing more. #}
{% set has_logic = form_fields|filter(f => f.type == 'step' or (f.condition is defined and f.condition))|length > 0 %}
{# How the form is drawn (Admin > Forms > Settings): as the theme draws it, compact, or stacked (one field to a row). #}
{% set form_style = form.meta.style|default('') in ['compact', 'stacked'] ? form.meta.style : '' %}
<div class="form-section">
  {# The styles and the script of the file picker are only loaded by a form that has one. #}
  {% if has_file_field %}
    <link rel="stylesheet" href="{{ theme_asset('css/form-upload.css') }}">
    <script src="{{ theme_asset('js/form-upload.js') }}" defer></script>
  {% endif %}
  {% if has_logic %}
    <script src="{{ theme_asset('js/form-logic.js') }}" defer></script>
  {% endif %}
  {% if form_success %}
    <p class="form-success" role="status">{{ form_message }}</p>
  {% endif %}
  {% if form_errors is defined and form_errors._form is defined %}
    <p class="form-error" role="alert">{{ form_errors._form }}</p>
  {% elseif form_errors is defined and form_errors is not empty %}
    <p class="form-error" role="alert">{{ t('form.fix_errors', 'Please check the highlighted fields.') }}</p>
  {% endif %}

  <form method="post" action="{{ url(form_action) }}" class="form-grid{% if form_style %} form-style-{{ form_style }}{% endif %}" id="{{ form_id }}" novalidate{% if has_logic %} data-form-logic data-msg-required="{{ t('form.error.required', 'This field is required.') }}"{% endif %}{% if has_file_field %} enctype="multipart/form-data"{% endif %}>
    <input type="hidden" name="form_slug" value="{{ form.slug }}">
    <input type="hidden" name="form_lang" value="{{ form.lang }}">
    {% if form_redirect is defined and form_redirect %}
      <input type="hidden" name="redirect_url" value="{{ form_redirect }}">
    {% endif %}
    {% if form_honeypot is defined and form_honeypot %}
      <div class="form-honeypot" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="{{ form_honeypot }}" tabindex="-1" autocomplete="off"></label>
      </div>
    {% endif %}

    {% set has_steps = form_fields|filter(f => f.type == 'step')|length > 0 %}
    {% if has_steps %}
      {# A form in several steps: each `step` part begins the next one. Without JavaScript every step is shown, one under the other. #}
      {%- set steps = [] -%}
      {%- set current = [] -%}
      {%- set current_step = null -%}
      {%- for field in form_fields -%}
        {%- if field.type == 'step' -%}
          {%- if current is not empty %}{% set steps = steps|merge([{step: current_step, fields: current}]) %}{% endif -%}
          {%- set current = [] -%}
          {%- set current_step = field -%}
        {%- else -%}
          {%- set current = current|merge([field]) -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if current is not empty %}{% set steps = steps|merge([{step: current_step, fields: current}]) %}{% endif %}
      <div class="form-progress" data-form-progress data-text="{{ t('form.step.progress', 'Step {n} of {count}') }}" hidden>
        <p class="form-progress-text" aria-live="polite" data-form-progress-text></p>
        <span class="form-progress-bar" aria-hidden="true"><span data-form-progress-bar></span></span>
      </div>
      {% for s in steps %}
        {% set step_id = form_id ~ '-step-' ~ loop.index %}
        <div class="form-step" role="group" data-form-step{% if s.step %} aria-labelledby="{{ step_id }}"{% if s.step.condition is defined and s.step.condition %} data-condition="{{ s.step.condition|json_encode }}"{% endif %}{% else %} aria-label="{{ t('form.step.progress', 'Step {n} of {count}')|replace({'{n}': loop.index, '{count}': steps|length}) }}"{% endif %}>
          {% if s.step %}<h3 class="form-step-title" id="{{ step_id }}" tabindex="-1">{{ s.step.label }}</h3>{% endif %}
          {% for field in s.fields %}
            {% include 'components/form-field.twig' %}
          {% endfor %}
          <div class="form-step-nav" data-form-step-nav hidden>
            <button type="button" class="form-step-back" data-form-back>{{ t('form.step.back', 'Back') }}</button>
            <button type="button" class="form-step-next" data-form-next>{{ t('form.step.next', 'Next') }}</button>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for field in form_fields %}
        {% include 'components/form-field.twig' %}
      {% endfor %}
    {% endif %}

    <button type="submit" data-form-submit>{{ form.meta.submit_label is defined and form.meta.submit_label ? form.meta.submit_label : t('form.submit', 'Submit') }}</button>
  </form>
</div>
