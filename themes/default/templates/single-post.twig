{% extends 'layouts/base.twig' %}
{% set title_header = true %}

{% block content %}
  {% set prefix = lang_prefix|default('') %}
  {# The line above the title: author, categories, date, tags and terms for the default layout, a short byline for the others. #}
  {% set hero_meta %}{% include 'components/entry-byline.twig' with {item: item, prefix: prefix, full: true} only %}{% endset %}
  {% set hero_meta_inline %}{% include 'components/entry-byline.twig' with {item: item, prefix: prefix} only %}{% endset %}
  {% include 'components/page-header.twig' with {hero_subtitle: item.meta.excerpt|default(''), hero_meta: hero_meta, hero_meta_inline: hero_meta_inline} %}
  {% include 'components/page-body.twig' %}
{% endblock %}
