{% extends 'layouts/base.twig' %}
{#
  The step before the bank's card page (Cardlink, docs/shop-plan.md, section 5). Where the amount allows installments the
  customer picks how many; then the signed form goes to the bank on its own (shop.js), with a button for when scripts are off.
#}
{% block content %}
  <section class="shop-page">
    <div class="site-wrap shop-narrow">
      <header class="shop-head">
        <h1>{{ t('shop.pay_card', 'Pay by card') }}</h1>
        <p class="shop-muted">{{ t('shop.order', 'Order') }} {{ order.number }} · {{ order.total }}</p>
      </header>
      {% if bank %}
        <form class="shop-box" method="post" action="{{ bank.action }}" data-shop-autosubmit>
          {% for name, value in bank.fields %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endfor %}
          <p>{{ t('shop.pay_to_bank', 'Taking you to the bank\'s secure page…') }}</p>
          <button class="btn btn-primary" type="submit">{{ t('shop.pay_continue', 'Continue to the bank') }}</button>
        </form>
      {% else %}
        <form class="shop-box" method="post" action="{{ choose_url }}">
          <fieldset class="shop-choices">
            <legend>{{ t('shop.pay_installments', 'Pay in installments?') }}</legend>
            <label class="shop-choice"><input type="radio" name="installments" value="0" checked> <span class="shop-choice-label">{{ t('shop.pay_at_once', 'All at once') }}</span></label>
            {% for n in installments %}
              <label class="shop-choice"><input type="radio" name="installments" value="{{ n }}"> <span class="shop-choice-label">{{ t('shop.pay_in_n', '{n} installments')|replace({'{n}': n}) }}</span></label>
            {% endfor %}
          </fieldset>
          <button class="btn btn-primary" type="submit">{{ t('shop.pay_continue', 'Continue to the bank') }} · {{ order.total }}</button>
        </form>
      {% endif %}
      <p class="shop-muted"><a href="{{ back_url }}">{{ t('shop.pay_back', 'Back to the order') }}</a></p>
    </div>
  </section>
{% endblock %}
