{#
  Filters of a list (the archive's `filters`, ArchiveBuilder): selects in a GET form, so a filtered page is a plain address. Context: archive.
#}
{% if block.variant == 'chips' %}
  {# Chips: each choice is a link (All, Earrings, Necklaces…); the other filters chosen are kept. No script, no form. #}
  {% set chosen = {} %}
  {% for f in block.filters %}{% if f.selected %}{% set chosen = chosen|merge({('filter[' ~ f.name ~ ']'): f.selected}) %}{% endif %}{% endfor %}
  <div class="site-wrap archive-body" id="filters">
    <nav class="filter-chips" aria-label="{{ t('filter.label', 'Filter') }}">
      {% for filter in block.filters %}
        {% set others = chosen|filter((v, k) => k != 'filter[' ~ filter.name ~ ']') %}
        <ul class="filter-chip-row" role="list" aria-label="{{ filter.kind == 'taxonomy' ? t('filter.' ~ filter.name, filter.label) : filter.label }}">
          <li><a class="filter-chip" href="?{{ others|url_encode }}#filters"{% if not filter.selected %} aria-current="true"{% endif %}>{{ t('filter.all', 'All') }}</a></li>
          {% for option in filter.options %}
            <li><a class="filter-chip" href="?{{ others|merge({('filter[' ~ filter.name ~ ']'): option.value})|url_encode }}#filters"{% if option.value == filter.selected %} aria-current="true"{% endif %}>{{ option.label }}{% if block.show_count %} <span class="filter-chip-count">{{ option.count }}</span>{% endif %}</a></li>
          {% endfor %}
        </ul>
      {% endfor %}
    </nav>
  </div>
{% else %}
<div class="site-wrap archive-body" id="filters">
  <form class="archive-filters" method="get" action="#filters" aria-label="{{ t('filter.label', 'Filter') }}">
    {% for filter in block.filters %}
      <label class="archive-filter">
        <span>{{ filter.kind == 'taxonomy' ? t('filter.' ~ filter.name, filter.label) : filter.label }}</span>
        <select name="filter[{{ filter.name }}]">
          <option value="">{{ t('filter.all', 'All') }}</option>
          {% for option in filter.options %}
            <option value="{{ option.value }}"{% if option.value == filter.selected %} selected{% endif %}>{{ option.label }}{% if block.show_count %} ({{ option.count }}){% endif %}</option>
          {% endfor %}
        </select>
      </label>
    {% endfor %}
    <button class="btn btn-primary" type="submit">{{ t('filter.apply', 'Apply') }}</button>
    {% if archive.filtered %}<a class="text-link" href="?">{{ t('filter.reset', 'Clear filters') }}</a>{% endif %}
  </form>
</div>
{% endif %}
