{% if block.variant == 'thread' %}
  {# A band of colours across the page: the colours chosen, or the deep tone of each term of a taxonomy. Without any, the accent. #}
  {% if block.thread_from == 'terms' %}
    {% set thread = taxonomy_terms(block.thread_taxonomy|default('collections'))|map(t => block.thread_tone|default('deep') == 'surface' ? t.tones.surface : t.tones.deep)|filter(c => c) %}
  {% else %}
    {% set thread = [block.colour_1, block.colour_2, block.colour_3, block.colour_4, block.colour_5, block.colour_6]|filter(c => c) %}
  {% endif %}
  <div class="divider-thread size-{{ block.thread_height|default('s') }}" aria-hidden="true">
    {% for c in thread|default([])|slice(0, 12) %}<span style="background: {{ c }}"></span>{% else %}<span></span>{% endfor %}
  </div>
{% elseif block.variant == 'space' %}
  <div class="divider-space size-{{ block.height }}" aria-hidden="true"></div>
{% else %}
  <div class="{{ block.line_width == 'page' ? 'container' : 'container-narrow' }}">
    {% if block.variant == 'label' and block.label %}
      <p class="divider-label style-{{ block.style }} width-{{ block.line_width }}"><span class="divider-rule" aria-hidden="true"></span><span class="divider-text">{{ block.label }}</span><span class="divider-rule" aria-hidden="true"></span></p>
    {% else %}
      <hr class="divider-line style-{{ block.style }} width-{{ block.line_width }}">
    {% endif %}
  </div>
{% endif %}
