{#
  Product summary (docs/shop-plan.md, section 9): collection, name, price, options and stock. Choosing options picks the
  variant and shows its price and stock (block.js). Add to cart sends the product and its options to /_shop/cart: the shop's
  script adds it without leaving the page and opens the cart; without the script, the form goes to the cart.
#}
{% set product = block.product %}
{# What the Meta Pixel is told of this page (Shop settings › Marketing): the product, by the id the product feed gives it. #}
{% if shop_pixel|default(null) and product.id|default('') and product.price is not null %}
  <script type="application/json" data-shop-track>{{ {event: 'ViewContent', data: {content_type: product.variants is not empty ? 'product_group' : 'product', content_ids: [product.id], content_name: product.title, value: product.price, currency: 'EUR'}}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
{% endif %}
{% set prefix = lang_prefix|default('') %}
{% set title_tag = block.show_title ? 'h1' : 'p' %}
<div class="container">
  <div class="product-summary" data-product-summary data-lang="{{ lang|default('') }}">
    {% if block.show_collection and product.collection %}
      <p class="product-summary-collection"><a href="{{ taxonomy_url('collections', product.collection.id, prefix) }}"><span class="shop-dot"{% if product.collection.tones.deep %} style="--dot: {{ product.collection.tones.deep }}"{% endif %} aria-hidden="true"></span>{{ product.collection.label }}</a></p>
    {% endif %}
    <{{ title_tag }} class="product-summary-title">{{ product.title }}</{{ title_tag }}>
    {% if product.price_text %}
      <p class="product-summary-price">
        {% if product.from %}<span class="product-card-from" data-from>{{ t('shop.from', 'from') }}</span> {% endif %}
        <span class="product-price" data-price>{{ product.price_text }}</span>{% if product.plan %} <span class="product-card-from">{{ t('shop.every_' ~ product.plan.interval ~ (product.plan.count > 1 ? 's' : ''), '')|replace({'{n}': product.plan.count}) }}</span>{% endif %}
        {% if product.was_text %}<s class="product-was"><span class="visually-hidden">{{ t('shop.was', 'was') }}</span> {{ product.was_text }}</s>{% endif %}
      </p>
    {% endif %}
    {% if product.short_description %}<p class="product-summary-text">{{ product.short_description|nl2br }}</p>{% endif %}

    {% set sellable = product.kind in ['physical', 'digital', 'subscription'] and product.price_text %}
    <form class="product-buy" method="post" action="{{ url(prefix ~ '_shop/cart') }}" data-shop-add>
    <input type="hidden" name="product" value="{{ product.id }}">
    {% if product.options is not empty %}
      <div class="product-options">
        {% for option in product.options %}
          <fieldset class="product-option" data-option="{{ option.index }}">
            <legend class="product-option-name">{{ option.label }}</legend>
            <div class="product-option-choices">
              {% for choice in option.choices %}
                <label class="product-chip">
                  <input type="radio" name="options[{{ option.index }}]" value="{{ choice.value }}"{% if loop.first %} checked{% endif %}>
                  <span>{{ choice.label }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </div>
    {% endif %}

    {% if product.plan %}<p class="product-stock">{{ product.plan.signup_cents > 0 ? t('shop.sub_signup', 'Charged again every period, by card; a sign-up fee of {fee} with the first payment. Cancel whenever you like.')|replace({'{fee}': (product.plan.signup_cents / 100)|number_format(2, lang == 'en' ? '.' : ',', '') ~ ' €'}) : t('shop.sub_note', 'Charged again every period, by card. Cancel whenever you like.') }}</p>{% elseif product.kind == 'digital' %}<p class="product-stock">{{ t('shop.digital_product', 'A download, yours as soon as it is paid') }}</p>{% else %}
    <p class="product-stock" data-stock role="status" aria-live="polite"
       data-in="{{ t('shop.in_stock', 'In stock') }}" data-out="{{ t('shop.sold_out', 'Sold out') }}" data-none="{{ t('shop.no_variant', 'Not available in this combination') }}">
      {{ product.available ? t('shop.in_stock', 'In stock') : t('shop.sold_out', 'Sold out') }}
    </p>{% endif %}
    {% if sellable %}
      <div class="product-buy-row">
        <label class="product-qty"><span class="visually-hidden">{{ t('shop.quantity', 'Quantity') }}</span><input type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric"></label>
        <button class="btn btn-primary product-add" type="submit" data-add-label="{{ t('shop.add_to_cart', 'Add to cart') }}" data-adding="{{ t('shop.adding', 'Adding…') }}"{% if not product.available %} disabled{% endif %}>{{ t('shop.add_to_cart', 'Add to cart') }}</button>
      </div>
      <p class="product-buy-message" data-shop-message role="status" aria-live="polite"></p>
    {% endif %}
    </form>
    {% if block.note|default('') %}<p class="product-summary-note">{{ block.note }}</p>{% endif %}
    {% if block.show_sku and product.sku %}<p class="product-summary-sku">SKU <span data-sku>{{ product.sku }}</span></p>{% endif %}
    {% if product.variants is not empty %}
      <script type="application/json" data-variants>{{ product.variants|map(v => {key: v.key, values: v.values, price: v.price_text, sku: v.sku, available: v.available})|json_encode|raw }}</script>
    {% endif %}
  </div>
</div>
