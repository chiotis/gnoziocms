{#
  Product summary (docs/shop-plan.md, section 9): collection, name, price, options and stock. Choosing options picks the
  variant and shows its price and stock (block.js). The Add to cart button comes with the cart.
#}
{% set product = block.product %}
{% set prefix = lang_prefix|default('') %}
{% set title_tag = block.show_title ? 'h1' : 'p' %}
<div class="container">
  <div class="product-summary" data-product-summary data-lang="{{ lang|default('') }}">
    {% if block.show_collection and product.collection %}
      <p class="product-summary-collection"><a href="{{ taxonomy_url('collections', product.collection.id, prefix) }}"><span class="shop-dot"{% if product.collection.tones.deep %} style="--dot: {{ product.collection.tones.deep }}"{% endif %} aria-hidden="true"></span>{{ product.collection.label }}</a></p>
    {% endif %}
    <{{ title_tag }} class="product-summary-title">{{ product.title }}</{{ title_tag }}>
    {% if product.price_text %}
      <p class="product-summary-price">
        {% if product.from %}<span class="product-card-from" data-from>{{ t('shop.from', 'from') }}</span> {% endif %}
        <span class="product-price" data-price>{{ product.price_text }}</span>
        {% if product.was_text %}<s class="product-was"><span class="visually-hidden">{{ t('shop.was', 'was') }}</span> {{ product.was_text }}</s>{% endif %}
      </p>
    {% endif %}
    {% if product.short_description %}<p class="product-summary-text">{{ product.short_description|nl2br }}</p>{% endif %}

    {% if product.options is not empty %}
      <div class="product-options">
        {% for option in product.options %}
          <fieldset class="product-option" data-option="{{ option.index }}">
            <legend class="product-option-name">{{ option.label }}</legend>
            <div class="product-option-choices">
              {% for choice in option.choices %}
                <label class="product-chip">
                  <input type="radio" name="{{ block_uid }}-option-{{ option.index }}" value="{{ choice.value }}"{% if loop.first %} checked{% endif %}>
                  <span>{{ choice.label }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </div>
    {% endif %}

    <p class="product-stock" data-stock role="status" aria-live="polite"
       data-in="{{ t('shop.in_stock', 'In stock') }}" data-out="{{ t('shop.sold_out', 'Sold out') }}" data-none="{{ t('shop.no_variant', 'Not available in this combination') }}">
      {{ product.available ? t('shop.in_stock', 'In stock') : t('shop.sold_out', 'Sold out') }}
    </p>
    {% if block.note|default('') %}<p class="product-summary-note">{{ block.note }}</p>{% endif %}
    {% if block.show_sku and product.sku %}<p class="product-summary-sku">SKU <span data-sku>{{ product.sku }}</span></p>{% endif %}
    {% if product.variants is not empty %}
      <script type="application/json" data-variants>{{ product.variants|map(v => {key: v.key, values: v.values, price: v.price_text, sku: v.sku, available: v.available})|json_encode|raw }}</script>
    {% endif %}
  </div>
</div>
