{# Product gallery: the product's pictures (its gallery, or its main image), and its picture on hover over the first. Data from ShopCatalogue::details(). #}
{% set product = block.product %}
{% set hover = block.hover_image and product.hover_image %}
<div class="container">
  <div class="product-gallery product-gallery-{{ block.ratio|default('portrait') }}" data-product-gallery>
    {% if block.variant == 'thumbs' %}
      <div class="product-gallery-main{% if hover %} product-gallery-frame has-hover{% endif %}">
        {{ image(product.images[0], {alt: product.title, sizes: '(min-width: 900px) 55vw, 92vw', max_width: 1800, priority: true, class: 'product-gallery-current'}) }}
        {% if hover %}{{ image(product.hover_image, {alt: '', sizes: '(min-width: 900px) 55vw, 92vw', max_width: 1800, class: 'product-gallery-hover', loading: 'lazy'}) }}{% endif %}
      </div>
      {% if product.images|length > 1 %}
        <ul class="product-gallery-thumbs" role="list">
          {% for src in product.images %}
            <li><button type="button" class="product-gallery-thumb" data-src="{{ src }}"{% if loop.first %} aria-current="true"{% endif %} aria-label="{{ t('shop.picture', 'Picture') }} {{ loop.index }}">
              {{ image(src, {alt: '', sizes: '96px', max_width: 320}) }}
            </button></li>
          {% endfor %}
        </ul>
      {% endif %}
    {% else %}
      <ul class="product-gallery-stack" role="list">
        {% for src in product.images %}
          <li{% if hover and loop.first %} class="product-gallery-frame has-hover"{% endif %}>
            {{ image(src, {alt: loop.first ? product.title : '', sizes: '(min-width: 900px) 55vw, 92vw', max_width: 1800, priority: loop.first}) }}
            {% if hover and loop.first %}{{ image(product.hover_image, {alt: '', sizes: '(min-width: 900px) 55vw, 92vw', max_width: 1800, class: 'product-gallery-hover', loading: 'lazy'}) }}{% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>
